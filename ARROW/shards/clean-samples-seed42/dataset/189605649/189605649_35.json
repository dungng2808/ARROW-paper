ay.hasNative()) {\n                return CreativeFormat.Native;\n            }\n        } else if (ad.hasVideo()) {\n            return CreativeFormat.Video;\n        }\n        return null;\n    }", "signature": "CreativeFormat identifyCreativeFormat(@NonNull Ad ad)", "full_signature": "@Nullable @VisibleForTesting static CreativeFormat identifyCreativeFormat(@NonNull Ad ad)", "class_method_signature": "AuctionResultImpl.identifyCreativeFormat(@NonNull Ad ad)", "testcase": false, "constructor": false, "invocations": ["hasDisplay", "getDisplay", "hasBanner", "isEmpty", "getAdm", "hasNative", "hasVideo"]}, "repository": {"repo_id": 189605649, "url": "https://github.com/bidmachine/BidMachine-Android-SDK", "stars": 12, "created": "5/31/2019 2:16:28 PM +00:00", "updates": "2020-01-21T10:10:08+00:00", "fork": "False", "license": "licensed"}}