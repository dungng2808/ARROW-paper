blic static final int FULL_TREE = 0;", "modifier": "public static final", "type": "int", "declarator": "FULL_TREE = 0", "var_name": "FULL_TREE"}, {"original_string": "public static final int TWO_LEVEL = 1;", "modifier": "public static final", "type": "int", "declarator": "TWO_LEVEL = 1", "var_name": "TWO_LEVEL"}, {"original_string": "public static final int FLAT = 2;", "modifier": "public static final", "type": "int", "declarator": "FLAT = 2", "var_name": "FLAT"}], "methods": [{"identifier": "ForumStructure", "parameters": "(List<Forum> forumTree)", "modifiers": "private", "return": "", "signature": " ForumStructure(List<Forum> forumTree)", "full_signature": "private  ForumStructure(List<Forum> forumTree)", "class_method_signature": "ForumStructure.ForumStructure(List<Forum> forumTree)", "testcase": false, "constructor": true}, {"identifier": "buildFromOrderedList", "parameters": "(List<Forum> orderedForums, @Nullable Integer topLevelParentId)", "modifiers": "@NonNull static", "return": "ForumStructure", "signature": "ForumStructure buildFromOrderedList(List<Forum> orderedForums, @Nullable Integer topLevelParentId)", "full_signature": "@NonNull static ForumStructure buildFromOrderedList(List<Forum> orderedForums, @Nullable Integer topLevelParentId)", "class_method_signature": "ForumStructure.buildFromOrderedList(List<Forum> orderedForums, @Nullable Integer topLevelParentId)", "testcase": false, "constructor": false}, {"identifier": "buildFromTree", "parameters": "(List<Forum> forumTree, int topLevelId)", "modifiers": "@NonNull static", "return": "ForumStructure", "signature": "ForumStructure buildFromTree(List<Forum> forumTree, int topLevelId)", "full_signature": "@NonNull static ForumStructure buildFromTree(List<Forum> forumTree, int topLevelId)", "class_method_signature": "ForumStructure.buildFromTree(List<Forum> forumTree, int topLevelId)", "testcase": false, "constructor": false}, {"identifier": "copyTreeWithParentId", "parameters": "(List<Forum> sourceTree, List<Forum> destinationTree, int parentId)", "modifiers": "private static", "return": "void", "signature": "void copyTreeWithParentId(List<Forum> sourceTree, List<Forum> destinationTree, int parentId)", "full_signature": "private static void copyTreeWithParentId(List<Forum> sourceTree, List<Forum> destinationTree, int parentId)", "class_method_signature": "ForumStructure.copyTreeWithParentId(List<Forum> sourceTree, List<Forum> destinationTree, int parentId)", "testcase": false, "constructor": false}, {"identifier": "getNumberOfForums", "parameters": "()", "modifiers": "public", "return": "int", "signature": "int getNumberOfForums()", "full_signature": "public int getNumberOfForums()", "class_method_signature": "ForumStructure.getNumberOfForums()", "testcase": false, "constructor": false}, {"identifier": "countForums", "parameters": "(List<Forum> forums, int total)", "modifiers": "private", "return": "int", "signature": "int countForums(List<Forum> forums, int total)", "full_signature": "private int countForums(List<Forum> forums, int total)", "class_method_signature": "ForumStructure.countForums(List<Forum> forums, int total)", "testcase": false, "constructor": false}, {"identifier": "getAsList", "parameters": "()", "modifiers": "@NonNull public", "return": "ListBuilder", "signature": "ListBuilder getAsList()", "full_signature": "@NonNull public ListBuilder getAsList()", "class_method_signature": "ForumStructure.getAsList()", "testcase": false, "constructor": false}, {"identifier": "copyForumTree", "parameters": "(List<Forum> source, List<Forum> collection)", "modifiers": "private static", "return": "void", "signature": "void copyForumTree(List<Forum> source, List<Forum> collection)", "full_signature": "private static void copyForumTree(List<Forum> source, List<Forum> collection)", "class_method_signature": "ForumStructure.copyForumTree(List<Forum> source, List<Forum> collection)", "testcase": false, "constructor": false}, {"identifier": "collectSubforums", "parameters": "(List<Forum> source, List<Forum> collection)", "modifiers": "private static", "return": "void", "signature": "void collectSubforums(List<Forum> source, List<Forum> collection)", "full_signature": "private static void collectSubforums(List<Forum> source, List<Forum> collection)", "class_method_signature": "ForumStructure.collectSubforums(List<Forum> source, List<Forum> collection)", "testcase": false, "constructor": false}], "file": "Awful.apk/src/main/java/com/ferg/awfulapp/forums/ForumStructure.java"}, "focal_method": {"identifier": "buildFromOrderedList", "parameters": "(List<Forum> orderedForums, @Nullable Integer topLevelParentId)", "modifiers": "@NonNull static", "return": "ForumStructure", "body": "@NonNull\n    static ForumStructure buildFromOrderedList(List<Forum> orderedForums, @Nullable Integer topLevelParentId) {\n        List<Forum> forumTree = new ArrayList<>();\n\n        // linked hashmap so we maintain the list's ordering\n        Map<Integer, Forum> forumsById = new LinkedHashMap<>();\n        for (Forum forum : orderedForums) {\n            Forum forumCopy = new Forum(forum);\n            forumsById.put(forumCopy.id, forumCopy);\n        }\n\n        /*\n            keep list of all forums with parentID = toplevelID, OR no parent in forum map\n         */\n\n        Forum parentForum;\n        for (Forum forum : forumsById.values()) {\n            parentForum = forumsById.get(forum.parentId);\n\n            // check if this forum is a top-level category 'forum' like Main or Community\n            if (topLevelParentId == null && parentForum == null || topLevelParentId != null && forum.parentId == topLevelParentId) {\n                forumTree.add(forum);\n            }\n            // otherwise add the forum to its parent's subforum list\n            else {\n                if (parentForum != null) {\n                    parentForum.subforums.add(forum);\n                } else {\n                    Log.w(TAG, \"Unable to find parent forum with ID: \" + forum.parentId);\n                }\n            }\n        }\n\n        return new ForumStructure(forumTree);\n    }", "signature": "ForumStructure buildFromOrderedList(List<Forum> orderedForums, @Nullable Integer topLevelParentId)", "full_signature": "@NonNull static ForumStructure buildFromOrderedList(List<Forum> orderedForums, @Nullable Integer topLevelParentId)", "class_method_signature": "ForumStructure.buildFromOrderedList(List<Forum> orderedForums, @Nullable Integer topLevelParentId)", "testcase": false, "constructor": false, "invocations": ["put", "values", "get", "add", "add", "w"]}, "repository": {"repo_id": 1387559, "url": "https://github.com/Awful/Awful.apk", "language": "Java", "is_fork": false, "fork_count": 64, "stargazer_count": 100, "size": 26296, "license": "licensed"}}