public", "return": "List<Value>", "body": "@Override\n    public List<Value> getValues(String field) {\n        try {\n            XPathExpression expr = xpath_map.get(field);\n            if (expr == null) {\n                return null;\n            }\n            NodeList lst = (NodeList)expr.evaluate(doc, XPathConstants.NODESET);\n            ArrayList<Value> ret = new ArrayList<Value>();\n            for (int i = 0; i < lst.getLength(); i++) {\n                String str = lst.item(i).getTextContent().trim();\n                //Ignore empty lines\n                if (!\"\".equals(str)) {\n                    ret.add(new StringValue(str));\n                }\n            }\n            return ret;\n        } catch(XPathExpressionException e) {\n            logger.info(e.getStackTrace());\n        }\n\n        return null;\n    }", "signature": "List<Value> getValues(String field)", "full_signature": "@Override public List<Value> getValues(String field)", "class_method_signature": "XPathRecord.getValues(String field)", "testcase": false, "constructor": false, "invocations": ["get", "evaluate", "getLength", "trim", "getTextContent", "item", "equals", "add", "info", "getStackTrace"]}, "repository": {"repo_id": 13292939, "url": "https://github.com/EKT/Biblio-Transformation-Engine", "language": "Java", "is_fork": false, "fork_count": 3, "stargazer_count": 15, "size": 977, "license": "licensed"}}