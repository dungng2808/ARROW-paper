ifiers": "private", "return": "void", "signature": "void putAPath(HashMap<String, ArrayList<String>> paths, String fileName,\n      String nodePath)", "full_signature": "private void putAPath(HashMap<String, ArrayList<String>> paths, String fileName,\n      String nodePath)", "class_method_signature": "MTree.putAPath(HashMap<String, ArrayList<String>> paths, String fileName,\n      String nodePath)", "testcase": false, "constructor": false}, {"identifier": "toString", "parameters": "()", "modifiers": "public", "return": "String", "signature": "String toString()", "full_signature": "public String toString()", "class_method_signature": "MTree.toString()", "testcase": false, "constructor": false}, {"identifier": "mnodeToString", "parameters": "(MNode node, int tab)", "modifiers": "private", "return": "String", "signature": "String mnodeToString(MNode node, int tab)", "full_signature": "private String mnodeToString(MNode node, int tab)", "class_method_signature": "MTree.mnodeToString(MNode node, int tab)", "testcase": false, "constructor": false}, {"identifier": "getTabs", "parameters": "(int count)", "modifiers": "private", "return": "String", "signature": "String getTabs(int count)", "full_signature": "private String getTabs(int count)", "class_method_signature": "MTree.getTabs(int count)", "testcase": false, "constructor": false}, {"identifier": "getRoot", "parameters": "()", "modifiers": "public", "return": "MNode", "signature": "MNode getRoot()", "full_signature": "public MNode getRoot()", "class_method_signature": "MTree.getRoot()", "testcase": false, "constructor": false}], "file": "iotdb/src/main/java/org/apache/iotdb/db/metadata/MTree.java"}, "focal_method": {"identifier": "addTimeseriesPath", "parameters": "(String timeseriesPath, String dataType, String encoding,\n      String[] args)", "modifiers": "public", "return": "void", "body": "public void addTimeseriesPath(String timeseriesPath, String dataType, String encoding,\n      String[] args)\n      throws PathErrorException {\n    String[] nodeNames = timeseriesPath.trim().split(separator);\n    if (nodeNames.length <= 1 || !nodeNames[0].equals(root.getName())) {\n      throw new PathErrorException(String.format(\"Timeseries %s is not right.\", timeseriesPath));\n    }\n    int i = 1;\n    MNode cur = root;\n    String levelPath = null;\n    while (i < nodeNames.length) {\n      String nodeName = nodeNames[i];\n      if (i == nodeNames.length - 1) {\n        cur.setDataFileName(levelPath);\n        break;\n      }\n      if (cur.isStorageLevel()) {\n        levelPath = cur.getDataFileName();\n      }\n      if (!cur.hasChild(nodeName)) {\n        if (cur.isLeaf()) {\n          throw new PathErrorException(\n              String.format(\"The Node [%s] is left node, the timeseries %s can't be created\",\n                  cur.getName(), timeseriesPath));\n        }\n        cur.addChild(nodeName, new MNode(nodeName, cur, false));\n      }\n      cur.setDataFileName(levelPath);\n      cur = cur.getChild(nodeName);\n      if (levelPath == null) {\n        levelPath = cur.getDataFileName();\n      }\n      i++;\n    }\n    TSDataType dt = TSDataType.valueOf(dataType);\n    TSEncoding ed = TSEncoding.valueOf(encoding);\n    MNode leaf = new MNode(nodeNames[nodeNames.length - 1], cur, dt, ed);\n    if (args.length > 0) {\n      for (int k = 0; k < args.length; k++) {\n        String[] arg = args[k].split(\"=\");\n        leaf.getSchema().putKeyValueToArgs(arg[0], arg[1]);\n      }\n    }\n    levelPath = cur.getDataFileName();\n    leaf.setDataFileName(levelPath);\n    if (cur.isLeaf()) {\n      throw new PathErrorException(\n          String.format(\"The Node [%s] is left node, the timeseries %s can't be created\",\n              cur.getName(), timeseriesPath));\n    }\n    cur.addChild(nodeNames[nodeNames.length - 1], leaf);\n  }", "signature": "void addTimeseriesPath(String timeseriesPath, String dataType, String encoding,\n      String[] args)", "full_signature": "public void addTimeseriesPath(String timeseriesPath, String dataType, String encoding,\n      String[] args)", "class_method_signature": "MTree.addTimeseriesPath(String timeseriesPath, String dataType, String encoding,\n      String[] args)", "testcase": false, "constructor": false, "invocations": ["split", "trim", "equals", "getName", "format", "setDataFileName", "isStorageLevel", "getDataFileName", "hasChild", "isLeaf", "format", "getName", "addChild", "setDataFileName", "getChild", "getDataFileName", "valueOf", "valueOf", "split", "putKeyValueToArgs", "getSchema", "getDataFileName", "setDataFileName", "isLeaf", "format", "getName", "addChild"]}, "repository": {"repo_id": 101970978, "url": "https://github.com/thulab/iotdb", "language": "Java", "is_fork": false, "fork_count": 0, "stargazer_count": 17, "size": 14366, "license": "licensed"}}