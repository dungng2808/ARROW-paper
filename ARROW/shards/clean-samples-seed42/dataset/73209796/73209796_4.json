{"test_class": {"identifier": "EmployeeMvvmViewModelTest", "superclass": "", "interfaces": "", "fields": [{"original_string": "@Mock\n    private EmployeeIDataModel mDataModel;", "modifier": "@Mock\n    private", "type": "EmployeeIDataModel", "declarator": "mDataModel", "var_name": "mDataModel"}, {"original_string": "private EmployeeMvvmViewModel mMainViewModel;", "modifier": "private", "type": "EmployeeMvvmViewModel", "declarator": "mMainViewModel", "var_name": "mMainViewModel"}], "file": "app/src/test/java/com/eusecom/attendance/EmployeeMvvmViewModelTest.java"}, "test_case": {"identifier": "testGetSupportedLanguages_emitsCorrectLanguages", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void testGetSupportedLanguages_emitsCorrectLanguages() {\n        Language de = new Language(\"German\", LanguageCode.DE);\n        Language en = new Language(\"English\", LanguageCode.EN);\n        List<Language> languages = Arrays.asList(de, en);\n\n        Observable<List<Language>> mockObservable = Observable.just(languages);\n        //Observable<Language> mockObservable = Observable.from(languages);\n\n        doReturn(mockObservable).when(mDataModel).getObservableSupportedLanguages();\n\n        Language hr = new Language(\"Slovakian\", LanguageCode.HR);\n        List<Language> expectedLanguages = Arrays.asList(de, en, hr);\n\n        //mMainViewModel = new MainViewModel(mDataModel, new ImmediateSchedulerProvider());\n        TestSubscriber<List<Language>> testSubscriber = new TestSubscriber<>();\n\n        mMainViewModel.getObservableSupportedLanguages().subscribe(testSubscriber);\n\n        testSubscriber.assertNoErrors();\n        testSubscriber.assertUnsubscribed();\n        testSubscriber.assertTerminalEvent();\n        String threadname = testSubscriber.getLastSeenThread().getName();\n        System.out.println(\"threadname \" + threadname);\n\n        //testSubscriber.getOnNextEvents( give List<T>\n        List<List<Language>> listlistresult = testSubscriber.getOnNextEvents();\n        System.out.println(\"listlistresult \" + listlistresult.get(0).toString());\n\n        List<Language> listresult = listlistresult.get(0);\n        System.out.println(\"listresult0 \" + listresult.get(0).getName());\n        System.out.println(\"listresult1 \" + listresult.get(1).getName());\n\n        //testSubscriber.assertReceivedOnNext(expectedLanguages); do not works result of assertReceivedOnNext is List<List<Language>>\n\n        assertEquals(expectedLanguages.get(0).getName(), listresult.get(0).getName());\n\n        //hamcrest matchers\n        //http://www.vogella.com/tutorials/Hamcrest/article.html\n        assertThat(languages, hasSize(2));\n    }", "signature": "void testGetSupportedLanguages_emitsCorrectLanguages()", "full_signature": "@Test public void testGetSupportedLanguages_emitsCorrectLanguages()", "class_method_signature": "EmployeeMvvmViewModelTest.testGetSupportedLanguages_emitsCorrectLanguages()", "testcase": true, "constructor": false, "invocations": ["asList", "just", "getObservableSupportedLanguages", "when", "doReturn", "asList", "subscribe", "getObservableSupportedLanguages", "assertNoErrors", "assertUnsubscribed", "assertTerminalEvent", "getName", "getLastSeenThread", "println", "getOnNextEvents", "println", "toString", "get", "get", "println", "getName", "get", "println", "getName", "get", "assertEquals", "getName", "get", "getName", "get", "assertThat", "hasSize"]}, "focal_class": {"identifier": "EmployeeMvvmViewModel", "superclass": "", "interfaces": "", "fields": [{"original_string": "@NonNull\n    private final EmployeeIDataModel mDataModel;", "modifier": "@NonNull\n    private final", "type": "EmployeeIDataModel", "declarator": "mDataModel", "var_name": "mDataModel"}, {"original_string": "@NonNull\n    private final ISchedulerProvider mSchedulerProvider;", "modifier": "@NonNull\n    private final", "type": "ISchedulerProvider", "declarator": "mSchedulerProvider", "var