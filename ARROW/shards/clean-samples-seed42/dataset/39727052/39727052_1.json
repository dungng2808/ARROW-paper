eeCoreAnnotations.TreeAnnotation.class);\n\n            SemanticGraph dependencies = sentence.get(SemanticGraphCoreAnnotations.CollapsedCCProcessedDependenciesAnnotation.class);\n        }\n\n        Map<Integer, CorefChain> graph = document.get(CorefCoreAnnotations.CorefChainAnnotation.class);\n\n        return sentenceList;\n    }", "signature": "ListMatrix<ListMatrix<MapMatrix<String, Object>>> tag(String text)", "full_signature": "public ListMatrix<ListMatrix<MapMatrix<String, Object>>> tag(String text)", "class_method_signature": "StanfordTagger.tag(String text)", "testcase": false, "constructor": false, "invocations": ["annotate", "get", "add", "get", "add", "get", "put", "get", "put", "get", "put", "get", "get", "get"]}, "repository": {"repo_id": 39727052, "url": "https://github.com/jdmp/java-data-mining-package", "language": "Java", "is_fork": false, "fork_count": 22, "stargazer_count": 42, "size": 4589, "license": "licensed"}}