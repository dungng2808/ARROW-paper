 {\n        final int missingValue = this.missingValue;\n        int max = size == 0 ? missingValue : Integer.MIN_VALUE;\n        @DoNotSub final int length = entries.length;\n\n        for (@DoNotSub int valueIndex = 1; valueIndex < length; valueIndex += 2)\n        {\n            final int value = entries[valueIndex];\n            if (value != missingValue)\n            {\n                max = Math.max(max, value);\n            }\n        }\n\n        return max;\n    }", "signature": "int maxValue()", "full_signature": "public int maxValue()", "class_method_signature": "Int2IntHashMap.maxValue()", "testcase": false, "constructor": false, "invocations": ["max"]}, "repository": {"repo_id": 26136655, "url": "https://github.com/real-logic/agrona", "stars": 1583, "created": "11/3/2014 8:14:21 PM +00:00", "updates": "2020-01-27T18:12:58+00:00", "fork": "False", "license": "licensed"}}