dconat.data.app.model.Speaker> speakersMap) {\n        return stream(from).map(session -> {\n            LocalDateTime fromTime = localDateTimeAdapter.fromText(session.startAt);\n            return new com.nilhcem.droidconat.data.app.model.Session(session.id, Room.getFromId(session.roomId).label,\n                    appMapper.toSpeakersList(deserialize(session.speakersIds), speakersMap),\n                    session.title, session.description, fromTime, fromTime.plusMinutes(session.duration));\n        }).collect(Collectors.toList());\n    }", "signature": "List<com.nilhcem.droidconat.data.app.model.Session> toAppSessions(@NonNull List<Session> from, @NonNull Map<Integer, com.nilhcem.droidconat.data.app.model.Speaker> speakersMap)", "full_signature": "public List<com.nilhcem.droidconat.data.app.model.Session> toAppSessions(@NonNull List<Session> from, @NonNull Map<Integer, com.nilhcem.droidconat.data.app.model.Speaker> speakersMap)", "class_method_signature": "DbMapper.toAppSessions(@NonNull List<Session> from, @NonNull Map<Integer, com.nilhcem.droidconat.data.app.model.Speaker> speakersMap)", "testcase": false, "constructor": false, "invocations": ["collect", "map", "stream", "fromText", "getFromId", "toSpeakersList", "deserialize", "plusMinutes", "toList"]}, "repository": {"repo_id": 62054952, "url": "https://github.com/Nilhcem/droidconat-2016", "language": "Java", "is_fork": false, "fork_count": 13, "stargazer_count": 16, "size": 1841, "license": "licensed"}}