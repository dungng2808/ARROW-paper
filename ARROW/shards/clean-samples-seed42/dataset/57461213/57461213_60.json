\"[\" + local.getName() + \"] has stopped moving!\");\n\t\t}\n\n\t\tif (config.interactionIdle() && checkInteractionIdle(waitDuration, local))\n\t\t{\n\t\t\tif (lastInteractWasCombat)\n\t\t\t{\n\t\t\t\tnotifier.notify(\"[\" + local.getName() + \"] is now out of combat!\");\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tnotifier.notify(\"[\" + local.getName() + \"] is now idle!\");\n\t\t\t}\n\t\t}\n\n\t\tif (checkLowHitpoints())\n\t\t{\n\t\t\tnotifier.notify(\"[\" + local.getName() + \"] has low hitpoints!\");\n\t\t}\n\n\t\tif (checkLowPrayer())\n\t\t{\n\t\t\tnotifier.notify(\"[\" + local.getName() + \"] has low prayer!\");\n\t\t}\n\n\t\tif (checkLowOxygen())\n\t\t{\n\t\t\tnotifier.notify(\"[\" + local.getName() + \"] has low oxygen!\");\n\t\t}\n\n\t\tif (checkFullSpecEnergy())\n\t\t{\n\t\t\tnotifier.notify(\"[\" + local.getName() + \"] has restored spec energy!\");\n\t\t}\n\t}", "signature": "void onGameTick(GameTick event)", "full_signature": "@Subscribe public void onGameTick(GameTick event)", "class_method_signature": "IdleNotifierPlugin.onGameTick(GameTick event)", "testcase": false, "constructor": false, "invocations": ["getLocalPlayer", "ofMillis", "getIdleNotificationDelay", "max", "getGameState", "currentTimeMillis", "getMouseLastPressedMillis", "getKeyboardIdleTicks", "resetTimers", "logoutIdle", "checkIdleLogout", "notify", "getName", "check6hrLogout", "notify", "getName", "animationIdle", "checkAnimationIdle", "notify", "getName", "movementIdle", "checkMovementIdle", "notify", "getName", "interactionIdle", "checkInteractionIdle", "notify", "getName", "notify", "getName", "checkLowHitpoints", "notify", "getName", "checkLowPrayer", "notify", "getName", "checkLowOxygen", "notify", "getName", "checkFullSpecEnergy", "notify", "getName"]}, "repository": {"repo_id": 57461213, "url": "https://github.com/runelite/runelite", "stars": 2635, "created": "4/30/2016 8:48:02 PM +00:00", "updates": "2020-01-27T19:59:37+00:00", "fork": "False", "license": "licensed"}}