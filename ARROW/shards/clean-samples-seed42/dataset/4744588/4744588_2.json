aunchParameters.getNumInstances()", "testcase": false, "constructor": false}, {"identifier": "getLocalResources", "parameters": "()", "modifiers": "@Override public", "return": "Map<String, LocalResource>", "signature": "Map<String, LocalResource> getLocalResources()", "full_signature": "@Override public Map<String, LocalResource> getLocalResources()", "class_method_signature": "LuaContainerLaunchParameters.getLocalResources()", "testcase": false, "constructor": false}, {"identifier": "constructExtraResource", "parameters": "(String key)", "modifiers": "private", "return": "LocalResource", "signature": "LocalResource constructExtraResource(String key)", "full_signature": "private LocalResource constructExtraResource(String key)", "class_method_signature": "LuaContainerLaunchParameters.constructExtraResource(String key)", "testcase": false, "constructor": false}, {"identifier": "constructResource", "parameters": "(LuaPair lp)", "modifiers": "private", "return": "NamedLocalResource", "signature": "NamedLocalResource constructResource(LuaPair lp)", "full_signature": "private NamedLocalResource constructResource(LuaPair lp)", "class_method_signature": "LuaContainerLaunchParameters.constructResource(LuaPair lp)", "testcase": false, "constructor": false}, {"identifier": "configureLocalResourceForPath", "parameters": "(LocalResource rsrc, Path path)", "modifiers": "private", "return": "void", "signature": "void configureLocalResourceForPath(LocalResource rsrc, Path path)", "full_signature": "private void configureLocalResourceForPath(LocalResource rsrc, Path path)", "class_method_signature": "LuaContainerLaunchParameters.configureLocalResourceForPath(LocalResource rsrc, Path path)", "testcase": false, "constructor": false}, {"identifier": "getEnvironment", "parameters": "()", "modifiers": "@Override public", "return": "Map<String, String>", "signature": "Map<String, String> getEnvironment()", "full_signature": "@Override public Map<String, String> getEnvironment()", "class_method_signature": "LuaContainerLaunchParameters.getEnvironment()", "testcase": false, "constructor": false}, {"identifier": "getCommands", "parameters": "()", "modifiers": "@Override public", "return": "List<String>", "signature": "List<String> getCommands()", "full_signature": "@Override public List<String> getCommands()", "class_method_signature": "LuaContainerLaunchParameters.getCommands()", "testcase": false, "constructor": false}, {"identifier": "toCommand", "parameters": "(LuaWrapper table)", "modifiers": "public", "return": "String", "signature": "String toCommand(LuaWrapper table)", "full_signature": "public String toCommand(LuaWrapper table)", "class_method_signature": "LuaContainerLaunchParameters.toCommand(LuaWrapper table)", "testcase": false, "constructor": false}], "file": "java/common/src/main/java/com/cloudera/kitten/lua/LuaContainerLaunchParameters.java"}, "focal_method": {"identifier": "getCommands", "parameters": "()", "modifiers": "@Override public", "return": "List<String>", "body": "@Override\n  public List<String> getCommands() {\n    List<String> cmds = Lists.newArrayList();\n    if (!lv.isNil(LuaFields.COMMANDS)) {\n      Iterator<LuaPair> pairsIter = lv.getTable(LuaFields.COMMANDS).arrayIterator();\n      while (pairsIter.hasNext()) {\n        LuaValue c = pairsIter.next().value;\n        if (c.isstring()) {\n          cmds.add(c.tojstring());\n        } else if (c.istable()) {\n          cmds.add(toCommand(new LuaWrapper(c.checktable())));\n        }\n      }\n    } else if (!lv.isNil(LuaFields.COMMAND)) {\n      if (lv.isTable(LuaFields.COMMAND)) {\n        cmds.add(toCommand(lv.getTable(LuaFields.COMMAND)));\n      } else {\n        cmds.add(lv.getString(LuaFields.COMMAND));\n      }\n    }\n    if (cmds.isEmpty()) {\n      LOG.fatal(\"No commands found in container!\");\n    }\n    return cmds;\n  }", "signature": "List<String> getCommands()", "full_signature": "@Override public List<String> getCommands()", "class_method_signature": "