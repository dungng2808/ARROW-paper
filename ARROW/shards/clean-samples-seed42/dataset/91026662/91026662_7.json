atus());\n        }\n    }", "signature": "void testTeardown()", "full_signature": "@Test public void testTeardown()", "class_method_signature": "LoaderTest.testTeardown()", "testcase": true, "constructor": false, "invocations": ["toString", "randomUUID", "setRegion", "getRegion", "setStackName", "setTemplateBody", "toString", "getResourceAsStream", "getClass", "createStack", "setConfiguration", "teardown", "getRegion", "getStackSummaries", "listStacks", "equalsIgnoreCase", "getStackStatus", "equalsIgnoreCase", "getStackStatus", "equalsIgnoreCase", "getStackStatus", "equals", "getStackName", "fail", "getStackStatus"]}, "focal_class": {"identifier": "Loader", "superclass": "", "interfaces": "", "fields": [{"original_string": "private SNSManager sns;", "modifier": "private", "type": "SNSManager", "declarator": "sns", "var_name": "sns"}, {"original_string": "private Parser parser = new Parser();", "modifier": "private", "type": "Parser", "declarator": "parser = new Parser()", "var_name": "parser"}, {"original_string": "private AmazonS3 client = new AmazonS3Client();", "modifier": "private", "type": "AmazonS3", "declarator": "client = new AmazonS3Client()", "var_name": "client"}, {"original_string": "private SparkSession spark;", "modifier": "private", "type": "SparkSession", "declarator": "spark", "var_name": "spark"}, {"original_string": "private Dataset<Row> df;", "modifier": "private", "type": "Dataset<Row>", "declarator": "df", "var_name": "df"}, {"original_string": "Configuration configuration;", "modifier": "", "type": "Configuration", "declarator": "configuration", "var_name": "configuration"}], "methods": [{"identifier": "Loader", "parameters": "(Region region)", "modifiers": "public", "return": "", "signature": " Loader(Region region)", "full_signature": "public  Loader(Region region)", "class_method_signature": "Loader.Loader(Region region)", "testcase": false, "constructor": true}, {"identifier": "Loader", "parameters": "(String app, String master, String wa