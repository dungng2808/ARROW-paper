tring>();\n            reader.beginObject();\n            while (reader.hasNext()) {\n                String key = reader.nextName();\n                if (reader.isContainer()) {\n                    // skip non string nodes\n                    reader.skipValue();\n                } else {\n                    map.put(key, reader.nextString());\n                }\n            }\n            reader.endObject();\n            reader.close();\n\n            return Collections.unmodifiableMap(map);\n        } catch (IOException e) {\n            throw new AmazonClientException(\"Unable to parse JSON String.\", e);\n        }\n    }", "signature": "Map<String, String> jsonToMap(Reader in)", "full_signature": "@SuppressWarnings(\"unchecked\") public static Map<String, String> jsonToMap(Reader in)", "class_method_signature": "JsonUtils.jsonToMap(Reader in)", "testcase": false, "constructor": false, "invocations": ["getJsonReader", "peek", "beginObject", "hasNext", "nextName", "isContainer", "skipValue", "put", "nextString", "endObject", "close", "unmodifiableMap"]}, "repository": {"repo_id": 92033442, "url": "https://github.com/xfsnow/android", "language": "Java", "is_fork": false, "fork_count": 3, "stargazer_count": 7, "size": 1477, "license": "licensed"}}