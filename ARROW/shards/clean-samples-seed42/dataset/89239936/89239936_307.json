ull == val) {\n      return encodeNull(dst, ord);\n    }\n    if (val.contains(\"\\u0000\"))\n      throw new IllegalArgumentException(\"Cannot encode String values containing '\\\\u0000'\");\n    final int offset = dst.getOffset(), start = dst.getPosition();\n    dst.put(TEXT);\n    // TODO: is there no way to decode into dst directly?\n    dst.put(val.getBytes(UTF8));\n    dst.put(TERM);\n    ord.apply(dst.getBytes(), offset + start, dst.getPosition() - start);\n    return dst.getPosition() - start;\n  }", "signature": "int encodeString(PositionedByteRange dst, String val, Order ord)", "full_signature": "public static int encodeString(PositionedByteRange dst, String val, Order ord)", "class_method_signature": "OrderedBytes.encodeString(PositionedByteRange dst, String val, Order ord)", "testcase": false, "constructor": false, "invocations": ["encodeNull", "contains", "getOffset", "getPosition", "put", "put", "getBytes", "put", "apply", "getBytes", "getPosition", "getPosition"]}, "repository": {"repo_id": 89239936, "url": "https://github.com/fengchen8086/ditb", "language": "Java", "is_fork": false, "fork_count": 2, "stargazer_count": 11, "size": 13017, "license": "licensed"}}