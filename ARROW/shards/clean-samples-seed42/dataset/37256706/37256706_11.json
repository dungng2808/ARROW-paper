      {\n                    level = nameOfOrNull(keyData[i], Level.class);\n                }\n                else if (valueOfOrNull(keyData[i], Block.class) != null)\n                {\n                    block = nameOfOrNull(keyData[i], Block.class);\n                }\n                else if (valueOfOrNull(keyData[i], Order.class) != null)\n                {\n                    order = nameOfOrNull(keyData[i], Order.class);\n                }\n            }\n        }\n\n        return new String[]{plainKey, level, block, order};\n    }", "signature": "String[] parseData(String key)", "full_signature": "public static String[] parseData(String key)", "class_method_signature": "CustomStorageMap.parseData(String key)", "testcase": false, "constructor": false, "invocations": ["contains", "log", "format", "name", "name", "name", "split", "name", "name", "name", "valueOfOrNull", "nameOfOrNull", "valueOfOrNull", "nameOfOrNull", "valueOfOrNull", "nameOfOrNull"]}, "repository": {"repo_id": 37256706, "url": "https://github.com/jpfeffer/teamcity-highlighter", "language": "Java", "is_fork": false, "fork_count": 3, "stargazer_count": 11, "size": 166, "license": "licensed"}}