ver", "signature": "DssServer addExceptionHandler(DssExceptionHandler exceptionHandler)", "full_signature": "@Override public DssServer addExceptionHandler(DssExceptionHandler exceptionHandler)", "class_method_signature": "DssWebSocketServer.addExceptionHandler(DssExceptionHandler exceptionHandler)", "testcase": false, "constructor": false}, {"identifier": "newDssWebsocketChannelProperty", "parameters": "()", "modifiers": "private", "return": "DssWebSocketChannelProperty", "signature": "DssWebSocketChannelProperty newDssWebsocketChannelProperty()", "full_signature": "private DssWebSocketChannelProperty newDssWebsocketChannelProperty()", "class_method_signature": "DssWebSocketServer.newDssWebsocketChannelProperty()", "testcase": false, "constructor": false}, {"identifier": "dssWebsocketChannelInitializer", "parameters": "()", "modifiers": "private", "return": "DssWebSocketChannelInitializer", "signature": "DssWebSocketChannelInitializer dssWebsocketChannelInitializer()", "full_signature": "private DssWebSocketChannelInitializer dssWebsocketChannelInitializer()", "class_method_signature": "DssWebSocketServer.dssWebsocketChannelInitializer()", "testcase": false, "constructor": false}], "file": "dss-server/src/main/java/io/github/ztkmkoo/dss/server/websocket/DssWebSocketServer.java"}, "focal_method": {"identifier": "start", "parameters": "()", "modifiers": "@Override public", "return": "void", "body": "@Override\n    public void start() throws InterruptedException {\n        final DssWebSocketChannelInitializer channelInitializer = dssWebsocketChannelInitializer();\n\n        final EventLoopGroup bossGroup = new NioEventLoopGroup();\n        final EventLoopGroup workerGroup = new NioEventLoopGroup();\n\n        final ServerBootstrap bootstrap = new ServerBootstrap();\n        bootstrap.group(bossGroup, workerGroup);\n\n        final DssWebSocketChannelProperty property = newDssWebsocketChannelProperty();\n\n        try {\n            final DssWebSocketChannel dssWebsocketChannel = new DssWebSocketChannel();\n            channel = dssWebsocketChannel.bind(bootstrap, property, channelInitializer);\n            active.set(true);\n            shutdown.set(false);\n            logger.info(\"Server Started\");\n            channel.closeFuture().sync();\n        } finally {\n            logger.info(\"Shut down worker and boss group gracefully\");\n            workerGroup.shutdownGracefully();\n            bossGroup.shutdownGracefully();\n            shutdown.set(true);\n        }\n\n    }", "signature": "void start()", "full_signature": "@Override public void start()", "class_method_signature": "DssWebSocketServer.start()", "testcase": false, "constructor": false, "invocations": ["dssWebsocketChannelInitializer", "group", "newDssWebsocketChannelProperty", "bind", "set", "set", "info", "sync", "closeFuture", "info", "shutdownGracefully", "shutdownGracefully", "set"]}, "repository": {"repo_id": 200492090, "url": "https://github.com/ztkmkoo/dss", "language": "Java", "is_fork": false, "fork_count": 3, "stargazer_count": 7, "size": 308, "license": "licensed"}}