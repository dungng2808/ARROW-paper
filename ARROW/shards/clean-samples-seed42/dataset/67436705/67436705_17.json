ters": "(int temperatureInMired)", "modifiers": "private", "return": "int", "signature": "int miredToKelvin(int temperatureInMired)", "full_signature": "private int miredToKelvin(int temperatureInMired)", "class_method_signature": "ZigBeeConverterColorTemperature.miredToKelvin(int temperatureInMired)", "testcase": false, "constructor": false}, {"identifier": "kelvinToMired", "parameters": "(int temperatureInKelvin)", "modifiers": "private", "return": "int", "signature": "int kelvinToMired(int temperatureInKelvin)", "full_signature": "private int kelvinToMired(int temperatureInKelvin)", "class_method_signature": "ZigBeeConverterColorTemperature.kelvinToMired(int temperatureInKelvin)", "testcase": false, "constructor": false}, {"identifier": "percentToKelvin", "parameters": "(PercentType temperatureInPercent)", "modifiers": "private", "return": "int", "signature": "int percentToKelvin(PercentType temperatureInPercent)", "full_signature": "private int percentToKelvin(PercentType temperatureInPercent)", "class_method_signature": "ZigBeeConverterColorTemperature.percentToKelvin(PercentType temperatureInPercent)", "testcase": false, "constructor": false}, {"identifier": "percentToMired", "parameters": "(PercentType temperatureInPercent)", "modifiers": "private", "return": "int", "signature": "int percentToMired(PercentType temperatureInPercent)", "full_signature": "private int percentToMired(PercentType temperatureInPercent)", "class_method_signature": "ZigBeeConverterColorTemperature.percentToMired(PercentType temperatureInPercent)", "testcase": false, "constructor": false}, {"identifier": "kelvinToPercent", "parameters": "(int temperatureInKelvin)", "modifiers": "private", "return": "PercentType", "signature": "PercentType kelvinToPercent(int temperatureInKelvin)", "full_signature": "private PercentType kelvinToPercent(int temperatureInKelvin)", "class_method_signature": "ZigBeeConverterColorTemperature.kelvinToPercent(int temperatureInKelvin)", "testcase": false, "constructor": false}, {"identifier": "miredToPercent", "parameters": "(Integer temperatureInMired)", "modifiers": "private", "return": "PercentType", "signature": "PercentType miredToPercent(Integer temperatureInMired)", "full_signature": "private PercentType miredToPercent(Integer temperatureInMired)", "class_method_signature": "ZigBeeConverterColorTemperature.miredToPercent(Integer temperatureInMired)", "testcase": false, "constructor": false}, {"identifier": "determineMinMaxTemperature", "parameters": "(ZclColorControlCluster serverClusterColorControl)", "modifiers": "private", "return": "void", "signature": "void determineMinMaxTemperature(ZclColorControlCluster serverClusterColorControl)", "full_signature": "private void determineMinMaxTemperature(ZclColorControlCluster serverClusterColorControl)", "class_method_signature": "ZigBeeConverterColorTemperature.determineMinMaxTemperature(ZclColorControlCluster serverClusterColorControl)", "testcase": false, "constructor": false}], "file": "org.openhab.binding.zigbee/src/main/java/org/openhab/binding/zigbee/internal/converter/ZigBeeConverterColorTemperature.java"}, "focal_method": {"identifier": "attributeUpdated", "parameters": "(ZclAttribute attribute, Object val)", "modifiers": "@Override public", "return": "void", "body": "@Override\n    public void attributeUpdated(ZclAttribute attribute, Object val) {\n        logger.debug(\"{}: ZigBee attribute reports {}  on endpoint {}\", endpoint.getIeeeAddress(), attribute,\n                endpoint.getEndpointId());\n        if (attribute.getCluster() == ZclClusterType.COLOR_CONTROL\n                && attribute.getId() == ZclColorControlCluster.ATTR_COLORTEMPERATURE) {\n\n            if (lastColorMode == null || lastColorMode == ColorModeEnum.COLOR_TEMPERATURE) {\n                Integer temperatureInMired = (Integer) val;\n\n                PercentType percent = miredToPercent(temperatureInMired);\n                if (percent != null) {\n                    updateChannelState(percent);\n                }\n            }\n        } else if (attribute.getCluster() == ZclClusterType.COLOR_CONTROL\n                && attribute.getId() == ZclColorControlCluster.ATTR_COLORMODE) {\n            Integer colorMode = (Integer) val;\n            lastColorMode = ColorModeEnum.getByValue(colorMode);\n            if (lastColorMode != ColorModeEnum.COLOR_TEMPERATURE) {\n                updateChannelState(UnDefType.UNDEF);\n            }\n        }\n    }", "signature": "void attributeUpdated(ZclAttribute attribute, Object val)", "full_signature": "@Override public void attributeUpdated(ZclAttribute attribute, Object val)", "class_method_signature": "ZigBeeConverterColorTemperature.attributeUpdated(ZclAttribute attribute, Object val)", "testcase": false, "constructor": false, "invocations": ["debug", "getIeeeAddress", "getEndpointId", "getCluster", "getId", "miredToPercent", "updateChannelState", "getCluster", "getId", "getByValue", "updateChannelState"]}, "repository": {"repo_id": 67436705, "url": "https://github.com/openhab/org.openhab.binding.zigbee", "stars": 55, "created": "9/5/2016 4:45:13 PM +00:00", "updates": "2020-01-19T21:26:50+00:00", "fork": "False", "license": "licensed"}}