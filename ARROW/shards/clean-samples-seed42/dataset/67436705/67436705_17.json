{"test_class": {"identifier": "ZigBeeConverterColorTemperatureTest", "superclass": "", "interfaces": "", "fields": [], "file": "org.openhab.binding.zigbee/src/test/java/org/openhab/binding/zigbee/internal/converter/ZigBeeConverterColorTemperatureTest.java"}, "test_case": {"identifier": "testAttributeUpdatedWhenColorModeIsNull", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void testAttributeUpdatedWhenColorModeIsNull() {\n        ZigBeeEndpoint endpoint = Mockito.mock(ZigBeeEndpoint.class);\n        ZigBeeCoordinatorHandler coordinatorHandler = Mockito.mock(ZigBeeCoordinatorHandler.class);\n        Mockito.when(coordinatorHandler.getEndpoint(ArgumentMatchers.any(IeeeAddress.class), ArgumentMatchers.anyInt()))\n                .thenReturn(endpoint);\n\n        ZigBeeConverterColorTemperature converter = getConverter();\n        ArgumentCaptor<ChannelUID> channelCapture = ArgumentCaptor.forClass(ChannelUID.class);\n        ArgumentCaptor<State> stateCapture = ArgumentCaptor.forClass(State.class);\n        ZigBeeThingHandler thingHandler = Mockito.mock(ZigBeeThingHandler.class);\n        Channel channel = ChannelBuilder.create(new ChannelUID(\"a:b:c:d\"), \"\").build();\n        converter.initialize(thingHandler, channel, coordinatorHandler, new IeeeAddress(\"1234567890ABCDEF\"), 1);\n\n        ZclAttribute colorTemperatureAttribute = new ZclAttribute(new ZclColorControlCluster(endpoint), 7,\n                \"ColorTemperature\", ZclDataType.UNSIGNED_16_BIT_INTEGER, false, false, false, false);\n\n        // Do not initialize the color mode\n\n        // Set the color temperature and ensure that the channel is set\n        colorTemperatureAttribute.updateValue(new Integer(250));\n        converter.attributeUpdated(colorTemperatureAttribute, colorTemperatureAttribute.getLastValue());\n        Mockito.verify(thingHandler, Mockito.times(1)).setChannelState(channelCapture.capture(),\n                stateCapture.capture());\n        assertEquals(convertMiredToPercent(converter, 250), stateCapture.getValue());\n    }", "signature": "void testAttributeUpdatedWhenColorModeIsNull()", "full_signature": "@Test public void testAttributeUpdatedWhenColorModeIsNull()", "class_method_signature": "ZigBeeConverterColorTemperatureTest.testAttributeUpdatedWhenColorModeIsNull()", "testcase": true, "constructor": false, "invocations": ["mock", "mock", "thenReturn", "when", "getEndpoint", "any", "anyInt", "getConverter", "forClass", "forClass", "mock", "build", "create", "initialize", "updateValue", "attributeUpdated", "getLastValue", "setChannelState", "verify", "times", "capture", "capture", "assertEquals", "convertMiredToPercent", "getValue"]}, "focal_class": {"identifier": "ZigBeeConverterColorTemperature", "superclass": "extends ZigBeeBaseChannelConverter", "interfaces": "implements ZclAttributeListener", "fields": [{"original_string": "private Logger logger = LoggerFactory.getLogger(ZigBeeConverterColorTemperature.class);", "modifier": "private", "type": "Logger", "declarator": "logger = LoggerFactory.getLogger(ZigBeeConverterColorTemperature.class)", "var_name": "logger"}, {"original_string": "private ZclColorControlCluster clusterColorControl;", "modifier": "private", "type": "ZclColorControlCluster", "declarator": "clusterColorControl", "var_name": "clusterColorControl"}, {"original_string": "private double kelvinMin;", "modifier": "private", "type": "double", "declarator": "kelvinMin", "var_name": "kelvinMin"}, {"original_string": "private double kelvinMax;", "modifier": "private", "type": "double", "declarator": "kelvinMax", "var_name": "kelvinMax"}, {"original_string": "private double kelvinRange;", "modifier": "private", "type": "double", "declarator": "kelvinRange", "var_name": "kelvinRange"}, {"original_string": "private ColorModeEnum lastColorMode;", "modifier": "private", "type": "ColorModeEnum", "declarator": "lastColorMode", "var_name": "lastColorMode"}, {"original_string": "private fi