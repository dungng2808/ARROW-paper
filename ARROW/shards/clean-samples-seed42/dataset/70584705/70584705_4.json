eters": "()", "modifiers": "public static", "return": "String", "signature": "String getConsoleRootPath()", "full_signature": "public static String getConsoleRootPath()", "class_method_signature": "Utils.getConsoleRootPath()", "testcase": false, "constructor": false}, {"identifier": "getRegistryConfigPath", "parameters": "(String ip)", "modifiers": "public static", "return": "String", "signature": "String getRegistryConfigPath(String ip)", "full_signature": "public static String getRegistryConfigPath(String ip)", "class_method_signature": "Utils.getRegistryConfigPath(String ip)", "testcase": false, "constructor": false}], "file": "pigeon-extensions/pigeon-registry-zookeeper/src/main/java/com/dianping/pigeon/registry/zookeeper/Utils.java"}, "focal_method": {"identifier": "getServiceIpPortList", "parameters": "(String serviceAddress)", "modifiers": "public static", "return": "List<String[]>", "body": "public static List<String[]> getServiceIpPortList(String serviceAddress) {\n        List<String[]> result = new ArrayList<String[]>();\n        if (serviceAddress != null && serviceAddress.length() > 0) {\n            String[] hostArray = serviceAddress.split(\",\");\n            for (String host : hostArray) {\n                int idx = host.lastIndexOf(\":\");\n                if (idx != -1) {\n                    String ip = null;\n                    int port = -1;\n                    try {\n                        ip = host.substring(0, idx);\n                        port = Integer.parseInt(host.substring(idx + 1));\n                    } catch (RuntimeException e) {\n                        logger.warn(\"invalid host: \" + host + \", ignored!\");\n                    }\n                    if (ip != null && port > 0) {\n                        result.add(new String[]{ip, port + \"\"});\n                    }\n                } else {\n                    logger.warn(\"invalid host: \" + host + \", ignored!\");\n                }\n            }\n        }\n        return result;\n    }", "signature": "List<String[]> getServiceIpPortList(String serviceAddress)", "full_signature": "public static List<String[]> getServiceIpPortList(String serviceAddress)", "class_method_signature": "Utils.getServiceIpPortList(String serviceAddress)", "testcase": false, "constructor": false, "invocations": ["length", "split", "lastIndexOf", "substring", "parseInt", "substring", "warn", "add", "warn"]}, "repository": {"repo_id": 70584705, "url": "https://github.com/dianping/pigeon", "language": "Java", "is_fork": false, "fork_count": 260, "stargazer_count": 761, "size": 64926, "license": "licensed"}}