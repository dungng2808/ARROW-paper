ntifier": "matchesEndCalendarYear", "parameters": "(final LocalDate date)", "modifiers": "private static", "return": "boolean", "signature": "boolean matchesEndCalendarYear(final LocalDate date)", "full_signature": "private static boolean matchesEndCalendarYear(final LocalDate date)", "class_method_signature": "PeriodUtil.matchesEndCalendarYear(final LocalDate date)", "testcase": false, "constructor": false}, {"identifier": "matchesStartFinancialYear", "parameters": "(final LocalDate date)", "modifiers": "private static", "return": "boolean", "signature": "boolean matchesStartFinancialYear(final LocalDate date)", "full_signature": "private static boolean matchesStartFinancialYear(final LocalDate date)", "class_method_signature": "PeriodUtil.matchesStartFinancialYear(final LocalDate date)", "testcase": false, "constructor": false}, {"identifier": "matchesEndFinancialYear", "parameters": "(final LocalDate date)", "modifiers": "private static", "return": "boolean", "signature": "boolean matchesEndFinancialYear(final LocalDate date)", "full_signature": "private static boolean matchesEndFinancialYear(final LocalDate date)", "class_method_signature": "PeriodUtil.matchesEndFinancialYear(final LocalDate date)", "testcase": false, "constructor": false}], "file": "estatioapp/app/src/main/java/org/estatio/module/capex/dom/util/PeriodUtil.java"}, "focal_method": {"identifier": "yearFromPeriod", "parameters": "(final String period)", "modifiers": "public static", "return": "LocalDateInterval", "body": "public static LocalDateInterval yearFromPeriod(final String period){\n        if (period == null) {\n            return new LocalDateInterval(); // Interval with open start and end date\n        }\n        LocalDate startDate = null;\n        LocalDate endDate = null;\n        if (financialYearPattern.matcher(period).matches()){\n            Integer year = Integer.valueOf(period.substring(1,5));\n            // F2021 has 9 months; After 2021 financial year equals calendar year\n            if (year<=2021) {\n                startDate = new LocalDate(year - 1, 7, 1);\n                endDate = year == 2021 ? new LocalDate(year - 1, 12, 31) : new LocalDate(year, 6, 30);\n            } else {\n                //\n            }\n        }\n        if (yearPattern.matcher(period).matches()){\n            Integer year = Integer.valueOf(period.substring(0,4));\n            startDate = new LocalDate(year, 1, 1);\n            endDate = new LocalDate(year, 12, 31);\n        }\n        return new LocalDateInterval(startDate, endDate);\n    }", "signature": "LocalDateInterval yearFromPeriod(final String period)", "full_signature": "public static LocalDateInterval yearFromPeriod(final String period)", "class_method_signature": "PeriodUtil.yearFromPeriod(final String period)", "testcase": false, "constructor": false, "invocations": ["matches", "matcher", "valueOf", "substring", "matches", "matcher", "valueOf", "substring"]}, "repository": {"repo_id": 11128472, "url": "https://github.com/estatio/estatio", "stars": 184, "created": "7/2/2013 3:49:01 PM +00:00", "updates": "2020-01-22T12:30:30+00:00", "fork": "False", "license": "licensed"}}