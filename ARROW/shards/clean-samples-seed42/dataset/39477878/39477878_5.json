(Scanner scanner)", "testcase": false, "constructor": false}, {"identifier": "startTitle", "parameters": "(Scanner scanner)", "modifiers": "private", "return": "boolean", "signature": "boolean startTitle(Scanner scanner)", "full_signature": "private boolean startTitle(Scanner scanner)", "class_method_signature": "LinkReferenceDefinitionParser.startTitle(Scanner scanner)", "testcase": false, "constructor": false}, {"identifier": "title", "parameters": "(Scanner scanner)", "modifiers": "private", "return": "boolean", "signature": "boolean title(Scanner scanner)", "full_signature": "private boolean title(Scanner scanner)", "class_method_signature": "LinkReferenceDefinitionParser.title(Scanner scanner)", "testcase": false, "constructor": false}, {"identifier": "finishReference", "parameters": "()", "modifiers": "private", "return": "void", "signature": "void finishReference()", "full_signature": "private void finishReference()", "class_method_signature": "LinkReferenceDefinitionParser.finishReference()", "testcase": false, "constructor": false}], "file": "commonmark/src/main/java/org/commonmark/internal/LinkReferenceDefinitionParser.java"}, "focal_method": {"identifier": "label", "parameters": "(Scanner scanner)", "modifiers": "private", "return": "boolean", "body": "private boolean label(Scanner scanner) {\n        Position start = scanner.position();\n        if (!LinkScanner.scanLinkLabelContent(scanner)) {\n            return false;\n        }\n\n        label.append(scanner.textBetween(start, scanner.position()));\n\n        if (!scanner.hasNext()) {\n            // label might continue on next line\n            label.append('\\n');\n            return true;\n        } else if (scanner.next(']')) {\n            // end of label\n            if (!scanner.next(':')) {\n                return false;\n            }\n\n            // spec: A link label can have at most 999 characters inside the square brackets.\n            if (label.length() > 999) {\n                return false;\n            }\n\n            String normalizedLabel = Escaping.normalizeLabelContent(label.toString());\n            if (normalizedLabel.isEmpty()) {\n                return false;\n            }\n\n            this.normalizedLabel = normalizedLabel;\n            state = State.DESTINATION;\n\n            scanner.whitespace();\n            return true;\n        } else {\n            return false;\n        }\n    }", "signature": "boolean label(Scanner scanner)", "full_signature": "private boolean label(Scanner scanner)", "class_method_signature": "LinkReferenceDefinitionParser.label(Scanner scanner)", "testcase": false, "constructor": false, "invocations": ["position", "scanLinkLabelContent", "append", "textBetween", "position", "hasNext", "append", "next", "next", "length", "normalizeLabelContent", "toString", "isEmpty", "whitespace"]}, "repository": {"repo_id": 39477878, "url": "https://github.com/atlassian/commonmark-java", "stars": 1165, "created": "7/22/2015 1:08:55 AM +00:00", "updates": "2020-01-26T08:06:46+00:00", "fork": "False", "license": "licensed"}}