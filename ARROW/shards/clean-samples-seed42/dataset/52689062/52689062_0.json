{"test_class": {"identifier": "SketchyMovingMADTest", "superclass": "", "interfaces": "", "fields": [{"original_string": "@Multiline\n    public static String madConfig;", "modifier": "@Multiline\n    public static", "type": "String", "declarator": "madConfig", "var_name": "madConfig"}], "file": "core/src/test/java/com/caseystella/analytics/outlier/streaming/mad/SketchyMovingMADTest.java"}, "test_case": {"identifier": "testSketchyMovingMAD", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void testSketchyMovingMAD() throws IOException {\n        Random r = new Random(0);\n        List<DataPoint> points = new ArrayList<>();\n        DescriptiveStatistics stats = new DescriptiveStatistics();\n        DescriptiveStatistics medianStats = new DescriptiveStatistics();\n        OutlierConfig config = JSONUtil.INSTANCE.load(madConfig, OutlierConfig.class);\n        SketchyMovingMAD madAlgo = ((SketchyMovingMAD)config.getSketchyOutlierAlgorithm()).withConfig(config);\n        int i = 0;\n        for(i = 0; i < 10000;++i) {\n            double val = r.nextDouble() * 1000 - 10000;\n            stats.addValue(val);\n            DataPoint dp = (new DataPoint(i, val, null, \"foo\"));\n            madAlgo.analyze(dp);\n            points.add(dp);\n        }\n        for(DataPoint dp : points) {\n            medianStats.addValue(Math.abs(dp.getValue() - stats.getPercentile(50)));\n        }\n        double mad = medianStats.getPercentile(50);\n        double median = stats.getPercentile(50);\n        {\n            double val = getValAtModifiedZScore(3.6, mad, median);\n            System.out.println(\"MODERATE => \" + val);\n            DataPoint dp = (new DataPoint(i++, val, null, \"foo\"));\n            Severity s = madAlgo.analyze(dp).getSeverity();\n            Assert.assertTrue(s == Severity.MODERATE_OUTLIER );\n        }\n        {\n            double val = getValAtModifiedZScore(6, mad, median);\n            System.out.println(\"SEVERE => \" + val);\n            DataPoint dp = (new DataPoint(i++, val, null, \"foo\"));\n            Severity s = madAlgo.analyze(dp).getSeverity();\n            Assert.assertTrue(s == Severity.SEVERE_OUTLIER );\n        }\n\n        Assert.assertTrue(madAlgo.getMedianDistributions().get(\"foo\").getAmount() <= 110);\n        Assert.assertTrue(madAlgo.getMedianDistributions().get(\"foo\").getChunks().size() <= 12);\n    }", "signature": "void testSketchyMovingMAD()", "full_signature": "@Test public void testSketchyMovingMAD()", "class_method_signature": "SketchyMovingMADTest.testSketchyMovingMAD()", "testcase": true, "constructor": false, "invocations": ["load", "withConfig", "getSketchyOutlierAlgorithm", "nextDouble", "addValue", "analyze", "add", "addValue", "abs", "getValue", "getPercentile", "getPercentile", "getPercentile", "getValAtModifiedZScore", "println", "getSeverity", "analyze", "assertTrue", "getValAtModifiedZScore", "println", "getSeverity", "analyze", "assertTrue", "assertTrue", "getAmount", "get", "getMedianDistributions", "assertTrue", "size", "getChunks", "get", "getMedianDistributions"]}, "focal_class": {"identifier": "SketchyMovingMAD", "superclass": "", "interfaces": "implements OutlierAlgorithm", "fields": [{"original_string": "public static final double ZSCORE = 0.6745;", "modifier": "public static final", "type": "double", "declarator": "ZSCORE = 0.6745", "var_name": "ZSCORE"}, {"original_string": "private static final double EPSILON = 1e-4;", "modifier": "private static final", "type": "double", "declarator": "EPSILON = 1e-4", "var_name": "EPSILON"}, {"original_string": "private OutlierConfig config;", "modifier": "private", "type": "OutlierConfig", "declarator": "config", "var_name": "config"}, {"original_string": "private Map<String, Distribution.Context> valueDistributions = new HashMap<>();", "modifier": "private", "type": "Map<String, Distribution.Context>", "declarator": "valueDistributions = new HashMap<>()", "var_name": "valueDis