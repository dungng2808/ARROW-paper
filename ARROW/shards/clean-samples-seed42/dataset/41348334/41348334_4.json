r>> partitions, PartitioningContext context)", "class_method_signature": "AbstractKuduInputPartitioner.definePartitions(\n      Collection<Partition<AbstractKuduInputOperator>> partitions, PartitioningContext context)", "testcase": false, "constructor": false}, {"identifier": "partitioned", "parameters": "(Map<Integer, Partition<AbstractKuduInputOperator>> partitions)", "modifiers": "@Override public", "return": "void", "signature": "void partitioned(Map<Integer, Partition<AbstractKuduInputOperator>> partitions)", "full_signature": "@Override public void partitioned(Map<Integer, Partition<AbstractKuduInputOperator>> partitions)", "class_method_signature": "AbstractKuduInputPartitioner.partitioned(Map<Integer, Partition<AbstractKuduInputOperator>> partitions)", "testcase": false, "constructor": false}, {"identifier": "assign", "parameters": "(\n      List<KuduPartitionScanAssignmentMeta> totalList, PartitioningContext context)", "modifiers": "public abstract", "return": "Map<Integer, List<KuduPartitionScanAssignmentMeta>>", "signature": "Map<Integer, List<KuduPartitionScanAssignmentMeta>> assign(\n      List<KuduPartitionScanAssignmentMeta> totalList, PartitioningContext context)", "full_signature": "public abstract Map<Integer, List<KuduPartitionScanAssignmentMeta>> assign(\n      List<KuduPartitionScanAssignmentMeta> totalList, PartitioningContext context)", "class_method_signature": "AbstractKuduInputPartitioner.assign(\n      List<KuduPartitionScanAssignmentMeta> totalList, PartitioningContext context)", "testcase": false, "constructor": false}, {"identifier": "getPrototypeKuduInputOperator", "parameters": "()", "modifiers": "public", "return": "AbstractKuduInputOperator", "signature": "AbstractKuduInputOperator getPrototypeKuduInputOperator()", "full_signature": "public AbstractKuduInputOperator getPrototypeKuduInputOperator()", "class_method_signature": "AbstractKuduInputPartitioner.getPrototypeKuduInputOperator()", "testcase": false, "constructor": false}, {"identifier": "setPrototypeKuduInputOperator", "parameters": "(AbstractKuduInputOperator prototypeKuduInputOperator)", "modifiers": "public", "return": "void", "signature": "void setPrototypeKuduInputOperator(AbstractKuduInputOperator prototypeKuduInputOperator)", "full_signature": "public void setPrototypeKuduInputOperator(AbstractKuduInputOperator prototypeKuduInputOperator)", "class_method_signature": "AbstractKuduInputPartitioner.setPrototypeKuduInputOperator(AbstractKuduInputOperator prototypeKuduInputOperator)", "testcase": false, "constructor": false}], "file": "kudu/src/main/java/org/apache/apex/malhar/kudu/partitioner/AbstractKuduInputPartitioner.java"}, "focal_method": {"identifier": "getKuduScanTokensForSelectAllColumns", "parameters": "()", "modifiers": "public", "return": "List<KuduScanToken>", "body": "public List<KuduScanToken> getKuduScanTokensForSelectAllColumns() throws Exception\n  {\n    // We are not using the current query for deciding the partition strategy but a SELECT * as\n    // we do not want to want to optimize on just the current query. This prevents rapid throttling of operator\n    // instances when the scan patterns are erratic. On the other hand, this might result on under utilized\n    // operator resources in the DAG but will be consistent at a minimum.\n    ApexKuduConnection apexKuduConnection = prototypeKuduInputOperator.getApexKuduConnectionInfo().build();\n    KuduClient clientHandle = apexKuduConnection.getKuduClient();\n    KuduTable table = apexKuduConnection.getKuduTable();\n    KuduScanToken.KuduScanTokenBuilder builder = clientHandle.newScanTokenBuilder(table);\n    List<String> allColumns = new ArrayList<>();\n    List<ColumnSchema> columnList = apexKuduConnection.getKuduTable().getSchema().getColumns();\n    for ( ColumnSchema column : columnList) {\n      allColumns.add(column.getName());\n    }\n    builder.setProjectedColumnNames(allColumns);\n    LOG.debug(\"Building the partition pie assignments for the input operator\");\n    List<KuduScanToken> allPossibleTokens = builder.build();\n    apexKuduConnection.close();\n    return allPossibleTokens;\n  }", "signature": "List<KuduScanToken> getKuduScanTokensForSelectAllColumns()", "full_signature": "public List<KuduScanToken> getKuduScanTokensForSelectAllColumns()", "class_method_signature": "AbstractKuduInputPartitioner.getKuduScanTokensForSelectAllColumns()", "testcase": false, "constructor": false, "invocations": ["build", "getApexKuduConnectionInfo", "getKuduClient", "getKuduTable", "newScanTokenBuilder", "getColumns", "getSchema", "getKuduTable", "add", "getName", "setProjectedColumnNames", "debug", "build", "close"]}, "repository": {"repo_id": 41348334, "url": "https://github.com/apache/attic-apex-malhar", "language": "Java", "is_fork": false, "fork_count": 151, "stargazer_count": 130, "size": 91989, "license": "licensed"}}