{"test_class": {"identifier": "UnifiedPushMessageTest", "superclass": "", "interfaces": "", "fields": [], "file": "model/push/src/test/java/org/jboss/aerogear/unifiedpush/message/UnifiedPushMessageTest.java"}, "test_case": {"identifier": "testMessageToStrippedJson", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void testMessageToStrippedJson() throws IOException, URISyntaxException {\n        //given\n        final Map<String, Object> container = new LinkedHashMap<>();\n        final Map<String, Object> messageObject = new LinkedHashMap<>();\n        final Map<String, Object> apnsObject = new LinkedHashMap<>();\n\n        messageObject.put(\"alert\", \"HELLO!\");\n        messageObject.put(\"sound\", \"default\");\n        messageObject.put(\"badge\", 2);\n        Map<String, Object> data = new HashMap<>();\n        data.put(\"key\", \"value\");\n        data.put(\"key2\", \"value\");\n        messageObject.put(\"user-data\", data);\n        apnsObject.put(\"action-category\", \"category\");\n        apnsObject.put(\"content-available\", \"true\");\n        messageObject.put(\"simple-push\", \"version=123\");\n        messageObject.put(\"apns\",apnsObject);\n\n        container.put(\"message\", messageObject);\n\n        //when\n        final UnifiedPushMessage unifiedPushMessage = parsePushMessage(container);\n        String json = unifiedPushMessage.toStrippedJsonString();\n\n        //then\n        Path path = Paths.get(getClass().getResource(\"/message-tostrippedjson.json\").toURI());\n        String expectedJson = new String(Files.readAllBytes(path), Charset.defaultCharset());\n        //poor mans equals ignore white space\n        assertEquals(expectedJson.replaceAll(\"\\\\s\", \"\"), json);\n    }", "signature": "void testMessageToStrippedJson()", "full_signature": "@Test public void testMessageToStrippedJson()", "class_method_signature": "UnifiedPushMessageTest.testMessageToStrippedJson()", "testcase": true, "constructor": false, "invocations": ["put", "put", "put", "put", "put", "put", "put", "put", "put", "put", "put", "parsePushMessage", "toStrippedJsonString", "get", "toURI", "getResource", "getClass", "readAllBytes", "defaultCharset", "assertEquals", "replaceAll"]}, "focal_class": {"identifier": "UnifiedPushMessage", "superclass": "", "interfaces": "implements Serializable", "fields": [{"original_string": "private static final long serialVersionUID = -5978882928783277261L;", "modifier": "private static final", "type": "long", "declarator": "serialVersionUID = -5978882928783277261L", "var_name": "serialVersionUID"}, {"original_string": "private static final ObjectMapper OBJECT_MAPPER = new ObjectMapper();", "modifier": "private static final", "type": "ObjectMapper", "declarator": "OBJECT_MAPPER = new ObjectMapper()", "var_name": "OBJECT_MAPPER"}, {"original_string": "private Message message = new Message();", "modifier": "private", "type": "Message", "declarator": "message = new Message()", "var_name": "message"}, {"original_string": "private Criteria criteria = new Criteria();", "modifier": "private", "type": "Criteria", "declarator": "criteria = new Criteria()", "var_name": "criteria"}, {"original_string": "private Config config = new Config();", "modifier": "private", "type": "Config", "declarator": "config = new Config()", "var_name": "config"}], "methods": [{"identifier": "getCriteria", "parameters": "()", "modifiers": "public", "return": "Criteria", "signature": "Criteria getCriteria()", "full_signature": "public Criteria getCriteria()", "class_method_signature": "UnifiedPushMessage.getCriteria()", "testcase": false, "constructor": false}, {"identifier": "setCriteria", "parameters": "(Criteria criteria)", "modifiers": "public", "return": "void", "signature": "void setCriteria(Criteria criteria)", "full_signature": "public void setCriteria(Criteria criteria)", "class_method_signature": "UnifiedPushMessage.setCriteria(Criteria criteria)", "testcase": false, "const