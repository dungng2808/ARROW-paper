            .observeOn(mMainThreadScheduler)\n                .doOnSubscribe(() -> errorText.set(null))\n                .doOnSubscribe(() -> isLoading.set(true))\n                .doOnTerminate(() -> isLoading.set(false))\n                .subscribe(list -> {\n                    reddits.clear();\n                    reddits.addAll(list);\n                }, e -> {\n                    errorText.set(e.getMessage());\n                });\n    }", "signature": "void refresh()", "full_signature": "@VisibleForTesting void refresh()", "class_method_signature": "RedditListViewModel.refresh()", "testcase": false, "constructor": false, "invocations": ["subscribe", "doOnTerminate", "doOnSubscribe", "doOnSubscribe", "observeOn", "subscribeOn", "getReddits", "io", "set", "set", "set", "clear", "addAll", "set", "getMessage"]}, "repository": {"repo_id": 68648922, "url": "https://github.com/DanielSerdyukov/droidcon2016", "language": "Java", "is_fork": false, "fork_count": 0, "stargazer_count": 8, "size": 110, "license": "licensed"}}