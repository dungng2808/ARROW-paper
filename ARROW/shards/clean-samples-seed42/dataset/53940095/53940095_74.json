    note.runAll();\n    while(p.isTerminated()==false || p.getResult()==null) Thread.yield();\n\n    p.setStatus(Status.RUNNING);\n    Note cloneNote = notebook.cloneNote(note.getId(), \"clone note\");\n    Paragraph cp = cloneNote.paragraphs.get(0);\n    assertEquals(cp.getStatus(), Status.READY);\n    assertNotEquals(cp.getId(), p.getId());\n    assertEquals(cp.text, p.text);\n    assertEquals(cp.getResult().message(), p.getResult().message());\n  }", "signature": "void testCloneNote()", "full_signature": "@Test public void testCloneNote()", "class_method_signature": "NotebookTest.testCloneNote()", "testcase": true, "constructor": false, "invocations": ["createNote", "setInterpreters", "getNoteReplLoader", "getDefaultInterpreterSettingList", "addParagraph", "setText", "runAll", "isTerminated", "getResult", "yield", "setStatus", "cloneNote", "getId", "get", "assertEquals", "getStatus", "assertNotEquals", "getId", "getId", "assertEquals", "assertEquals", "message", "getResult", "message", "getResult"]}, "focal_class": {"identifier": "Notebook", "superclass": "", "interfaces": "", "fields": [{"original_string": "Logger logger = LoggerFactory.getLogger(Notebook.class);", "modifier": "", "type": "Logger", "declarator": "logger = LoggerFactory.getLogger(Notebook.class)", "var_name": "logger"}, {"original_string": "@SuppressWarnings(\"unused\") @Deprecated //TODO(bzz): remove unused\n  private SchedulerFactory schedulerFactory;", "modifier": "@SuppressWarnings(\"unused\") @Deprecated //TODO(bzz): remove unused\n  private", "type": "SchedulerFactory", "declarator": "schedulerFactory", "var_name": "schedulerFactory"}, {"original_string": "private InterpreterFactory replFactory;", "modifier": "private", "type": "InterpreterFactory", "declarator": "replFactory", "var_name": "replFactory"}, {"original_string": "Map<String, Note> notes = new LinkedHashMap<String, Note>();", "modifier": "", "type": "Map<String, Note>", "declarator": "notes = new LinkedHashMap<String, Note>()", 