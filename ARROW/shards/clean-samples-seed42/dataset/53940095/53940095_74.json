actory getInterpreterFactory()", "class_method_signature": "Notebook.getInterpreterFactory()", "testcase": false, "constructor": false}, {"identifier": "getConf", "parameters": "()", "modifiers": "public", "return": "ZeppelinConfiguration", "signature": "ZeppelinConfiguration getConf()", "full_signature": "public ZeppelinConfiguration getConf()", "class_method_signature": "Notebook.getConf()", "testcase": false, "constructor": false}, {"identifier": "close", "parameters": "()", "modifiers": "public", "return": "void", "signature": "void close()", "full_signature": "public void close()", "class_method_signature": "Notebook.close()", "testcase": false, "constructor": false}], "file": "zeppelin-zengine/src/main/java/org/apache/zeppelin/notebook/Notebook.java"}, "focal_method": {"identifier": "cloneNote", "parameters": "(String sourceNoteID, String newNoteName)", "modifiers": "public", "return": "Note", "body": "public Note cloneNote(String sourceNoteID, String newNoteName) throws\n      IOException, CloneNotSupportedException, IllegalArgumentException {\n\n    Note sourceNote = getNote(sourceNoteID);\n    if (sourceNote == null) {\n      throw new IllegalArgumentException(sourceNoteID + \"not found\");\n    }\n    Note newNote = createNote();\n    if (newNoteName != null) {\n      newNote.setName(newNoteName);\n    }\n    // Copy the interpreter bindings\n    List<String> boundInterpreterSettingsIds = getBindedInterpreterSettingsIds(sourceNote.id());\n    bindInterpretersToNote(newNote.id(), boundInterpreterSettingsIds);\n\n    List<Paragraph> paragraphs = sourceNote.getParagraphs();\n    for (Paragraph p : paragraphs) {\n      newNote.addCloneParagraph(p);\n    }\n\n    notebookIndex.addIndexDoc(newNote);\n    newNote.persist();\n    return newNote;\n  }", "signature": "Note cloneNote(String sourceNoteID, String newNoteName)", "full_signature": "public Note cloneNote(String sourceNoteID, String newNoteName)", "class_method_signature": "Notebook.cloneNote(String sourceNoteID, String newNoteName)", "testcase": false, "constructor": false, "invocations": ["getNote", "createNote", "setName", "getBindedInterpreterSettingsIds", "id", "bindInterpretersToNote", "id", "getParagraphs", "addCloneParagraph", "addIndexDoc", "persist"]}, "repository": {"repo_id": 53940095, "url": "https://github.com/lorthos/incubator-zeppelin-druid", "language": "Java", "is_fork": false, "fork_count": 5, "stargazer_count": 6, "size": 13721, "license": "licensed"}}