{"test_class": {"identifier": "GoogleProviderTest", "superclass": "", "interfaces": "", "fields": [], "file": "google/src/test/java/com/tw/go/plugin/provider/google/GoogleProviderTest.java"}, "test_case": {"identifier": "authorizationWithRegex", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void authorizationWithRegex() throws Exception {\n        GooglePluginSettings googlePluginSettings = new GooglePluginSettings();\n        googlePluginSettings.setUsernameRegex(\".*@(foo.com|bar.com)$\");\n\n        assertFalse(new GoogleProvider().authorize(googlePluginSettings, new User(\"\", null, null)));\n        assertFalse(new GoogleProvider().authorize(googlePluginSettings, new User(\"bob@foo.com@example.com\", null, null)));\n\n        assertTrue(new GoogleProvider().authorize(googlePluginSettings, new User(\"bob@foo.com\", null, null)));\n        assertTrue(new GoogleProvider().authorize(googlePluginSettings, new User(\"bob@bar.com\", null, null)));\n    }", "signature": "void authorizationWithRegex()", "full_signature": "@Test public void authorizationWithRegex()", "class_method_signature": "GoogleProviderTest.authorizationWithRegex()", "testcase": true, "constructor": false, "invocations": ["setUsernameRegex", "assertFalse", "authorize", "assertFalse", "authorize", "assertTrue", "authorize", "assertTrue", "authorize"]}, "focal_class": {"identifier": "GoogleProvider", "superclass": "", "interfaces": "implements Provider<GooglePluginSettings>", "fields": [{"original_string": "private static final String IMAGE = Util.pluginImage();", "modifier": "private static final", "type": "String", "declarator": "IMAGE = Util.pluginImage()", "var_name": "IMAGE"}, {"original_string": "private static final String PLUGIN_ID = Util.pluginId();", "modifier": "private static final", "type": "String", "declarator": "PLUGIN_ID = Util.pluginId()", "var_name": "PLUGIN_ID"}], "methods": [{"identifier": "getPluginId", "parameters": "()", "modifier