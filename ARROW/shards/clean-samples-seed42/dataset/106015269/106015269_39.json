e()", "class_method_signature": "JmsPoolSession.isIgnoreClose()", "testcase": false, "constructor": false}, {"identifier": "setIgnoreClose", "parameters": "(boolean ignoreClose)", "modifiers": "public", "return": "void", "signature": "void setIgnoreClose(boolean ignoreClose)", "full_signature": "public void setIgnoreClose(boolean ignoreClose)", "class_method_signature": "JmsPoolSession.setIgnoreClose(boolean ignoreClose)", "testcase": false, "constructor": false}, {"identifier": "toString", "parameters": "()", "modifiers": "@Override public", "return": "String", "signature": "String toString()", "full_signature": "@Override public String toString()", "class_method_signature": "JmsPoolSession.toString()", "testcase": false, "constructor": false}, {"identifier": "onConsumerClose", "parameters": "(MessageConsumer consumer)", "modifiers": "protected", "return": "void", "signature": "void onConsumerClose(MessageConsumer consumer)", "full_signature": "protected void onConsumerClose(MessageConsumer consumer)", "class_method_signature": "JmsPoolSession.onConsumerClose(MessageConsumer consumer)", "testcase": false, "constructor": false}, {"identifier": "onQueueBrowserClose", "parameters": "(QueueBrowser browser)", "modifiers": "protected", "return": "void", "signature": "void onQueueBrowserClose(QueueBrowser browser)", "full_signature": "protected void onQueueBrowserClose(QueueBrowser browser)", "class_method_signature": "JmsPoolSession.onQueueBrowserClose(QueueBrowser browser)", "testcase": false, "constructor": false}, {"identifier": "onMessageProducerClosed", "parameters": "(JmsPoolMessageProducer producer, boolean force)", "modifiers": "protected", "return": "void", "signature": "void onMessageProducerClosed(JmsPoolMessageProducer producer, boolean force)", "full_signature": "protected void onMessageProducerClosed(JmsPoolMessageProducer producer, boolean force)", "class_method_signature": "JmsPoolSession.onMessageProducerClosed(JmsPoolMessageProducer producer, boolean force)", "testcase": false, "constructor": false}, {"identifier": "checkClientJMSVersionSupport", "parameters": "(int major, int minor)", "modifiers": "protected", "return": "void", "signature": "void checkClientJMSVersionSupport(int major, int minor)", "full_signature": "protected void checkClientJMSVersionSupport(int major, int minor)", "class_method_signature": "JmsPoolSession.checkClientJMSVersionSupport(int major, int minor)", "testcase": false, "constructor": false}, {"identifier": "isJMSVersionSupported", "parameters": "(int major, int minor)", "modifiers": "protected", "return": "boolean", "signature": "boolean isJMSVersionSupported(int major, int minor)", "full_signature": "protected boolean isJMSVersionSupported(int major, int minor)", "class_method_signature": "JmsPoolSession.isJMSVersionSupported(int major, int minor)", "testcase": false, "constructor": false}, {"identifier": "checkClosed", "parameters": "()", "modifiers": "private", "return": "void", "signature": "void checkClosed()", "full_signature": "private void checkClosed()", "class_method_signature": "JmsPoolSession.checkClosed()", "testcase": false, "constructor": false}, {"identifier": "addQueueBrowser", "parameters": "(QueueBrowser browser)", "modifiers": "private", "return": "QueueBrowser", "signature": "QueueBrowser addQueueBrowser(QueueBrowser browser)", "full_signature": "private QueueBrowser addQueueBrowser(QueueBrowser browser)", "class_method_signature": "JmsPoolSession.addQueueBrowser(QueueBrowser browser)", "testcase": false, "constructor": false}, {"identifier": "addConsumer", "parameters": "(MessageConsumer consumer)", "modifiers": "private", "return": "MessageConsumer", "signature": "MessageConsumer addConsumer(MessageConsumer consumer)", "full_signature": "private MessageConsumer addConsumer(MessageConsumer consumer)", "class_method_signature": "JmsPoolSession.addConsumer(MessageConsumer consumer)", "testcase": false, "constructor": false}, {"identifier": "addTopicSubscriber", "parameters": "(TopicSubscriber subscriber)", "modifiers": "private", "return": "TopicSubscriber", "signature": "TopicSubscriber addTopicSubscriber(TopicSubscriber subscriber)", "full_signature": "private TopicSubscriber addTopicSubscriber(TopicSubscriber subscriber)", "class_method_signature": "JmsPoolSession.addTopicSubscriber(TopicSubscriber subscriber)", "testcase": false, "constructor": false}, {"identifier": "addQueueReceiver", "parameters": "(QueueReceiver receiver)", "modifiers": "private", "return": "QueueReceiver", "signature": "QueueReceiver addQueueReceiver(QueueReceiver receiver)", "full_signature": "private QueueReceiver addQueueReceiver(QueueReceiver receiver)", "class_method_signature": "JmsPoolSession.addQueueReceiver(QueueReceiver receiver)", "testcase": false, "constructor": false}, {"identifier": "safeGetSessionHolder", "parameters": "()", "modifiers": "private", "return": "PooledSessionHolder", "signature": "PooledSessionHolder safeGetSessionHolder()", "full_signature": "private PooledSessionHolder safeGetSessionHolder()", "class_method_signature": "JmsPoolSession.safeGetSessionHolder()", "testcase": false, "constructor": false}], "file": "pooled-jms/src/main/java/org/messaginghub/pooled/jms/JmsPoolSession.java"}, "focal_method": {"identifier": "close", "parameters": "()", "modifiers": "@Override public", "return": "void", "body": "@Override\n    public void close() throws JMSException {\n        if (ignoreClose) {\n            return;\n        }\n\n        if (closed.compareAndSet(false, true)) {\n            boolean invalidate = false;\n            try {\n                // lets reset the session\n                getInternalSession().setMessageListener(null);\n\n                // Close any consumers, producers and browsers that may have been created.\n                for (MessageConsumer consumer : consumers) {\n                    consumer.close();\n                }\n\n                for (QueueBrowser browser : browsers) {\n                    browser.close();\n                }\n\n                for (MessageProducer producer : producers) {\n                    producer.close();\n                }\n\n                consumers.clear();\n                producers.clear();\n                browsers.clear();\n\n                if (transactional && !isXa) {\n                    try {\n                        getInternalSession().rollback();\n                    } catch (JMSException e) {\n                        invalidate = true;\n                        LOG.warn(\"Caught exception trying rollback() when putting session back into the pool, will invalidate. \" + e, e);\n                    }\n                }\n            } catch (JMSException ex) {\n                invalidate = true;\n                LOG.warn(\"Caught exception trying close() when putting session back into the pool, will invalidate. \" + ex, ex);\n            } finally {\n                consumers.clear();\n                browsers.clear();\n                for (JmsPoolSessionEventListener listener : this.sessionEventListeners) {\n                    listener.onSessionClosed(this);\n                }\n                sessionEventListeners.clear();\n            }\n\n            if (invalidate) {\n                // lets close the session and not put the session back into the pool\n                // instead invalidate it so the pool can create a new one on demand.\n                if (sessionHolder != null) {\n                    try {\n                        sessionHolder.close();\n                    } catch (JMSException e1) {\n                        LOG.trace(\"Ignoring exception on close as discarding session: \" + e1, e1);\n                    }\n                }\n\n                try {\n                    sessionPool.invalidateObject(key, sessionHolder);\n                } catch (Exception e) {\n                    LOG.trace(\"Ignoring exception on invalidateObject as discarding session: \" + e, e);\n                }\n            } else {\n                try {\n                    sessionPool.returnObject(key, sessionHolder);\n                } catch (Exception e) {\n                    javax.jms.IllegalStateException illegalStateException = new javax.jms.IllegalStateException(e.toString());\n                    illegalStateException.initCause(e);\n                    throw illegalStateException;\n                }\n            }\n\n            sessionHolder = null;\n        }\n    }", "signature": "void close()", "full_signature": "@Override public void close()", "class_method_signature": "JmsPoolSession.close()", "testcase": false, "constructor": false, "invocations": ["compareAndSet", "setMessageListener", "getInternalSession", "close", "close", "close", "clear", "clear", "clear", "rollback", "getInternalSession", "warn", "warn", "clear", "clear", "onSessionClosed", "clear", "close", "trace", "invalidateObject", "trace", "returnObject", "toString", "initCause"]}, "repository": {"repo_id": 106015269, "url": "https://github.com/messaginghub/pooled-jms", "language": "Java", "is_fork": false, "fork_count": 9, "stargazer_count": 22, "size": 375, "license": "licensed"}}