{"test_class": {"identifier": "TemplatePluginTest", "superclass": "", "interfaces": "", "fields": [{"original_string": "private final PluginTester<TemplatePlugin> tester = new PluginTester<>(TemplatePlugin::new);", "modifier": "private final", "type": "PluginTester<TemplatePlugin>", "declarator": "tester = new PluginTester<>(TemplatePlugin::new)", "var_name": "tester"}], "file": "lazybot-plugin-template/src/test/java/org/royjacobs/lazybot/plugin/template/TemplatePluginTest.java"}, "test_case": {"identifier": "canTemplateMessage", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void canTemplateMessage() {\n        tester.getPublicVariables().onNext(new PublicVariables(ImmutableMap.of(\"foo.oof\", \"bar\")));\n        tester.test(plugin -> plugin.onCommand(Command.of(\"/bot template topic hello ${foo.oof} rocks\")));\n        assertThat(tester.getRoomApi().getLastTopic(), is(\"hello bar rocks\"));\n\n        tester.getPublicVariables().onNext(new PublicVariables(ImmutableMap.of(\"foo.oof\", \"boop\")));\n        tester.test(plugin -> plugin.onCommand(Command.of(\"/bot template topic hello ${foo.oof} really rocks\")));\n        assertThat(tester.getRoomApi().getLastTopic(), is(\"hello boop really rocks\"));\n    }", "signature": "void canTemplateMessage()", "full_signature": "@Test public void canTemplateMessage()", "class_method_signature": "TemplatePluginTest.canTemplateMessage()", "testcase": true, "constructor": false, "invocations": ["onNext", "getPublicVariables", "of", "test", "onCommand", "of", "assertThat", "getLastTopic", "getRoomApi", "is", "onNext", "getPublicVariables", "of", "test", "onCommand", "of", "assertThat", "getLastTopic", "getRoomApi", "is"]}, "focal_class": {"identifier": "TemplatePlugin", "superclass": "", "interfaces": "implements Plugin", "fields": [{"original_string": "private PluginContext context;", "modifier": "private", "type": "PluginContext", "declarator": "context", "var_name": "context"},