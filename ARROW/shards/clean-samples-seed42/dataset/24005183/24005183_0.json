"}, "focal_method": {"identifier": "arrayToJson", "parameters": "(String[] array)", "modifiers": "public static", "return": "String", "body": "public static String arrayToJson(String[] array) {\n\n        if (null == array) {return EMPTY_JSON_ARRAY;}\n\n        StringWriter stringWriter = new StringWriter();\n        JSONWriter jsonWriter = new JSONWriter(stringWriter);\n\n        try {\n            jsonWriter.array();\n            for (String item: array) {\n                jsonWriter.value(item);\n            }\n            jsonWriter.endArray();\n\n        } catch (JSONException e) {\n            LOG.error(\"Can't convert array '{}' to JSON\", array, e);\n            return EMPTY_JSON_ARRAY;\n        }\n\n        return stringWriter.toString();\n    }", "signature": "String arrayToJson(String[] array)", "full_signature": "public static String arrayToJson(String[] array)", "class_method_signature": "StringUtil.arrayToJson(String[] array)", "testcase": false, "constructor": false, "invocations": ["array", "value", "endArray", "error", "toString"]}, "repository": {"repo_id": 24005183, "url": "https://github.com/headwirecom/aem-solr-search", "language": "Java", "is_fork": false, "fork_count": 42, "stargazer_count": 42, "size": 897, "license": "licensed"}}