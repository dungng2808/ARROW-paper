\t}\n\n\t\t// check if any example was labeled as positive and negative\n\t\tHashSet<String> allExamples = new HashSet<>();\n\t\tallExamples.addAll(canonicalPositiveExamples);\n\t\tallExamples.addAll(canonicalNegativeExamples);\n\n\t\tif (allExamples.size() != (canonicalPositiveExamples.size() + canonicalNegativeExamples.size())) {\n\t\t\tlogger.warn(\"The gold standard contains an example that is both labelled as positive and negative!\");\n\t\t}\n\n\t}", "signature": "void printGSReport()", "full_signature": "public void printGSReport()", "class_method_signature": "MatchingGoldStandard.printGSReport()", "testcase": false, "constructor": false, "invocations": ["size", "getPositiveExamples", "size", "getNegativeExamples", "info", "format", "info", "format", "info", "format", "size", "getPositiveExamples", "size", "warn", "size", "getNegativeExamples", "size", "warn", "addAll", "addAll", "size", "size", "size", "warn"]}, "repository": {"repo_id": 88765628, "url": "https://github.com/olehmberg/winter", "language": "Java", "is_fork": false, "fork_count": 25, "stargazer_count": 73, "size": 19141, "license": "licensed"}}