internal resource: jira-dbconfig-template.xml\");\n        }\n\n        try\n        {\n            String template = IOUtils.toString(templateIn, \"utf-8\");\n\n            File dbFile = getHsqlDatabaseFile(homeDir);\n            String jdbcUrl = \"jdbc:hsqldb:file:\" + dbFile.toURI().getPath();\n            String result = template.replace(\"@jdbc-url@\", jdbcUrl);\n            FileUtils.writeStringToFile(dbConfigXml, result, \"utf-8\");\n        }\n        catch (IOException ioe)\n        {\n            throw new MojoExecutionException(\"Unable to create dbconfig.xml\", ioe);\n        }\n    }", "signature": "void createDbConfigXmlIfNecessary(File homeDir)", "full_signature": "static void createDbConfigXmlIfNecessary(File homeDir)", "class_method_signature": "JiraProductHandler.createDbConfigXmlIfNecessary(File homeDir)", "testcase": false, "constructor": false, "invocations": ["exists", "getResourceAsStream", "toString", "getHsqlDatabaseFile", "getPath", "toURI", "replace", "writeStringToFile"]}, "repository": {"repo_id": 860694, "url": "https://github.com/mrdon/AMPS", "language": "Java", "is_fork": false, "fork_count": 5, "stargazer_count": 5, "size": 3147, "license": "licensed"}}