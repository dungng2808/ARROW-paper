{"test_class": {"identifier": "DeweyVersionTest", "superclass": "", "interfaces": "", "fields": [], "file": "applications/kafkastreams-cep/src/test/java/com/github/fhuss/kafka/streams/cep/nfa/DeweyVersionTest.java"}, "test_case": {"identifier": "testPredecessor", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void testPredecessor() {\n        assertFalse(new DeweyVersion(\"1.0\").isCompatible(new DeweyVersion(\"2.0\")));\n        assertTrue(new DeweyVersion(\"1.0.0\").isCompatible(new DeweyVersion(\"1.0\")));\n        assertTrue(new DeweyVersion(\"1.1\").isCompatible(new DeweyVersion(\"1.0\")));\n        assertFalse(new DeweyVersion(\"1.0\").isCompatible(new DeweyVersion(\"1.1\")));\n    }", "signature": "void testPredecessor()", "full_signature": "@Test public void testPredecessor()", "class_method_signature": "DeweyVersionTest.testPredecessor()", "testcase": true, "constructor": false, "invocations": ["assertFalse", "isCompatible", "assertTrue", "isCompatible", "assertTrue", "isCompatible", "assertFalse", "isCompatible"]}, "focal_class": {"identifier": "DeweyVersion", "superclass": "", "interfaces": "", "fields": [{"original_string": "private int[] versions;", "modifier": "private", "type": "int[]", "declarator": "versions", "var_name": "versions"}], "methods": [{"identifier": "DeweyVersion", "parameters": "()", "modifiers": "public", "return": "", "signature": " DeweyVersion()", "full_signature": "public  DeweyVersion()", "class_method_signature": "DeweyVersion.DeweyVersion()", "testcase": false, "constructor": true}, {"identifier": "DeweyVersion", "parameters": "(int run)", "modifiers": "public", "return": "", "signature": " DeweyVersion(int run)", "full_signature": "public  DeweyVersion(int run)", "class_method_signature": "DeweyVersion.DeweyVersion(int run)", "testcase": false, "constructor": true}, {"identifier": "DeweyVersion", "parameters": "(String s)", "modifiers": "public", "return": "", "signature": " Dewey