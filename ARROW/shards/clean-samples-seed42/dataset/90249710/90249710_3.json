lse {\n                    double[] s = {Double.valueOf(i), Double.valueOf(df.format(Double.valueOf(splits[1]) / 1000))};\n                    double[] s1 = {Double.valueOf(i), Double.valueOf(df.format(Double.valueOf(splits[2]) / 1000))};\n                    li1.add(s);\n                    li2.add(s1);\n                }\n                i++;\n            }\n            Statistic s1, s2;\n            s1 = new Statistic(\"Current\", li1);\n            list.add(s1);\n            if (li2.size() > 0) {\n                s2 = new Statistic(\"Optimized\", li2);\n                list.add(s2);\n            } else {\n\n            }\n        } catch (IOException e) {\n            e.printStackTrace();\n        }\n        return JSON.toJSONString(list);\n    }", "signature": "String getStatistic(String arg)", "full_signature": "public String getStatistic(String arg)", "class_method_signature": "RwMain.getStatistic(String arg)", "testcase": false, "constructor": false, "invocations": ["getProperty", "Instance", "equals", "exists", "getReader", "Instance", "readLine", "readLine", "split", "valueOf", "valueOf", "add", "valueOf", "valueOf", "format", "valueOf", "valueOf", "valueOf", "format", "valueOf", "add", "add", "add", "size", "add", "printStackTrace", "toJSONString"]}, "repository": {"repo_id": 90249710, "url": "https://github.com/dbiir/rainbow", "language": "Java", "is_fork": false, "fork_count": 40, "stargazer_count": 61, "size": 68337, "license": "licensed"}}