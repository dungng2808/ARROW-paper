rs": "public static", "return": "double", "body": "public static double calculationByDistance(LatLng StartP, LatLng EndP) {\n        double lat1 = StartP.latitude;\n        double lat2 = EndP.latitude;\n        double lon1 = StartP.longitude;\n        double lon2 = EndP.longitude;\n\n        if (lat1 == lat2 && lon1 == lon2) {\n            return .0;\n        }\n\n        double dLat = Math.toRadians(lat2 - lat1);\n        double dLon = Math.toRadians(lon2 - lon1);\n        double a = Math.sin(dLat / 2) * Math.sin(dLat / 2)\n                + Math.cos(Math.toRadians(lat1))\n                * Math.cos(Math.toRadians(lat2)) * Math.sin(dLon / 2)\n                * Math.sin(dLon / 2);\n        double c = 2 * Math.asin(Math.sqrt(a));\n        return RADIUS * c;\n    }", "signature": "double calculationByDistance(LatLng StartP, LatLng EndP)", "full_signature": "public static double calculationByDistance(LatLng StartP, LatLng EndP)", "class_method_signature": "H.calculationByDistance(LatLng StartP, LatLng EndP)", "testcase": false, "constructor": false, "invocations": ["toRadians", "toRadians", "sin", "sin", "cos", "toRadians", "cos", "toRadians", "sin", "sin", "asin", "sqrt"]}, "repository": {"repo_id": 52151431, "url": "https://github.com/MarcProe/lp2go", "language": "Java", "is_fork": false, "fork_count": 5, "stargazer_count": 5, "size": 543509, "license": "licensed"}}