s": "(String name)", "modifiers": "public static", "return": "String", "signature": "String groupName(String name)", "full_signature": "public static String groupName(String name)", "class_method_signature": "StringUtils.groupName(String name)", "testcase": false, "constructor": false}], "file": "rqueue-core/src/main/java/com/github/sonus21/rqueue/utils/StringUtils.java"}, "focal_method": {"identifier": "convertToCamelCase", "parameters": "(String string)", "modifiers": "public static", "return": "String", "body": "public static String convertToCamelCase(String string) {\n    String txt = clean(string);\n    if (isEmpty(txt)) {\n      throw new IllegalArgumentException(\"string is empty\");\n    }\n    StringBuilder sb = new StringBuilder();\n    for (int i = 0; i < txt.length(); i++) {\n      char c = txt.charAt(i);\n      if (isAlpha(c)) {\n        if (i == 0) {\n          sb.append(c);\n        } else if (!isAlpha(txt.charAt(i - 1))) {\n          sb.append(Character.toUpperCase(c));\n        } else if (Character.isLowerCase(c)\n            || (Character.isUpperCase(c) && Character.isLowerCase(txt.charAt(i - 1)))) {\n          sb.append(c);\n        } else {\n          sb.append(Character.toLowerCase(c));\n        }\n      }\n    }\n    String convertedTxt = sb.toString();\n    if (convertedTxt.isEmpty()) {\n      return txt;\n    }\n    return Introspector.decapitalize(convertedTxt);\n  }", "signature": "String convertToCamelCase(String string)", "full_signature": "public static String convertToCamelCase(String string)", "class_method_signature": "StringUtils.convertToCamelCase(String string)", "testcase": false, "constructor": false, "invocations": ["clean", "isEmpty", "length", "charAt", "isAlpha", "append", "isAlpha", "charAt", "append", "toUpperCase", "isLowerCase", "isUpperCase", "isLowerCase", "charAt", "append", "append", "toLowerCase", "toString", "isEmpty", "decapitalize"]}, "repository": {"repo_id": 216000802, "url": "https://github.com/sonus21/rqueue",