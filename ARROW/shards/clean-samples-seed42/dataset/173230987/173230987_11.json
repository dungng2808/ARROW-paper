ceivedRequestUri)", "full_signature": "public String calculateDownstreamPath(final String receivedRequestUri)", "class_method_signature": "DownstreamPathCalculator.calculateDownstreamPath(final String receivedRequestUri)", "testcase": false, "constructor": false}], "file": "ethsigner/core/src/main/java/tech/pegasys/ethsigner/core/requesthandler/sendtransaction/DownstreamPathCalculator.java"}, "focal_method": {"identifier": "calculateDownstreamPath", "parameters": "(final String receivedRequestUri)", "modifiers": "public", "return": "String", "body": "public String calculateDownstreamPath(final String receivedRequestUri) {\n    // This function is required to join httpDownStreamPathPrefix with receivedRequestURI\n    // remove any duplicate \"/\"\n    // Not have an ending \"/\" if the path\n    // assumes httpdownstreamPathPrefix does not include =,?,&\n    // has a leading \"/\" as required by vertx\n    String result = \"/\" + httpDownstreamPathPrefix + \"/\" + receivedRequestUri;\n    result = result.replaceAll(\"/+\", \"/\");\n    return result.length() == 1 ? result : result.replaceAll(\"/$\", \"\");\n  }", "signature": "String calculateDownstreamPath(final String receivedRequestUri)", "full_signature": "public String calculateDownstreamPath(final String receivedRequestUri)", "class_method_signature": "DownstreamPathCalculator.calculateDownstreamPath(final String receivedRequestUri)", "testcase": false, "constructor": false, "invocations": ["replaceAll", "length", "replaceAll"]}, "repository": {"repo_id": 173230987, "url": "https://github.com/PegaSysEng/ethsigner", "stars": 19, "created": "3/1/2019 3:48:55 AM +00:00", "updates": "2020-01-22T22:14:12+00:00", "fork": "False", "license": "licensed"}}