Section : variableSections) {\n\t\t\t\tVariable variable = parseVariable(codebook, variableSection);\n\t\t\t\tcodebook.getVariables().add(variable);\n\t\t\t}\n\n\t\t\treturn codebook;\n\t\t} catch (IOException e) {\n\t\t\tthrow new UncheckedIOException(e);\n\t\t}\n\t}", "signature": "Codebook parseCodebookPdf(SupportedCodebook codebookSource)", "full_signature": "public static Codebook parseCodebookPdf(SupportedCodebook codebookSource)", "class_method_signature": "PdfParser.parseCodebookPdf(SupportedCodebook codebookSource)", "testcase": false, "constructor": false, "invocations": ["getCodebookPdfInputStream", "extractTextLinesFromPdf", "findVariableSections", "parseVariable", "add", "getVariables"]}, "repository": {"repo_id": 94459145, "url": "https://github.com/CMSgov/bluebutton-data-model", "language": "Java", "is_fork": false, "fork_count": 5, "stargazer_count": 5, "size": 9536, "license": "licensed"}}