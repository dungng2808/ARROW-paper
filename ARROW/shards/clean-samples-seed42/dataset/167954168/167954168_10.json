Type)", "class_method_signature": "IotivityRepository.findResource(String host, String resourceType)", "testcase": false, "constructor": false}, {"identifier": "get", "parameters": "(String host, String uri, String deviceId)", "modifiers": "public", "return": "Single<OCRepresentation>", "signature": "Single<OCRepresentation> get(String host, String uri, String deviceId)", "full_signature": "public Single<OCRepresentation> get(String host, String uri, String deviceId)", "class_method_signature": "IotivityRepository.get(String host, String uri, String deviceId)", "testcase": false, "constructor": false}, {"identifier": "post", "parameters": "(String host, String uri, String deviceId, OCRepresentation rep, Object valueArray)", "modifiers": "public", "return": "Completable", "signature": "Completable post(String host, String uri, String deviceId, OCRepresentation rep, Object valueArray)", "full_signature": "public Completable post(String host, String uri, String deviceId, OCRepresentation rep, Object valueArray)", "class_method_signature": "IotivityRepository.post(String host, String uri, String deviceId, OCRepresentation rep, Object valueArray)", "testcase": false, "constructor": false}, {"identifier": "post", "parameters": "(String host, String uri, String deviceId, Map<String, Object> values)", "modifiers": "public", "return": "Completable", "signature": "Completable post(String host, String uri, String deviceId, Map<String, Object> values)", "full_signature": "public Completable post(String host, String uri, String deviceId, Map<String, Object> values)", "class_method_signature": "IotivityRepository.post(String host, String uri, String deviceId, Map<String, Object> values)", "testcase": false, "constructor": false}, {"identifier": "parseOCRepresentionToCbor", "parameters": "(CborEncoder parent, OCRepresentation rep, Object valueArray)", "modifiers": "private", "return": "void", "signature": "void parseOCRepresentionToCbor(CborEncoder parent, OCRepresentation rep, Object valueArray)", "full_signature": "private void parseOCRepresentionToCbor(CborEncoder parent, OCRepresentation rep, Object valueArray)", "class_method_signature": "IotivityRepository.parseOCRepresentionToCbor(CborEncoder parent, OCRepresentation rep, Object valueArray)", "testcase": false, "constructor": false}, {"identifier": "parseOCRepresentionToCbor", "parameters": "(CborEncoder parent, Map<String, Object> values)", "modifiers": "private", "return": "void", "signature": "void parseOCRepresentionToCbor(CborEncoder parent, Map<String, Object> values)", "full_signature": "private void parseOCRepresentionToCbor(CborEncoder parent, Map<String, Object> values)", "class_method_signature": "IotivityRepository.parseOCRepresentionToCbor(CborEncoder parent, Map<String, Object> values)", "testcase": false, "constructor": false}, {"identifier": "close", "parameters": "()", "modifiers": "public", "return": "void", "signature": "void close()", "full_signature": "public void close()", "class_method_signature": "IotivityRepository.close()", "testcase": false, "constructor": false}], "file": "otgc/src/main/java/org/openconnectivity/otgc/data/repository/IotivityRepository.java"}, "focal_method": {"identifier": "scanHosts", "parameters": "()", "modifiers": "public", "return": "Completable", "body": "public Completable scanHosts() {\n        return Completable.create(emitter -> {\n            // Clear all devices list for devices owned by other\n            allDevices.clear();\n\n            OCResponseHandler handler = (OCClientResponse response) -> {\n                OCStatus code = response.getCode();\n                if (code == OCStatus.OC_STATUS_OK) {\n                    OcRes res = new OcRes();\n                    res.parseOCRepresentation(response.getPayload());\n\n                    if (!res.getResourceList().isEmpty()) {\n                        OcResource resource = res.getResourceList().get(0);\n                        String deviceId = resource.getAnchor().replace(\"ocf://\", \"\");\n                        List<String> endpoints = new ArrayList<>();\n                        for (OcEndpoint ep : resource.getEndpoints()) {\n                            endpoints.add(ep.getEndpoint());\n                        }\n\n                        DeviceEntity device = deviceDao.findById(deviceId).blockingGet();\n                        if (device == null) {\n                            deviceDao.insert(new DeviceEntity(deviceId, \"\", endpoints, DeviceType.OWNED_BY_OTHER, Device.NOTHING_PERMITS));\n                            allDevices.add(new Device(DeviceType.OWNED_BY_OTHER, deviceId, new OcDeviceInfo(), endpoints, Device.NOTHING_PERMITS));\n                        } else {\n                            boolean isUnowned = false;\n                            for (Device d : unownedDevices) {\n                                if (d.getDeviceId().equals(deviceId)) {\n                                    isUnowned = true;\n                                    break;\n                                }\n                            }\n\n                            boolean isOwned = false;\n                            for (Device d : ownedDevices) {\n                                if (d.getDeviceId().equals(deviceId)) {\n                                    isOwned = true;\n                                    break;\n                                }\n                            }\n\n                            if (!isUnowned && !isOwned) {\n                                DeviceType type = device.getType() == DeviceType.UNOWNED || device.getType() == DeviceType.OWNED_BY_SELF\n                                        ? DeviceType.OWNED_BY_OTHER\n                                        : device.getType();\n\n                                deviceDao.insert(new DeviceEntity(deviceId, device.getName(), endpoints, type, device.getPermits()));\n                                allDevices.add(new Device(type, deviceId, new OcDeviceInfo(), endpoints, device.getPermits()));\n                            }\n                        }\n                    }\n                }\n            };\n\n            String scope = preferencesRepository.getDiscoveryScope();\n            if (scope.equals(DiscoveryScope.DISCOVERY_SCOPE_REALM)) {\n                if (!OCMain.doRealmLocalIPv6Multicast(OcfResourceUri.RES_URI, null, handler)) {\n                    emitter.onError(new Exception(\"Error scanning hosts\"));\n                }\n            } else if (scope.equals(DiscoveryScope.DISCOVERY_SCOPE_SITE)) {\n                if (!OCMain.doSiteLocalIPv6Multicast(OcfResourceUri.RES_URI, null, handler)) {\n                    emitter.onError(new Exception(\"Error scanning hosts\"));\n                }\n            } else {\n                if (!OCMain.doIPMulticast(OcfResourceUri.RES_URI, null, handler)) {\n                    emitter.onError(new Exception(\"Error scanning hosts\"));\n                }\n            }\n\n        }).timeout(getDiscoveryTimeout(), TimeUnit.SECONDS)\n                .onErrorComplete();\n    }", "signature": "Completable scanHosts()", "full_signature": "public Completable scanHosts()", "class_method_signature": "IotivityRepository.scanHosts()", "testcase": false, "constructor": false, "invocations": ["onErrorComplete", "timeout", "create", "clear", "getCode", "parseOCRepresentation", "getPayload", "isEmpty", "getResourceList", "get", "getResourceList", "replace", "getAnchor", "getEndpoints", "add", "getEndpoint", "blockingGet", "findById", "insert", "add", "equals", "getDeviceId", "equals", "getDeviceId", "getType", "getType", "getType", "insert", "getName", "getPermits", "add", "getPermits", "getDiscoveryScope", "equals", "doRealmLocalIPv6Multicast", "onError", "equals", "doSiteLocalIPv6Multicast", "onError", "doIPMulticast", "onError", "getDiscoveryTimeout"]}, "repository": {"repo_id": 167954168, "url": "https://github.com/openconnectivity/otgc-android", "language": "Java", "is_fork": false, "fork_count": 5, "stargazer_count": 5, "size": 4084, "license": "licensed"}}