e(MatchDescriptorResponse response)", "full_signature": "private void handleMatchDescriptorResponse(MatchDescriptorResponse response)", "class_method_signature": "SmartEnergyClient.handleMatchDescriptorResponse(MatchDescriptorResponse response)", "testcase": false, "constructor": false}, {"identifier": "keyEstablishmentCallback", "parameters": "(ZigBeeStatus returnState, Integer waitTime)", "modifiers": "protected", "return": "void", "signature": "void keyEstablishmentCallback(ZigBeeStatus returnState, Integer waitTime)", "full_signature": "protected void keyEstablishmentCallback(ZigBeeStatus returnState, Integer waitTime)", "class_method_signature": "SmartEnergyClient.keyEstablishmentCallback(ZigBeeStatus returnState, Integer waitTime)", "testcase": false, "constructor": false}, {"identifier": "commandReceived", "parameters": "(ZigBeeCommand command)", "modifiers": "@Override public", "return": "void", "signature": "void commandReceived(ZigBeeCommand command)", "full_signature": "@Override public void commandReceived(ZigBeeCommand command)", "class_method_signature": "SmartEnergyClient.commandReceived(ZigBeeCommand command)", "testcase": false, "constructor": false}, {"identifier": "networkStateUpdated", "parameters": "(ZigBeeNetworkState state)", "modifiers": "@Override public", "return": "void", "signature": "void networkStateUpdated(ZigBeeNetworkState state)", "full_signature": "@Override public void networkStateUpdated(ZigBeeNetworkState state)", "class_method_signature": "SmartEnergyClient.networkStateUpdated(ZigBeeNetworkState state)", "testcase": false, "constructor": false}, {"identifier": "getDiscoveryState", "parameters": "()", "modifiers": "public", "return": "SmartEnergyClientState", "signature": "SmartEnergyClientState getDiscoveryState()", "full_signature": "public SmartEnergyClientState getDiscoveryState()", "class_method_signature": "SmartEnergyClient.getDiscoveryState()", "testcase": false, "constructor": false}, {"identifier": "requestIeeeAddress", "parameters": "(final int networkAddress)", "modifiers": "private", "return": "IeeeAddress", "signature": "IeeeAddress requestIeeeAddress(final int networkAddress)", "full_signature": "private IeeeAddress requestIeeeAddress(final int networkAddress)", "class_method_signature": "SmartEnergyClient.requestIeeeAddress(final int networkAddress)", "testcase": false, "constructor": false}, {"identifier": "setProfileSecurity", "parameters": "(ZigBeeNode node)", "modifiers": "private", "return": "void", "signature": "void setProfileSecurity(ZigBeeNode node)", "full_signature": "private void setProfileSecurity(ZigBeeNode node)", "class_method_signature": "SmartEnergyClient.setProfileSecurity(ZigBeeNode node)", "testcase": false, "constructor": false}, {"identifier": "keepalivePoll", "parameters": "()", "modifiers": "private", "return": "void", "signature": "void keepalivePoll()", "full_signature": "private void keepalivePoll()", "class_method_signature": "SmartEnergyClient.keepalivePoll()", "testcase": false, "constructor": false}, {"identifier": "nodeAdded", "parameters": "(ZigBeeNode node)", "modifiers": "@Override public", "return": "void", "signature": "void nodeAdded(ZigBeeNode node)", "full_signature": "@Override public void nodeAdded(ZigBeeNode node)", "class_method_signature": "SmartEnergyClient.nodeAdded(ZigBeeNode node)", "testcase": false, "constructor": false}, {"identifier": "nodeUpdated", "parameters": "(ZigBeeNode node)", "modifiers": "@Override public", "return": "void", "signature": "void nodeUpdated(ZigBeeNode node)", "full_signature": "@Override public void nodeUpdated(ZigBeeNode node)", "class_method_signature": "SmartEnergyClient.nodeUpdated(ZigBeeNode node)", "testcase": false, "constructor": false}], "file": "com.zsmartsystems.zigbee/src/main/java/com/zsmartsystems/zigbee/app/seclient/SmartEnergyClient.java"}, "focal_method": {"identifier": "keyEstablishmentCallback", "parameters": "(ZigBeeStatus returnState, Integer waitTime)", "modifiers": "protected", "return": "void", "body": "protected void keyEstablishmentCallback(ZigBeeStatus returnState, Integer waitTime) {\n        logger.debug(\"SEP Extension: keyEstablishmentCallback state={}\", returnState);\n\n        if (returnState == ZigBeeStatus.FATAL_ERROR) {\n            updateClientState(SmartEnergyClientState.FATAL);\n            return;\n        } else {\n            updateClientState(returnState == ZigBeeStatus.SUCCESS ? SmartEnergyClientState.DISCOVER_METERING_SERVERS\n                    : SmartEnergyClientState.PERFORM_KEY_ESTABLISHMENT);\n        }\n\n        int time = TIMER_IMMEDIATE;\n        if (returnState == ZigBeeStatus.FAILURE) {\n            if (waitTime == 0) {\n                time = TIMER_RESTART_KEY_ESTABLISHMENT;\n            } else {\n                time = (waitTime * 1000);\n            }\n            logger.debug(\"SEP Extension: keyEstablishmentCallback next timer {}ms\", time);\n            timerStart(time);\n        } else {\n            setProfileSecurity(networkManager.getNode(0));\n        }\n    }", "signature": "void keyEstablishmentCallback(ZigBeeStatus returnState, Integer waitTime)", "full_signature": "protected void keyEstablishmentCallback(ZigBeeStatus returnState, Integer waitTime)", "class_method_signature": "SmartEnergyClient.keyEstablishmentCallback(ZigBeeStatus returnState, Integer waitTime)", "testcase": false, "constructor": false, "invocations": ["debug", "updateClientState", "updateClientState", "debug", "timerStart", "setProfileSecurity", "getNode"]}, "repository": {"repo_id": 80043676, "url": "https://github.com/zsmartsystems/com.zsmartsystems.zigbee", "stars": 74, "created": "1/25/2017 6:26:54 PM +00:00", "updates": "2020-01-27T17:21:14+00:00", "fork": "False", "license": "licensed"}}