  result = innerAccessor.getByte( rowOffset );\n        break;\n      case SMALLINT:\n        result = innerAccessor.getShort( rowOffset );\n        break;\n      case BIGINT:\n        result = getIntValueOrThrow( innerAccessor.getLong( rowOffset ),\n                                     \"Java long / SQL BIGINT\" );\n        break;\n      case FLOAT4:\n        result = getIntValueOrThrow( innerAccessor.getFloat( rowOffset ),\n                                     \"Java float / SQL REAL/FLOAT\" );\n        break;\n      case FLOAT8:\n        result = getIntValueOrThrow( innerAccessor.getDouble( rowOffset ),\n                                     \"Java double / SQL DOUBLE PRECISION\" );\n        break;\n\n      // 3. Not-yet-converted and unconvertible types:\n      default:\n        result = innerAccessor.getInt( rowOffset );\n        break;\n    }\n    return result;\n  }", "signature": "int getInt( int rowOffset )", "full_signature": "@Override public int getInt( int rowOffset )", "class_method_signature": "TypeConvertingSqlAccessor.getInt( int rowOffset )", "testcase": false, "constructor": false, "invocations": ["getMinorType", "getType", "getInt", "getByte", "getShort", "getIntValueOrThrow", "getLong", "getIntValueOrThrow", "getFloat", "getIntValueOrThrow", "getDouble", "getInt"]}, "repository": {"repo_id": 89617755, "url": "https://github.com/skhalifa/QDrill", "language": "Java", "is_fork": false, "fork_count": 2, "stargazer_count": 5, "size": 8612, "license": "licensed"}}