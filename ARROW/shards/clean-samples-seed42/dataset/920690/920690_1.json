method": {"identifier": "hexStringToByteArray", "parameters": "(String s)", "modifiers": "public static", "return": "byte[]", "body": "public static byte[] hexStringToByteArray(String s) {\n        if ((s.length() % 2) != 0) {\n            s = \"0\" + s;\n        }\n        int len = s.length();\n        byte[] data = new byte[len / 2];\n        for (int i = 0; i < len; i += 2) {\n            data[i / 2] = (byte) ((Character.digit(s.charAt(i), 16) << 4)\n                    + Character.digit(s.charAt(i + 1), 16));\n        }\n        return data;\n    }", "signature": "byte[] hexStringToByteArray(String s)", "full_signature": "public static byte[] hexStringToByteArray(String s)", "class_method_signature": "Util.hexStringToByteArray(String s)", "testcase": false, "constructor": false, "invocations": ["length", "length", "digit", "charAt", "digit", "charAt"]}, "repository": {"repo_id": 920690, "url": "https://github.com/dschanoeh/Kayak", "language": "Java", "is_fork": false, "fork_count": 59, "stargazer_count": 240, "size": 2958, "license": "GNU Lesser General Public License v3.0"}}