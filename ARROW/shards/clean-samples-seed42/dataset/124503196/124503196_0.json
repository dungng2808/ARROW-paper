                     loginSuccess(loginResponse);\n                        } else {\n                            mView.showAutoLoginFail();\n                        }\n                        BaseResponse<List<BannerData>> bannerResponse = CommonUtils.cast(map.get(Constants.BANNER_DATA));\n                        if (bannerResponse != null) {\n                            mView.showBannerData(bannerResponse.getData());\n                        }\n                        BaseResponse<FeedArticleListData> feedArticleListResponse = CommonUtils.cast(map.get(Constants.ARTICLE_DATA));\n                        if (feedArticleListResponse != null) {\n                            mView.showArticleList(feedArticleListResponse.getData(), isRefresh);\n                        }\n                    }\n\n                    @Override\n                    public void onError(Throwable e) {\n                        super.onError(e);\n                        mView.showAutoLoginFail();\n                    }\n                }));\n    }", "signature": "void loadMainPagerData()", "full_signature": "@Override public void loadMainPagerData()", "class_method_signature": "MainPagerPresenter.loadMainPagerData()", "testcase": false, "constructor": false, "invocations": ["getLoginData", "getLoginAccount", "getLoginPassword", "getBannerData", "getFeedArticleList", "addSubscribe", "subscribeWith", "compose", "zip", "rxSchedulerHelper", "cast", "get", "getErrorCode", "loginSuccess", "showAutoLoginFail", "cast", "get", "showBannerData", "getData", "cast", "get", "showArticleList", "getData", "onError", "showAutoLoginFail"]}, "repository": {"repo_id": 124503196, "url": "https://github.com/JsonChao/Awesome-WanAndroid", "language": "Java", "is_fork": false, "fork_count": 514, "stargazer_count": 2196, "size": 207501, "license": "licensed"}}