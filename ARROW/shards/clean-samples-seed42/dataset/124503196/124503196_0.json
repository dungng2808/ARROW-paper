Article", "parameters": "(int position, FeedArticleData feedArticleData)", "modifiers": "@Override public", "return": "void", "signature": "void addCollectArticle(int position, FeedArticleData feedArticleData)", "full_signature": "@Override public void addCollectArticle(int position, FeedArticleData feedArticleData)", "class_method_signature": "MainPagerPresenter.addCollectArticle(int position, FeedArticleData feedArticleData)", "testcase": false, "constructor": false}, {"identifier": "cancelCollectArticle", "parameters": "(int position, FeedArticleData feedArticleData)", "modifiers": "@Override public", "return": "void", "signature": "void cancelCollectArticle(int position, FeedArticleData feedArticleData)", "full_signature": "@Override public void cancelCollectArticle(int position, FeedArticleData feedArticleData)", "class_method_signature": "MainPagerPresenter.cancelCollectArticle(int position, FeedArticleData feedArticleData)", "testcase": false, "constructor": false}, {"identifier": "loginSuccess", "parameters": "(BaseResponse<LoginData> loginResponse)", "modifiers": "private", "return": "void", "signature": "void loginSuccess(BaseResponse<LoginData> loginResponse)", "full_signature": "private void loginSuccess(BaseResponse<LoginData> loginResponse)", "class_method_signature": "MainPagerPresenter.loginSuccess(BaseResponse<LoginData> loginResponse)", "testcase": false, "constructor": false}, {"identifier": "createResponseMap", "parameters": "(BaseResponse<LoginData> loginResponse,\n                                                      BaseResponse<List<BannerData>> bannerResponse,\n                                                      BaseResponse<FeedArticleListData> feedArticleListResponse)", "modifiers": "@NonNull private", "return": "HashMap<String, Object>", "signature": "HashMap<String, Object> createResponseMap(BaseResponse<LoginData> loginResponse,\n                                                      BaseResponse<List<BannerData>> bannerResponse,\n    