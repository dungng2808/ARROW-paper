eCallUrl(Location location, String exclude)", "full_signature": " String getOneCallUrl(Location location, String exclude)", "class_method_signature": "OpenWeatherMapSource.getOneCallUrl(Location location, String exclude)", "testcase": false, "constructor": false}, {"identifier": "queryCurrentWeather", "parameters": "(Location location)", "modifiers": "", "return": "JSONObject", "signature": "JSONObject queryCurrentWeather(Location location)", "full_signature": " JSONObject queryCurrentWeather(Location location)", "class_method_signature": "OpenWeatherMapSource.queryCurrentWeather(Location location)", "testcase": false, "constructor": false}, {"identifier": "getWeatherUrl", "parameters": "(Location location)", "modifiers": "", "return": "String", "signature": "String getWeatherUrl(Location location)", "full_signature": " String getWeatherUrl(Location location)", "class_method_signature": "OpenWeatherMapSource.getWeatherUrl(Location location)", "testcase": false, "constructor": false}, {"identifier": "queryJSON", "parameters": "(String url)", "modifiers": "", "return": "JSONObject", "signature": "JSONObject queryJSON(String url)", "full_signature": " JSONObject queryJSON(String url)", "class_method_signature": "OpenWeatherMapSource.queryJSON(String url)", "testcase": false, "constructor": false}, {"identifier": "readJSON", "parameters": "(String url)", "modifiers": "", "return": "String", "signature": "String readJSON(String url)", "full_signature": " String readJSON(String url)", "class_method_signature": "OpenWeatherMapSource.readJSON(String url)", "testcase": false, "constructor": false}], "file": "core/src/main/java/ru/gelin/android/weather/openweathermap/OpenWeatherMapSource.java"}, "focal_method": {"identifier": "query", "parameters": "(Location location)", "modifiers": "@Override public", "return": "Weather", "body": "@Override\n    public Weather query(Location location) throws WeatherException {\n        if (location == null) {\n            throw new WeatherException(\"null location\");\n        }\n\n        if (!location.isGeo()) {    // if the location contains geo coordinates, skipping this test hack\n            try {\n                if (location.getText().startsWith(\"-\")) {\n                    return new TestWeather(Integer.parseInt(location.getText()));\n                }\n                if (location.getText().startsWith(\"+\")) {\n                    return new TestWeather(Integer.parseInt(location.getText().substring(1)));\n                }\n            } catch (NumberFormatException nfe) {\n                // ignore and continue\n            }\n        }\n\n        OpenWeatherMapWeather weather = new OpenWeatherMapWeather(this.context);\n\n        weather.parseCurrentWeather(queryCurrentWeather(location));\n        if (weather.isEmpty()) {\n            return weather;\n        }\n        if (weather.getLocation().isGeo()) {    // extracts geo coord from the weather and do onecall with lat/lon\n            weather.parseOneCallResult(queryOneCallForecast(weather.getLocation()));\n        }\n        return weather;\n    }", "signature": "Weather query(Location location)", "full_signature": "@Override public Weather query(Location location)", "class_method_signature": "OpenWeatherMapSource.query(Location location)", "testcase": false, "constructor": false, "invocations": ["isGeo", "startsWith", "getText", "parseInt", "getText", "startsWith", "getText", "parseInt", "substring", "getText", "parseCurrentWeather", "queryCurrentWeather", "isEmpty", "isGeo", "getLocation", "parseOneCallResult", "queryOneCallForecast", "getLocation"]}, "repository": {"repo_id": 251049092, "url": "https://github.com/gelin/weather-notification", "language": "Java", "is_fork": false, "fork_count": 1, "stargazer_count": 7, "size": 12243, "license": "licensed"}}