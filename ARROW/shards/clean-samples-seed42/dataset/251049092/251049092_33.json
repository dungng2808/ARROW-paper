{"test_class": {"identifier": "OpenWeatherMapSourceTest", "superclass": "", "interfaces": "", "fields": [{"original_string": "private final Context context = ApplicationProvider.getApplicationContext();", "modifier": "private final", "type": "Context", "declarator": "context = ApplicationProvider.getApplicationContext()", "var_name": "context"}], "file": "core/src/test/java/ru/gelin/android/weather/openweathermap/OpenWeatherMapSourceTest.java"}, "test_case": {"identifier": "testQueryTestLocationPlus", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void testQueryTestLocationPlus() throws WeatherException {\n        WeatherSource source = new OpenWeatherMapSource(context);\n        Location location = new SimpleLocation(\"+25\", false);\n        Weather weather = source.query(location);\n        assertNotNull(weather);\n        assertFalse(weather.isEmpty());\n        assertEquals(\"Test location\", weather.getLocation().getText());\n        assertEquals(25, weather.getConditions().get(0).getTemperature(TemperatureUnit.C).getCurrent());\n    }", "signature": "void testQueryTestLocationPlus()", "full_signature": "@Test public void testQueryTestLocationPlus()", "class_method_signature": "OpenWeatherMapSourceTest.testQueryTestLocationPlus()", "testcase": true, "constructor": false, "invocations": ["query", "assertNotNull", "assertFalse", "isEmpty", "assertEquals", "getText", "getLocation", "assertEquals", "getCurrent", "getTemperature", "get", "getConditions"]}, "focal_class": {"identifier": "OpenWeatherMapSource", "superclass": "extends HttpWeatherSource", "interfaces": "implements WeatherSource", "fields": [{"original_string": "private final Context context;", "modifier": "private final", "type": "Context", "declarator": "context", "var_name": "context"}, {"original_string": "private final String apiBaseUrl;", "modifier": "private final", "type": "String", "declarator": "apiBaseUrl", "var_name": "apiBaseUrl"}, {"original_s