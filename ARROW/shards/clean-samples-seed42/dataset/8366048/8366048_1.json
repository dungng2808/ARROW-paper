tor": false}], "file": "gedcomx-model/src/main/java/org/gedcomx/util/CleanXMLStreamWriter.java"}, "focal_method": {"identifier": "escapeCharacters", "parameters": "(String string)", "modifiers": "protected static", "return": "String", "body": "protected static String escapeCharacters(String string) {\n    char[] copy = null;\n    boolean copied = false;\n    for (int i = 0; i < string.length();) {\n      int codePoint = string.codePointAt(i);\n      int size = Character.charCount(codePoint);\n      if (!isLegalXmlCodePoint(codePoint)) {\n        if (!copied) {\n          copy = string.toCharArray();\n          copied = true;\n        }\n        for (int j = 0; j < size; j++) {\n          copy[i + j] = REPLACEMENT_CHARACTER;\n        }\n      }\n      i += size;\n    }\n    return copied ? new String(copy) : string;\n  }", "signature": "String escapeCharacters(String string)", "full_signature": "protected static String escapeCharacters(String string)", "class_method_signature": "CleanXMLStreamWriter.escapeCharacters(String string)", "testcase": false, "constructor": false, "invocations": ["length", "codePointAt", "charCount", "isLegalXmlCodePoint", "toCharArray"]}, "repository": {"repo_id": 8366048, "url": "https://github.com/FamilySearch/gedcomx-java", "stars": 37, "created": "2/22/2013 9:14:38 PM +00:00", "updates": "2020-01-22T20:14:20+00:00", "fork": "False", "license": "licensed"}}