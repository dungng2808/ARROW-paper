)", "class_method_signature": "CryptoPrimitives.addCACertificateToTrustStore(File caCertPem, String alias)", "testcase": false, "constructor": false, "invocations": ["isEmpty", "readFileToByteArray", "generateCertificate", "addCACertificateToTrustStore", "getMessage"]}, "repository": {"repo_id": 130808918, "url": "https://github.com/shubhamvrkr/android-fabric-sdk", "language": "Java", "is_fork": false, "fork_count": 5, "stargazer_count": 13, "size": 84120, "license": "licensed"}}