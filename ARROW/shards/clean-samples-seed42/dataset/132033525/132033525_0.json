"file": "app/libs/android-auth-1.0/auth-lib/src/main/java/com/spotify/sdk/android/authentication/LoginActivity.java"}, "focal_method": {"identifier": "onClientComplete", "parameters": "(AuthenticationResponse response)", "modifiers": "@Override public", "return": "void", "body": "@Override\n    public void onClientComplete(AuthenticationResponse response) {\n        Intent resultIntent = new Intent();\n\n        // Put response into a bundle to work around classloader problems on Samsung devices\n        // https://stackoverflow.com/questions/28589509/android-e-parcel-class-not-found-when-unmarshalling-only-on-samsung-tab3\n        Bundle bundle = new Bundle();\n        bundle.putParcelable(RESPONSE_KEY, response);\n\n        resultIntent.putExtra(EXTRA_AUTH_RESPONSE, bundle);\n        setResult(Activity.RESULT_OK, resultIntent);\n        finish();\n    }", "signature": "void onClientComplete(AuthenticationResponse response)", "full_signature": "@Override public void onClientComplete(AuthenticationResponse response)", "class_method_signature": "LoginActivity.onClientComplete(AuthenticationResponse response)", "testcase": false, "constructor": false, "invocations": ["putParcelable", "putExtra", "setResult", "finish"]}, "repository": {"repo_id": 132033525, "url": "https://github.com/Valou3433/blade-player", "language": "Java", "is_fork": false, "fork_count": 12, "stargazer_count": 47, "size": 116689, "license": "licensed"}}