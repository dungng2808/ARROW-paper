{"test_class": {"identifier": "LoginActivityTest", "superclass": "", "interfaces": "", "fields": [], "file": "app/libs/android-auth-1.0/auth-lib/src/test/java/com/spotify/sdk/android/authentication/LoginActivityTest.java"}, "test_case": {"identifier": "shouldFinishLoginActivityWhenCompleted", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void shouldFinishLoginActivityWhenCompleted() {\n\n        Activity context = Robolectric\n                .buildActivity(Activity.class)\n                .create()\n                .get();\n\n        AuthenticationRequest request = new AuthenticationRequest.Builder(\"test\", AuthenticationResponse.Type.TOKEN, \"test://test\").build();\n        AuthenticationResponse response = new AuthenticationResponse.Builder()\n                .setType(AuthenticationResponse.Type.TOKEN)\n                .setAccessToken(\"test_token\")\n                .setExpiresIn(3600)\n                .build();\n\n        Bundle bundle = new Bundle();\n        bundle.putParcelable(LoginActivity.REQUEST_KEY, request);\n\n        Intent intent = new Intent(context, LoginActivity.class);\n        intent.putExtra(LoginActivity.EXTRA_AUTH_REQUEST, bundle);\n\n        ActivityController<LoginActivity> loginActivityActivityController = buildActivity(LoginActivity.class)\n                .withIntent(intent);\n\n        final LoginActivity loginActivity = loginActivityActivityController.get();\n\n        final ShadowActivity shadowLoginActivity = shadowOf(loginActivity);\n        shadowLoginActivity.setCallingActivity(context.getComponentName());\n\n        loginActivityActivityController.create();\n\n        assertFalse(loginActivity.isFinishing());\n\n        loginActivity.onClientComplete(response);\n\n        assertTrue(loginActivity.isFinishing());\n        assertEquals(Activity.RESULT_OK, shadowLoginActivity.getResultCode());\n        assertEquals(response, shadowLoginActivity.getResultIntent().getBundleExtra(LoginActivity.EXTRA_AUTH_RESPONSE).get(LoginActivity.RESPONSE_KEY));\n    }", "signature": "void shouldFinishLoginActivityWhenCompleted()", "full_signature": "@Test public void shouldFinishLoginActivityWhenCompleted()", "class_method_signature": "LoginActivityTest.shouldFinishLoginActivityWhenCompleted()", "testcase": true, "constructor": false, "invocations": ["get", "create", "buildActivity", "build", "build", "setExpiresIn", "setAccessToken", "setType", "putParcelable", "putExtra", "withIntent", "buildActivity", "get", "shadowOf", "setCallingActivity", "getComponentName", "create", "assertFalse", "isFinishing", "onClientComplete", "assertTrue", "isFinishing", "assertEquals", "getResultCode", "assertEquals", "get", "getBundleExtra", "getResultIntent"]}, "focal_class": {"identifier": "LoginActivity", "superclass": "extends Activity", "interfaces": "implements AuthenticationClient.AuthenticationClientListener", "fields": [{"original_string": "private static final String TAG = LoginActivity.class.getName();", "modifier": "private static final", "type": "String", "declarator": "TAG = LoginActivity.class.getName()", "var_name": "TAG"}, {"original_string": "private static final String NO_CALLER_ERROR = \"Can't use LoginActivity with a null caller. \" +\n            \"Possible reasons: calling activity has a singleInstance mode \" +\n            \"or LoginActivity is in a singleInstance/singleTask mode\";", "modifier": "private static final", "type": "String", "declarator": "NO_CALLER_ERROR = \"Can't use LoginActivity with a null caller. \" +\n            \"Possible reasons: calling activity has a singleInstance mode \" +\n            \"or LoginActivity is in a singleInstance/singleTask mode\"", "var_name": "NO_CALLER_ERROR"}, {"original_string": "private static final String NO_REQUEST_ERROR = \"No authentication request\";", "modifier": "private static final", "type": "String", "declarator": "NO_REQUEST_ERROR = \"No authentication request\"", "var_name": "NO_REQUEST_ERROR"},