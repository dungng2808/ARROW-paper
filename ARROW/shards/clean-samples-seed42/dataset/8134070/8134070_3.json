 {"identifier": "getUserByUsername", "parameters": "(String username)", "modifiers": "public", "return": "User", "signature": "User getUserByUsername(String username)", "full_signature": "public User getUserByUsername(String username)", "class_method_signature": "UserManagerImpl.getUserByUsername(String username)", "testcase": false, "constructor": false}, {"identifier": "getUserSessionDao", "parameters": "()", "modifiers": "public", "return": "UserSessionDao", "signature": "UserSessionDao getUserSessionDao()", "full_signature": "public UserSessionDao getUserSessionDao()", "class_method_signature": "UserManagerImpl.getUserSessionDao()", "testcase": false, "constructor": false}, {"identifier": "setUserSessionDao", "parameters": "(UserSessionDao userSessionDao)", "modifiers": "public", "return": "void", "signature": "void setUserSessionDao(UserSessionDao userSessionDao)", "full_signature": "public void setUserSessionDao(UserSessionDao userSessionDao)", "class_method_signature": "UserManagerImpl.setUserSessionDao(UserSessionDao userSessionDao)", "testcase": false, "constructor": false}, {"identifier": "setUserDao", "parameters": "(UserDao dao)", "modifiers": "@Required public", "return": "void", "signature": "void setUserDao(UserDao dao)", "full_signature": "@Required public void setUserDao(UserDao dao)", "class_method_signature": "UserManagerImpl.setUserDao(UserDao dao)", "testcase": false, "constructor": false}], "file": "openempi/core/src/main/java/org/openhie/openempi/service/impl/UserManagerImpl.java"}, "focal_method": {"identifier": "saveUser", "parameters": "(User user)", "modifiers": "public", "return": "User", "body": "public User saveUser(User user) throws UserExistsException {\n\n        if (user.getVersion() == null) {\n            // if new user, lowercase userId\n            user.setUsername(user.getUsername().toLowerCase());\n        }\n        \n        // Get and prepare password management-related artifacts\n        boolean passwordChanged = false;\n        if (passwordEncoder != null) {\n            // Check whether we have to encrypt (or re-encrypt) the password\n            if (user.getVersion() == null) {\n                // New user, always encrypt\n                passwordChanged = true;\n            } else {\n                // Existing user, check password in DB\n                String currentPassword = dao.getUserPassword(user.getUsername());\n                if (currentPassword == null) {\n                    passwordChanged = true;\n                } else {\n                    if (!currentPassword.equals(user.getPassword())) {\n                        passwordChanged = true;\n                    }\n                }\n            }\n\n            // If password was changed (or new user), encrypt it\n            if (passwordChanged) {\n                user.setPassword(passwordEncoder.encodePassword(user.getPassword(), null));\n            }\n        } else {\n            log.warn(\"PasswordEncoder not set, skipping password encryption...\");\n        }\n        \n        try {\n            return dao.saveUser(user);\n        } catch (DataIntegrityViolationException e) {\n            e.printStackTrace();\n            log.warn(e.getMessage());\n            throw new UserExistsException(\"User '\" + user.getUsername() + \"' already exists!\");\n        } catch (EntityExistsException e) { // needed for JPA\n            e.printStackTrace();\n            log.warn(e.getMessage());\n            throw new UserExistsException(\"User '\" + user.getUsername() + \"' already exists!\");\n        }\n    }", "signature": "User saveUser(User user)", "full_signature": "public User saveUser(User user)", "class_method_signature": "UserManagerImpl.saveUser(User user)", "testcase": false, "constructor": false, "invocations": ["getVersion", "setUsername", "toLowerCase", "getUsername", "getVersion", "getUserPassword", "getUsername", "equals", "getPassword", "setPassword", "encodePassword", "getPassword", "warn", "saveUser", "