n/zip\", stream);\n\n        try {\n            final Document existingDocument = (Document) session.getObjectByPath(\"/\" + WORKSPACE_ZIP_NAME);\n            existingDocument.setContentStream(contentStream, true);\n        } catch (final CmisObjectNotFoundException e) {\n            session.getRootFolder().createDocument(CMIS_DOCUMENT_PROPERTIES, contentStream, VersioningState.NONE);\n        }\n    }", "signature": "void save(final InputStream stream)", "full_signature": "@Override public void save(final InputStream stream)", "class_method_signature": "EcmStorage.save(final InputStream stream)", "testcase": false, "constructor": false, "invocations": ["createContentStream", "getObjectFactory", "getObjectByPath", "setContentStream", "createDocument", "getRootFolder"]}, "repository": {"repo_id": 13380298, "url": "https://github.com/SAP-samples/cloud-jenkins", "language": "Java", "is_fork": false, "fork_count": 9, "stargazer_count": 14, "size": 359, "license": "licensed"}}