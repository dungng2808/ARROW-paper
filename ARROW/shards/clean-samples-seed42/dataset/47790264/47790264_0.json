eListableBeanFactory beanFactory)", "modifiers": "private", "return": "void", "signature": "void registerDefaultJaxrsApp(ConfigurableListableBeanFactory beanFactory)", "full_signature": "private void registerDefaultJaxrsApp(ConfigurableListableBeanFactory beanFactory)", "class_method_signature": "ResteasyEmbeddedServletInitializer.registerDefaultJaxrsApp(ConfigurableListableBeanFactory beanFactory)", "testcase": false, "constructor": false}, {"identifier": "createApplicationServlet", "parameters": "(Class<? extends Application> applicationClass, String path)", "modifiers": "private", "return": "GenericBeanDefinition", "signature": "GenericBeanDefinition createApplicationServlet(Class<? extends Application> applicationClass, String path)", "full_signature": "private GenericBeanDefinition createApplicationServlet(Class<? extends Application> applicationClass, String path)", "class_method_signature": "ResteasyEmbeddedServletInitializer.createApplicationServlet(Class<? extends Application> applicationClass, String path)", "testcase": false, "constructor": false}], "file": "resteasy-spring-boot-starter/src/main/java/com/paypal/springboot/resteasy/ResteasyEmbeddedServletInitializer.java"}, "focal_method": {"identifier": "postProcessBeanFactory", "parameters": "(ConfigurableListableBeanFactory beanFactory)", "modifiers": "public", "return": "void", "body": "public void postProcessBeanFactory(ConfigurableListableBeanFactory beanFactory) throws BeansException {\n        logger.debug(\"Post process bean factory has been called\");\n\n        findJaxrsApplications(beanFactory);\n\n        // This is done by finding their related Spring beans\n        findJaxrsResourcesAndProviderClasses(beanFactory);\n\n        if (allResources.size() == 0) {\n            logger.warn(\"No JAX-RS resource Spring beans have been found\");\n        }\n        if (applications.size() == 0) {\n            logger.info(\"No JAX-RS Application classes have been found. A default, one mapped to '/', will be registered.\");\n            registerDefaultJaxrsApp(beanFactory);\n            return;\n        }\n\n        BeanDefinitionRegistry registry = (BeanDefinitionRegistry) beanFactory;\n\n        for (Class<? extends Application> applicationClass : applications) {\n            ApplicationPath path = AnnotationUtils.findAnnotation(applicationClass, ApplicationPath.class);\n            if (path == null) {\n                logger.warn(\"JAX-RS Application class {} has no ApplicationPath annotation, so it will not be registered\", applicationClass.getName());\n                continue;\n            }\n\n            logger.debug(\"registering JAX-RS application class \" + applicationClass.getName());\n\n            GenericBeanDefinition applicationServletBean = createApplicationServlet(applicationClass, path.value());\n            registry.registerBeanDefinition(applicationClass.getName(), applicationServletBean);\n        }\n\n    }", "signature": "void postProcessBeanFactory(ConfigurableListableBeanFactory beanFactory)", "full_signature": "public void postProcessBeanFactory(ConfigurableListableBeanFactory beanFactory)", "class_method_signature": "ResteasyEmbeddedServletInitializer.postProcessBeanFactory(ConfigurableListableBeanFactory beanFactory)", "testcase": false, "constructor": false, "invocations": ["debug", "findJaxrsApplications", "findJaxrsResourcesAndProviderClasses", "size", "warn", "size", "info", "registerDefaultJaxrsApp", "findAnnotation", "warn", "getName", "debug", "getName", "createApplicationServlet", "value", "registerBeanDefinition", "getName"]}, "repository": {"repo_id": 47790264, "url": "https://github.com/paypal/resteasy-spring-boot", "language": "Java", "is_fork": false, "fork_count": 102, "stargazer_count": 186, "size": 233, "license": "Other"}}