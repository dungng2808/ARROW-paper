{"test_class": {"identifier": "DefaultRiskAnalysisTest", "superclass": "", "interfaces": "", "fields": [{"original_string": "private static final NetworkParameters MAINNET = MainNetParams.get();", "modifier": "private static final", "type": "NetworkParameters", "declarator": "MAINNET = MainNetParams.get()", "var_name": "MAINNET"}, {"original_string": "private Wallet wallet;", "modifier": "private", "type": "Wallet", "declarator": "wallet", "var_name": "wallet"}, {"original_string": "private final int TIMESTAMP = 1384190189;", "modifier": "private final", "type": "int", "declarator": "TIMESTAMP = 1384190189", "var_name": "TIMESTAMP"}, {"original_string": "private static final ECKey key1 = new ECKey();", "modifier": "private static final", "type": "ECKey", "declarator": "key1 = new ECKey()", "var_name": "key1"}, {"original_string": "private final ImmutableList<Transaction> NO_DEPS = ImmutableList.of();", "modifier": "private final", "type": "ImmutableList<Transaction>", "declarator": "NO_DEPS = ImmutableList.of()", "var_name": "NO_DEPS"}], "file": "core/src/test/java/org/bitcoinj/wallet/DefaultRiskAnalysisTest.java"}, "test_case": {"identifier": "canonicalSignature", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void canonicalSignature() {\n        TransactionSignature sig = TransactionSignature.dummy();\n        Script scriptOk = ScriptBuilder.createInputScript(sig);\n        assertEquals(RuleViolation.NONE,\n                DefaultRiskAnalysis.isInputStandard(new TransactionInput(MAINNET, null, scriptOk.getProgram())));\n\n        byte[] sigBytes = sig.encodeToBitcoin();\n        // Appending a zero byte makes the signature uncanonical without violating DER encoding.\n        Script scriptUncanonicalEncoding = new ScriptBuilder().data(Arrays.copyOf(sigBytes, sigBytes.length + 1))\n                .build();\n        assertEquals(RuleViolation.SIGNATURE_CANONICAL_ENCODING,\n                DefaultRiskAnalysis.isInputStandard(new TransactionInput(MAINNET, null, scriptUncanonicalEncoding\n                        .getProgram())));\n    }", "signature": "void canonicalSignature()", "full_signature": "@Test public void canonicalSignature()", "class_method_signature": "DefaultRiskAnalysisTest.canonicalSignature()", "testcase": true, "constructor": false, "invocations": ["dummy", "createInputScript", "assertEquals", "isInputStandard", "getProgram", "encodeToBitcoin", "build", "data", "copyOf", "assertEquals", "isInputStandard", "getProgram"]}, "focal_class": {"identifier": "DefaultRiskAnalysis", "superclass": "", "interfaces": "implements RiskAnalysis", "fields": [{"original_string": "private static final Logger log = LoggerFactory.getLogger(DefaultRiskAnalysis.class);", "modifier": "private static final", "type": "Logger", "declarator": "log = LoggerFactory.getLogger(DefaultRiskAnalysis.class)", "var_name": "log"}, {"original_string": "public static final Coin MIN_ANALYSIS_NONDUST_OUTPUT = Transaction.MIN_NONDUST_OUTPUT;", "modifier": "public static final", "type": "Coin", "declarator": "MIN_ANALYSIS_NONDUST_OUTPUT = Transaction.MIN_NONDUST_OUTPUT", "var_name": "MIN_ANALYSIS_NONDUST_OUTPUT"}, {"original_string": "protected final Transaction tx;", "modifier": "protected final", "type": "Transaction", "declarator": "tx", "var_name": "tx"}, {"original_string": "protected final List<Transaction> dependencies;", "modifier": "protected final", "type": "List<Transaction>", "declarator": "dependencies", "var_name": "dependencies"}, {"original_string": "@Nullable protected final Wallet wallet;", "modifier": "@Nullable protected final", "type": "Wallet", "declarator": "wallet", "var_name": "wallet"}, {"original_string": "private Transaction nonStandard;", "modifier": "private", "type": "Transaction", "declarator": "nonStandard", "var_name": "nonStandard"}, {"original_string": "protected Transaction nonFinal;", "modifier": "protected", "type": "Transaction", "declarator": "nonFinal", "var_name": "nonFinal"}, {"original_string": "protected boolean analyzed;", "modifier": "protected", "type": "boolean", "declarator": "analyzed", "var_name": "analyzed"}, {"original_string": "public static Analyzer FACTORY = new Analyzer();", "modifier": "public static", "type": "Analyzer", "declarator": "FACTORY = new Analyzer()", "var_name": "FACTORY"}], "methods": [{"identifier": "DefaultRiskAnalysis", "parameters": "(Wallet wallet, Transaction tx, List<Transaction> dependencies)", "modifiers": "private", "return": "", "signature": " DefaultRiskAnalysis(Wallet wallet, Transaction tx, List<Transaction> dependencies)", "full_signature": "private  DefaultRiskAnalysis(Wallet wallet, Transaction tx, List<Transaction> dependencies)", "class_method_signature": "DefaultRiskAnalysis.DefaultRiskAnalysis(Wallet wallet, Transaction tx, List<Transaction> dependencies)", "testcase": false, "constructor": true}, {"identifier": "analyze", "parameters": "()", "modifiers": "@Override public", "return": "Result", "signature": "Result analyze()", "full_signature": "@Override public Result analyze()", "class_method_signature": "DefaultRiskAnalysis.analyze()", "testcase": false, "constructor": false}, {"identifier": "analyzeIsFinal", "parameters": "()", "modifiers": "@Nullable private", "return": "Result", "signature": "Result analyzeIsFinal()", "full_signature": "@Nullable private Result analyzeIsFinal()", "class_method_signature": "DefaultRiskAnalysis.analyzeIsFinal()", "testcase": false, "constructor": false}, {"identifier": "isStandard", "parameters": "(Transaction tx)", "modifiers": "public static", "return": "RuleViolation", "signature": "RuleViolation isStandard(Transaction tx)", "full_signature": "public static RuleViolation isStandard(Transaction tx)", "class_method_signature": "DefaultRiskAnalysis.isStandard(Transaction tx)", "testcase": false, "constructor": false}, {"identifier": "isOutputStandard", "parameters": "(TransactionOutput output)", "modifiers": "public static", "return": "RuleViolation", "signature": "RuleViolation isOutputStandard(TransactionOutput output)", "full_signature": "public static RuleViolation isOutputStandard(TransactionOutput output)", "class_method_signature": "DefaultRiskAnalysis.isOutputStandard(TransactionOutput output)", "testcase": false, "constructor": false}, {"identifier": "isInputStandard", "parameters": "(TransactionInput input)", "modifiers": "public static", "return": "RuleViolation", "signature": "RuleViolation isInputStandard(TransactionInput input)", "full_signature": "public static RuleViolation isInputStandard(TransactionInput input)", "class_method_signature": "DefaultRiskAnalysis.isInputStandard(TransactionInput input)", "testcase": false, "constructor": false}, {"identifier": "analyzeIsStandard", "parameters": "()", "modifiers": "private", "return": "Result", "signature": "Result analyzeIsStandard()", "full_signature": "private Result analyzeIsStandard()", "class_method_signature": "DefaultRiskAnalysis.analyzeIsStandard()", "testcase": false, "constructor": false}, {"identifier": "getNonStandard", "parameters": "()", "modifiers": "@Nullable public", "return": "Transaction", "signature": "Transaction getNonStandard()", "full_signature": "@Nullable public Transaction getNonStandard()", "class_method_signature": "DefaultRiskAnalysis.getNonStandard()", "testcase": false, "constructor": false}, {"identifier": "getNonFinal", "parameters": "()", "modifiers": "@Nullable public", "return": "Transaction", "signature": "Transaction getNonFinal()", "full_signature": "@Nullable public Transaction getNonFinal()", "class_method_signature": "DefaultRiskAnalysis.getNonFinal()", "testcase": false, "constructor": false}, {"identifier": "toString", "parameters": "()", "modifiers": "@Override public", "return": "String", "signature": "String toString()", "full_signature": "@Override public String toString()", "class_method_signature": "DefaultRiskAnalysis.toString()", "testcase": false, "constructor": false}], "file": "core/src/main/java/org/bitcoinj/wallet/DefaultRiskAnalysis.java"}, "focal_method": {"identifier": "isInputStandard", "parameters": "(TransactionInput input)", "modifiers": "public static", "return": "RuleViolation", "body": "public static RuleViolation isInputStandard(TransactionInput input) {\n        for (ScriptChunk chunk : input.getScriptSig().getChunks()) {\n            if (chunk.data != null && !chunk.isShortestPossiblePushData())\n                return RuleViolation.SHORTEST_POSSIBLE_PUSHDATA;\n            if (chunk.isPushData()) {\n                ECDSASignature signature;\n                try {\n                    signature = ECKey.ECDSASignature.decodeFromDER(chunk.data);\n                } catch (IllegalArgumentException x) {\n                    // Doesn't look like a signature.\n                    signature = null;\n                }\n                if (signature != null) {\n                    if (!TransactionSignature.isEncodingCanonical(chunk.data))\n                        return RuleViolation.SIGNATURE_CANONICAL_ENCODING;\n                    if (!signature.isCanonical())\n                        return RuleViolation.SIGNATURE_CANONICAL_ENCODING;\n                }\n            }\n        }\n        return RuleViolation.NONE;\n    }", "signature": "RuleViolation isInputStandard(TransactionInput input)", "full_signature": "public static RuleViolation isInputStandard(TransactionInput input)", "class_method_signature": "DefaultRiskAnalysis.isInputStandard(TransactionInput input)", "testcase": false, "constructor": false, "invocations": ["getChunks", "getScriptSig", "isShortestPossiblePushData", "isPushData", "decodeFromDER", "isEncodingCanonical", "isCanonical"]}, "repository": {"repo_id": 126439064, "url": "https://github.com/bingoer/bitcoinj_sourcecode_analysis", "language": "Java", "is_fork": false, "fork_count": 3, "stargazer_count": 5, "size": 17557, "license": "licensed"}}