etherType == ETHERNET_TYPE_IP || etherType == ETHERNET_TYPE_IPV6)\n\t\t\t\t\treturn start;\n\t\t\t\tbreak;\n\t\t\tcase RAW:\n\t\t\t\treturn 0;\n\t\t\tcase LOOP:\n\t\t\t\treturn 4;\n\t\t\tcase LINUX_SLL:\n\t\t\t    start = SLL_HEADER_BASE_SIZE;\n\t\t\t\tint sllAddressLength = PcapReaderUtil.convertShort(packet, SLL_ADDRESS_LENGTH_OFFSET);\n\t\t\t\tstart += sllAddressLength;\n\t\t\t\treturn start;\n\t\t}\n\t\treturn -1;\n\t}", "signature": "int findIPStart(byte[] packet)", "full_signature": "protected int findIPStart(byte[] packet)", "class_method_signature": "PcapReader.findIPStart(byte[] packet)", "testcase": false, "constructor": false, "invocations": ["convertShort", "convertShort", "convertShort"]}, "repository": {"repo_id": 2499324, "url": "https://github.com/RIPE-NCC/hadoop-pcap", "language": "Java", "is_fork": false, "fork_count": 104, "stargazer_count": 190, "size": 428, "license": "licensed"}}