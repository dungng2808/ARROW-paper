ile": "jraft-core/src/main/java/com/alipay/sofa/jraft/util/Recyclers.java"}, "focal_method": {"identifier": "recycle", "parameters": "(T o, Handle handle)", "modifiers": "public final", "return": "boolean", "body": "public final boolean recycle(T o, Handle handle) {\n        if (handle == NOOP_HANDLE) {\n            return false;\n        }\n\n        DefaultHandle h = (DefaultHandle) handle;\n\n        final Stack<?> stack = h.stack;\n        if (h.lastRecycledId != h.recycleId || stack == null) {\n            throw new IllegalStateException(\"recycled already\");\n        }\n\n        if (stack.parent != this) {\n            return false;\n        }\n        if (o != h.value) {\n            throw new IllegalArgumentException(\"o does not belong to handle\");\n        }\n        h.recycle();\n        return true;\n    }", "signature": "boolean recycle(T o, Handle handle)", "full_signature": "public final boolean recycle(T o, Handle handle)", "class_method_signature": "Recyclers.recycle(T o, Handle handle)", "testcase": false, "constructor": false, "invocations": ["recycle"]}, "repository": {"repo_id": 173721564, "url": "https://github.com/sofastack/sofa-jraft", "stars": 1639, "created": "3/4/2019 10:13:43 AM +00:00", "updates": "2020-01-25T06:01:06+00:00", "fork": "False", "license": "licensed"}}