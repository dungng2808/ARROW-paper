1\"));\n        assertTrue(mapNamesList.contains(\"bytes2\"));\n        assertTrue(mapNamesList.contains(\"char\"));\n        assertTrue(mapNamesList.contains(\"double\"));\n        assertTrue(mapNamesList.contains(\"float\"));\n        assertTrue(mapNamesList.contains(\"int\"));\n        assertTrue(mapNamesList.contains(\"long\"));\n        assertTrue(mapNamesList.contains(\"object\"));\n        assertTrue(mapNamesList.contains(\"short\"));\n        assertTrue(mapNamesList.contains(\"string\"));\n    }", "signature": "void testGetMapNames()", "full_signature": "@Test public void testGetMapNames()", "class_method_signature": "JmsMapMessageTest.testGetMapNames()", "testcase": true, "constructor": false, "invocations": ["createMapMessage", "setBoolean", "setByte", "setBytes", "setBytes", "setChar", "setDouble", "setFloat", "setInt", "setLong", "setObject", "setShort", "setString", "copy", "getMapNames", "list", "assertEquals", "size", "assertTrue", "contains", "assertTrue", "contains", "assertTrue", "contains", "assertTrue", "contains", "assertTrue", "contains", "assertTrue", "contains", "assertTrue", "contains", "assertTrue", "contains", "assertTrue", "contains", "assertTrue", "contains", "assertTrue", "contains", "assertTrue", "contains"]}, "focal_class": {"identifier": "JmsMapMessage", "superclass": "extends JmsMessage", "interfaces": "implements MapMessage", "fields": [{"original_string": "protected transient Map<String, Object> map = new HashMap<String, Object>();", "modifier": "protected transient", "type": "Map<String, Object>", "declarator": "map = new HashMap<String, Object>()", "var_name": "map"}], "methods": [{"identifier": "JmsMapMessage", "parameters": "(JmsMessageFacade facade)", "modifiers": "public", "return": "", "signature": " JmsMapMessage(JmsMessageFacade facade)", "full_signature": "public  JmsMapMessage(JmsMessageFacade facade)", "class_method_signature": "JmsMapMessage.JmsMapMessage(JmsMessageFacade facade)", "testcase": false, "constructor": tr