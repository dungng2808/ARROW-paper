 switch, make it happen.\n\t\tif(!switchBackCanNeverHappen){\n\t\t\ttriggerBackSwitchIfNecessary();\n\t\t}\n\n\t\tif (isLocal(dc)) {\t\t\t\n\t\t\treturn HostDistance.LOCAL;\n\t\t}\n\n\t\t// Only hosts in local DC and backup DC can be considered remote\n\t\tif(dc(host).equals(localDc) || dc(host).equals(backupDc))\n\t\t\treturn HostDistance.REMOTE;\n\t\t\n\t\t// All other hosts are ignored\n\t\treturn HostDistance.IGNORED;\n\t\t\n\t}", "signature": "HostDistance distance(Host host)", "full_signature": "public HostDistance distance(Host host)", "class_method_signature": "DCAwareFailoverRoundRobinPolicy.distance(Host host)", "testcase": false, "constructor": false, "invocations": ["dc", "triggerBackSwitchIfNecessary", "isLocal", "equals", "dc", "equals", "dc"]}, "repository": {"repo_id": 41548314, "url": "https://github.com/adejanovski/cassandra-dcaware-failover", "language": "Java", "is_fork": false, "fork_count": 3, "stargazer_count": 17, "size": 73, "license": "licensed"}}