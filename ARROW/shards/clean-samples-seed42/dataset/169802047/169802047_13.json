alArgumentException noConfigTypesProvidedException()", "class_method_signature": "ConfigTypeFilters.noConfigTypesProvidedException()", "testcase": false, "constructor": false}], "file": "microconfig-api/src/main/java/io/microconfig/core/configtypes/ConfigTypeFilters.java"}, "focal_method": {"identifier": "configTypeWithExtensionOf", "parameters": "(File file)", "modifiers": "public static", "return": "ConfigTypeFilter", "body": "public static ConfigTypeFilter configTypeWithExtensionOf(File file) {\n        String ext = getExtension(file);\n        if (ext.isEmpty()) {\n            throw new IllegalArgumentException(\"File \" + file + \" doesn't have an extension. Unable to resolve component type.\");\n        }\n        return types -> types.stream()\n                .filter(t -> t.getSourceExtensions().contains(ext))\n                .findFirst()\n                .map(Collections::singletonList)\n                .orElseThrow(() -> new IllegalArgumentException(\"Unsupported config extension '\" + ext + \"'\"));\n    }", "signature": "ConfigTypeFilter configTypeWithExtensionOf(File file)", "full_signature": "public static ConfigTypeFilter configTypeWithExtensionOf(File file)", "class_method_signature": "ConfigTypeFilters.configTypeWithExtensionOf(File file)", "testcase": false, "constructor": false, "invocations": ["getExtension", "isEmpty", "orElseThrow", "map", "findFirst", "filter", "stream", "contains", "getSourceExtensions"]}, "repository": {"repo_id": 169802047, "url": "https://github.com/microconfig/microconfig", "language": "Java", "is_fork": false, "fork_count": 4, "stargazer_count": 101, "size": 1733, "license": "licensed"}}