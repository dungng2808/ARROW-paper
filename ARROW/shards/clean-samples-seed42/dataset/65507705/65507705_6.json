AG, QUOTE_START_TAG_REGEXP);\n            int endTokens = countTokens(line, QUOTE_END_TAG, QUOTE_END_TAG_REGEXP);\n            if (startTokens > 0) {\n                line = line.replaceAll(QUOTE_START_TAG_REGEXP, \"\");\n                indent += startTokens;\n            }\n            for (int j = 0; j < indent; j++) {\n                line = \" > \" + line;\n            }\n            if (endTokens > 0 && indent > 0) {\n                line = line.replaceAll(QUOTE_END_TAG_REGEXP, \"\");\n                indent -= endTokens;\n            }\n            sb.append(line);\n            if (!last) {\n                sb.append(\"\\n\");\n            }\n        }\n        return sb.toString();\n    }", "signature": "String obtainQuoteFromMessage(String msg)", "full_signature": "@SuppressWarnings(\"StringConcatenationInLoop\") public static String obtainQuoteFromMessage(String msg)", "class_method_signature": "StringHelper.obtainQuoteFromMessage(String msg)", "testcase": false, "constructor": false, "invocations": ["split", "countTokens", "countTokens", "replaceAll", "replaceAll", "append", "append", "toString"]}, "repository": {"repo_id": 65507705, "url": "https://github.com/jruesga/rview", "language": "Java", "is_fork": false, "fork_count": 15, "stargazer_count": 46, "size": 9554, "license": "licensed"}}