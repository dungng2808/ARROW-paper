n connectAndSendMessage(message);\n        } else {\n            if (responseEmitter == null || responseEmitter.hasComplete()) {\n                responseEmitter = PublishSubject.create();\n            }\n\n            if (okWebSocketClient != null && okWebSocketClient.isConnected()) {\n                okWebSocketClient.updateCallbackEmitter(responseEmitter);\n                okWebSocketClient.sendMessage(message);\n            } else {\n                // fallback to Messenger\n                super.sendMessage(message);\n            }\n            return responseEmitter;\n        }\n    }", "signature": "Observable<String> sendMessage(final String message)", "full_signature": "@Override public Observable<String> sendMessage(final String message)", "class_method_signature": "ObservableWebSocketClient.sendMessage(final String message)", "testcase": false, "constructor": false, "invocations": ["isConnected", "connectAndSendMessage", "hasComplete", "create", "isConnected", "updateCallbackEmitter", "sendMessage", "sendMessage"]}, "repository": {"repo_id": 100361171, "url": "https://github.com/Aevi-UK/android-rxmessenger", "language": "Java", "is_fork": false, "fork_count": 1, "stargazer_count": 7, "size": 2286, "license": "licensed"}}