Override public Model getModel(String version)", "class_method_signature": "ModelService.getModel(String version)", "testcase": false, "constructor": false}, {"identifier": "getModelByWorkitem", "parameters": "(ItemCollection workitem)", "modifiers": "@Override public", "return": "Model", "signature": "Model getModelByWorkitem(ItemCollection workitem)", "full_signature": "@Override public Model getModelByWorkitem(ItemCollection workitem)", "class_method_signature": "ModelService.getModelByWorkitem(ItemCollection workitem)", "testcase": false, "constructor": false}, {"identifier": "getVersions", "parameters": "()", "modifiers": "public", "return": "List<String>", "signature": "List<String> getVersions()", "full_signature": "public List<String> getVersions()", "class_method_signature": "ModelService.getVersions()", "testcase": false, "constructor": false}, {"identifier": "getLatestVersions", "parameters": "()", "modifiers": "public", "return": "List<String>", "signature": "List<String> getLatestVersions()", "full_signature": "public List<String> getLatestVersions()", "class_method_signature": "ModelService.getLatestVersions()", "testcase": false, "constructor": false}, {"identifier": "getGroups", "parameters": "()", "modifiers": "public", "return": "List<String>", "signature": "List<String> getGroups()", "full_signature": "public List<String> getGroups()", "class_method_signature": "ModelService.getGroups()", "testcase": false, "constructor": false}, {"identifier": "findVersionsByGroup", "parameters": "(String group)", "modifiers": "public", "return": "List<String>", "signature": "List<String> findVersionsByGroup(String group)", "full_signature": "public List<String> findVersionsByGroup(String group)", "class_method_signature": "ModelService.findVersionsByGroup(String group)", "testcase": false, "constructor": false}, {"identifier": "findVersionsByRegEx", "parameters": "(String modelRegex)", "modifiers": "public", "return": "List<String>", "signature": "List<String> findVersionsByRegEx(String modelRegex)", "full_signature": "public List<String> findVersionsByRegEx(String modelRegex)", "class_method_signature": "ModelService.findVersionsByRegEx(String modelRegex)", "testcase": false, "constructor": false}, {"identifier": "saveModel", "parameters": "(BPMNModel model)", "modifiers": "public", "return": "void", "signature": "void saveModel(BPMNModel model)", "full_signature": "public void saveModel(BPMNModel model)", "class_method_signature": "ModelService.saveModel(BPMNModel model)", "testcase": false, "constructor": false}, {"identifier": "saveModel", "parameters": "(BPMNModel model, String _filename)", "modifiers": "public", "return": "void", "signature": "void saveModel(BPMNModel model, String _filename)", "full_signature": "public void saveModel(BPMNModel model, String _filename)", "class_method_signature": "ModelService.saveModel(BPMNModel model, String _filename)", "testcase": false, "constructor": false}, {"identifier": "deleteModel", "parameters": "(String version)", "modifiers": "public", "return": "void", "signature": "void deleteModel(String version)", "full_signature": "public void deleteModel(String version)", "class_method_signature": "ModelService.deleteModel(String version)", "testcase": false, "constructor": false}, {"identifier": "loadModelEntity", "parameters": "(String version)", "modifiers": "public", "return": "ItemCollection", "signature": "ItemCollection loadModelEntity(String version)", "full_signature": "public ItemCollection loadModelEntity(String version)", "class_method_signature": "ModelService.loadModelEntity(String version)", "testcase": false, "constructor": false}, {"identifier": "getDataObject", "parameters": "(ItemCollection bpmnElement, String name)", "modifiers": "@SuppressWarnings(\"unchecked\") public", "return": "String", "signature": "String getDataObject(ItemCollection bpmnElement, String name)", "full_signature": "@SuppressWarnings(\"unchecked\") public String getDataObject(ItemCollection bpmnElement, String name)", "class_method_signature": "ModelService.getDataObject(ItemCollection bpmnElement, String name)", "testcase": false, "constructor": false}, {"identifier": "getModelStore", "parameters": "()", "modifiers": "private", "return": "Map<String, Model>", "signature": "Map<String, Model> getModelStore()", "full_signature": "private Map<String, Model> getModelStore()", "class_method_signature": "ModelService.getModelStore()", "testcase": false, "constructor": false}], "file": "imixs-workflow-engine/src/main/java/org/imixs/workflow/engine/ModelService.java"}, "focal_method": {"identifier": "getModelByWorkitem", "parameters": "(ItemCollection workitem)", "modifiers": "@Override public", "return": "Model", "body": "@Override\n    public Model getModelByWorkitem(ItemCollection workitem) throws ModelException {\n        boolean debug = logger.isLoggable(Level.FINE);\n        String modelVersion = workitem.getModelVersion();\n        String workflowGroup = workitem.getItemValueString(WorkflowKernel.WORKFLOWGROUP);\n        // if $workflowgroup is empty try deprecated field txtworkflowgroup\n        if (workflowGroup.isEmpty()) {\n            workflowGroup = workitem.getItemValueString(\"txtworkflowgroup\");\n        }\n\n        Model model = null;\n        try {\n            model = getModel(modelVersion);\n        } catch (ModelException me) {\n            model = null;\n            List<String> versions = null;\n            if (debug) {\n                logger.finest(me.getMessage());\n            }\n            // try to find latest version by regex....\n            if (modelVersion != null && !modelVersion.isEmpty()) {\n                versions = findVersionsByRegEx(modelVersion);\n                if (!versions.isEmpty()) {\n                    // we found a match by regex!\n                    String newVersion = versions.get(0);\n                    logger.info(\"...... match version '\" + newVersion + \"' -> by regex '\" + modelVersion + \"'\");\n                    workitem.replaceItemValue(WorkflowKernel.MODELVERSION, newVersion);\n                    model = getModel(newVersion);\n                }\n            }\n\n            // try to find model version by group\n            if (model == null && !workflowGroup.isEmpty()) {\n                versions = findVersionsByGroup(workflowGroup);\n                if (!versions.isEmpty()) {\n                    String newVersion = versions.get(0);\n                    logger.warning(\"Deprecated model version: '\" + modelVersion + \"' -> migrating to '\" + newVersion\n                            + \"',  $workflowgroup: '\" + workflowGroup + \"', $uniqueid: \" + workitem.getUniqueID());\n                    workitem.replaceItemValue(WorkflowKernel.MODELVERSION, newVersion);\n                    model = getModel(newVersion);\n                }\n            }\n        }\n\n        // check if model was found....\n        if (model == null) {\n            throw new ModelException(ModelException.UNDEFINED_MODEL_VERSION,\n                    \"No matching $modelversion found for '\" + modelVersion + \"', $workflowgroup: '\" + workflowGroup\n                            + \"', $uniqueid: \" + workitem.getUniqueID());\n        }\n\n        return model;\n    }", "signature": "Model getModelByWorkitem(ItemCollection workitem)", "full_signature": "@Override public Model getModelByWorkitem(ItemCollection workitem)", "class_method_signature": "ModelService.getModelByWorkitem(ItemCollection workitem)", "testcase": false, "constructor": false, "invocations": ["isLoggable", "getModelVersion", "getItemValueString", "isEmpty", "getItemValueString", "getModel", "finest", "getMessage", "isEmpty", "findVersionsByRegEx", "isEmpty", "get", "info", "replaceItemValue", "getModel", "isEmpty", "findVersionsByGroup", "isEmpty", "get", "warning", "getUniqueID", "replaceItemValue", "getModel", "getUniqueID"]}, "repository": {"repo_id": 15841047, "url": "https://github.com/imixs/imixs-workflow", "stars": 175, "created": "1/12/2014 11:30:35 AM +00:00", "updates": "2020-01-21T21:16:48+00:00", "fork": "False", "license": "licensed"}}