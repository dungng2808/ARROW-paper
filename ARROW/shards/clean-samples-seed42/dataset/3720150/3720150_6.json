ring fileName)", "modifiers": "private", "return": "SCRIPT_TYPE", "body": "private SCRIPT_TYPE determineScriptType(String fileName) {\n        File f = new File(fileName);\n        if (f.exists() && f.isFile()) {\n            return SCRIPT_TYPE.FILE;\n        }\n\n        InputStream in = ScriptEnginePersonAttributeDao.class.getClassLoader().getResourceAsStream(fileName);\n        try {\n            if (in != null && in.markSupported() && in.available() > 0) {\n                return SCRIPT_TYPE.RESOURCE;\n            }\n        } catch (IOException e) {\n            logger.warn(\"Error checking if stream exists: {}\",e.getMessage(),e);\n            return SCRIPT_TYPE.CONTENTS;\n        }\n        return SCRIPT_TYPE.CONTENTS;\n    }", "signature": "SCRIPT_TYPE determineScriptType(String fileName)", "full_signature": "private SCRIPT_TYPE determineScriptType(String fileName)", "class_method_signature": "ScriptEnginePersonAttributeDao.determineScriptType(String fileName)", "testcase": false, "constructor": false, "invocations": ["exists", "isFile", "getResourceAsStream", "getClassLoader", "markSupported", "available", "warn", "getMessage"]}, "repository": {"repo_id": 3720150, "url": "https://github.com/apereo/person-directory", "stars": 19, "created": "3/14/2012 5:33:41 PM +00:00", "updates": "2020-01-18T11:49:11+00:00", "fork": "False", "license": "licensed"}}