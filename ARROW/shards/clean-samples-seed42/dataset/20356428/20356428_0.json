{"test_class": {"identifier": "BitSetTest", "superclass": "", "interfaces": "", "fields": [], "file": "bungee/src/test/java/codecrafter47/bungeetablistplus/util/BitSetTest.java"}, "test_case": {"identifier": "testNextSetBit", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void testNextSetBit() {\n        BitSet bitSet = new BitSet(80);\n\n        bitSet.set(15);\n\n        bitSet.set(19);\n\n        bitSet.set(17);\n\n        assertEquals(15, bitSet.nextSetBit(0));\n        assertEquals(17, bitSet.nextSetBit(15 + 1));\n        assertEquals(19, bitSet.nextSetBit(17 + 1));\n        assertEquals(-1, bitSet.nextSetBit(19 + 1));\n\n        bitSet.clear();\n\n        bitSet.set(16);\n\n        bitSet.set(79);\n\n        assertEquals(16, bitSet.nextSetBit(0));\n        assertEquals(79, bitSet.nextSetBit(16 + 1));\n        assertEquals(-1, bitSet.nextSetBit(79 + 1));\n\n        bitSet.clear();\n\n        bitSet.set(78);\n\n        bitSet.set(79);\n\n        assertEquals(78, bitSet.nextSetBit(0));\n        assertEquals(79, bitSet.nextSetBit(78 + 1));\n        assertEquals(-1, bitSet.nextSetBit(79 + 1));\n\n    }", "signature": "void testNextSetBit()", "full_signature": "@Test public void testNextSetBit()", "class_method_signature": "BitSetTest.testNextSetBit()", "testcase": true, "constructor": false, "invocations": ["set", "set", "set", "assertEquals", "nextSetBit", "assertEquals", "nextSetBit", "assertEquals", "nextSetBit", "assertEquals", "nextSetBit", "clear", "set", "set", "assertEquals", "nextSetBit", "assertEquals", "nextSetBit", "assertEquals", "nextSetBit", "clear", "set", "set", "assertEquals", "nextSetBit", "assertEquals", "nextSetBit", "assertEquals", "nextSetBit"]}, "focal_class": {"identifier": "BitSet", "superclass": "", "interfaces": "", "fields": [{"original_string": "private final int size;", "modifier": "private final", "type": "int", "declarator": "size", "var_name": "size"}, {"original_string": "private fina