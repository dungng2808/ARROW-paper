ier": "getChordName", "parameters": "()", "modifiers": "public", "return": "String", "body": "public String getChordName(){\n\n        String name = this.chordName;\n\n        if(this.chordName.equalsIgnoreCase(\"_\") || this.chordName.equalsIgnoreCase(\"\")){\n            return normalizeNotesToSharps(this.chordName);\n        }\n\n        try {\n            if ((name.charAt(1) + \"\").equalsIgnoreCase(\"3\") ||\n                    (name.charAt(1) + \"\").equalsIgnoreCase(\"4\") ||\n                    (name.charAt(1) + \"\").equalsIgnoreCase(\"5\")) {\n                StringBuilder sb = new StringBuilder(this.chordName);\n                name = sb.deleteCharAt(1).toString();\n            }\n\n            if (name.length() > 2) {\n                if ((name.charAt(2) + \"\").equalsIgnoreCase(\"3\") ||\n                        (name.charAt(2) + \"\").equalsIgnoreCase(\"4\") ||\n                        (name.charAt(2) + \"\").equalsIgnoreCase(\"5\")) {\n                    StringBuilder sb = new StringBuilder(this.chordName);\n                    name = sb.deleteCharAt(2).toString();\n                }\n            }\n        }catch (Exception e){\n            System.out.println(\"THIS IS THE PROBLEM CHORD: \" + name);\n            throw e;\n        }\n\n\n        return normalizeNotesToSharps(name);\n    }", "signature": "String getChordName()", "full_signature": "public String getChordName()", "class_method_signature": "HiveChord.getChordName()", "testcase": false, "constructor": false, "invocations": ["equalsIgnoreCase", "equalsIgnoreCase", "normalizeNotesToSharps", "equalsIgnoreCase", "charAt", "equalsIgnoreCase", "charAt", "equalsIgnoreCase", "charAt", "toString", "deleteCharAt", "length", "equalsIgnoreCase", "charAt", "equalsIgnoreCase", "charAt", "equalsIgnoreCase", "charAt", "toString", "deleteCharAt", "println", "normalizeNotesToSharps"]}, "repository": {"repo_id": 135513706, "url": "https://github.com/shiehn/TrebleMaker", "language": "Java", "is_fork": fals