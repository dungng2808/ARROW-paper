{"test_class": {"identifier": "BinaryDataTest", "superclass": "", "interfaces": "", "fields": [], "file": "hawkular-bus-common/src/test/java/org/hawkular/bus/common/BinaryDataTest.java"}, "test_case": {"identifier": "testClose", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void testClose() throws Exception {\n        // because our tests use ByteArrayInputStream, close has no effect on it.\n        // But close does have an effect on our in-memory data - closing the stream closes reads to the in-memory data\n        BinaryData binaryData = new BinaryData(buildByteArray(\"123\"), buildInputStream(\"\"));\n\n        // show we can start reading\n        Assert.assertEquals(3, binaryData.available());\n        Assert.assertEquals('1', binaryData.read());\n        Assert.assertEquals(2, binaryData.available());\n\n        // show that close worked\n        binaryData.close();\n        Assert.assertEquals(0, binaryData.available());\n        Assert.assertEquals(-1, binaryData.read());\n    }", "signature": "void testClose()", "full_signature": "@Test public void testClose()", "class_method_signature": "BinaryDataTest.testClose()", "testcase": true, "constructor": false, "invocations": ["buildByteArray", "buildInputStream", "assertEquals", "available", "assertEquals", "read", "assertEquals", "available", "close", "assertEquals", "available", "assertEquals", "read"]}, "focal_class": {"identifier": "BinaryData", "superclass": "extends InputStream", "interfaces": "", "fields": [{"original_string": "private byte[] inMemoryData;", "modifier": "private", "type": "byte[]", "declarator": "inMemoryData", "var_name": "inMemoryData"}, {"original_string": "private final InputStream streamData;", "modifier": "private final", "type": "InputStream", "declarator": "streamData", "var_name": "streamData"}, {"original_string": "private int inMemoryDataPointer;", "modifier": "private", "type": "int", "declarator": "inMemoryDataPointer", "var_n