ata.nytimes.com%2Felements%2FtopicPage%3E+%3Fpage+.+%0D%0A+%3Fx+%3Chttp%3A%2F%2Fwww.w3.org%2F2002%2F07%2Fowl%23sameAs%3E+%3Chttp%3A%2F%2Fdbpedia.org%2Fresource%2FBarack_Obama%3E+.%0D%0A+%7D%0D%0A%7D&format=text%2Fhtml&timeout=0&debug=on HTTP/1.0\\\" 200 32039 \\\"-\\\" \\\"-\\\"\";\n        mapper.parse(x, expected);\n\n        RDFDataMgr.write(System.out, x.getModel(), RDFFormat.TURTLE);\n\n        String actual = mapper.unparse(x);\n\n        // TODO The timestamp is currently not correctly retained - ignore it in the check\n        actual = actual.replaceAll(\"\\\\[[^]]*\\\\]\", \"[]\");\n        expected = expected.replaceAll(\"\\\\[[^]]*\\\\]\", \"[]\");\n\n        System.out.println(expected);\n        System.out.println(actual);\n\n        Assert.assertEquals(expected, actual);\n    }", "signature": "void testWebLogParserRoundtripApache()", "full_signature": "@Test public void testWebLogParserRoundtripApache()", "class_method_signature": "TestWebLogParser.testWebLogParserRoundtripApache()", "testcase": true, "constructor": false, "invocations": ["loadRegistry", "loadModel", "get", "createResource", "createDefaultModel", "parse", "write", "getModel", "unparse", "replaceAll", "replaceAll", "println", "println", "assertEquals"]}, "focal_class": {"identifier": "WebLogParser", "superclass": "", "interfaces": "", "fields": [{"original_string": "private static final Logger logger = LoggerFactory\n            .getLogger(WebLogParser.class);", "modifier": "private static final", "type": "Logger", "declarator": "logger = LoggerFactory\n            .getLogger(WebLogParser.class)", "var_name": "logger"}, {"original_string": "private static Map<String, WebLogParser> formatRegistry;", "modifier": "private static", "type": "Map<String, WebLogParser>", "declarator": "formatRegistry", "var_name": "formatRegistry"}, {"original_string": "public static final String requestPattern\n            =  \"(?<verb>\\\\S+)\\\\s+\"\n            +  \"(?<path>\\\\S+)\\\\s+\"\n            +  