ature": "String process(MessageUpdate update, String locale)", "full_signature": "@Override public String process(MessageUpdate update, String locale)", "class_method_signature": "KarmaPlugin.process(MessageUpdate update, String locale)", "testcase": false, "constructor": false}, {"identifier": "deleteMessage", "parameters": "()", "modifiers": "@Override public", "return": "boolean", "signature": "boolean deleteMessage()", "full_signature": "@Override public boolean deleteMessage()", "class_method_signature": "KarmaPlugin.deleteMessage()", "testcase": false, "constructor": false}, {"identifier": "deleteMessageTimeout", "parameters": "()", "modifiers": "@Override public", "return": "long", "signature": "long deleteMessageTimeout()", "full_signature": "@Override public long deleteMessageTimeout()", "class_method_signature": "KarmaPlugin.deleteMessageTimeout()", "testcase": false, "constructor": false}, {"identifier": "processKarma", "parameters": "(String operator, String target, String username, String locale)", "modifiers": "private", "return": "String", "signature": "String processKarma(String operator, String target, String username, String locale)", "full_signature": "private String processKarma(String operator, String target, String username, String locale)", "class_method_signature": "KarmaPlugin.processKarma(String operator, String target, String username, String locale)", "testcase": false, "constructor": false}, {"identifier": "canProcess", "parameters": "(String messageContent)", "modifiers": "private", "return": "boolean", "signature": "boolean canProcess(String messageContent)", "full_signature": "private boolean canProcess(String messageContent)", "class_method_signature": "KarmaPlugin.canProcess(String messageContent)", "testcase": false, "constructor": false}, {"identifier": "getTimeout", "parameters": "()", "modifiers": "private", "return": "int", "signature": "int getTimeout()", "full_signature": "private int getTimeout()", "class_method_signature": "KarmaPlugin.getTimeout()", "testcase": false, "constructor": false}], "file": "rebot-plugins/rebot-karma-plugin/src/main/java/it/rebase/rebot/plugin/karma/KarmaPlugin.java"}, "focal_method": {"identifier": "process", "parameters": "(MessageUpdate update, String locale)", "modifiers": "@Override public", "return": "String", "body": "@Override\n    public String process(MessageUpdate update, String locale) {\n        StringBuilder response = new StringBuilder();\n        try {\n            if (canProcess(update.getMessage().getText()) && !update.isEdited()) {\n                List<String> itens = Arrays.asList(update.getMessage().getText().replaceAll(\"\\\\r|\\\\n\", \" \").split(\" \"));\n                HashMap<String, String> finalTargets = new HashMap<>();\n                String username = update.getMessage().getFrom().getUsername() != null ? update.getMessage().getFrom().getUsername() : update.getMessage().getFrom().getFirstName().toLowerCase();\n                itens.stream().distinct().forEach(item -> {\n                    if ((KARMA_PATTERN.matcher(item).find())) {\n                        String keyOperator;\n                        String key;\n                        if (item.charAt(item.length() - 1) == 8212 || item.charAt(item.length() - 1) == 8211) {\n                            keyOperator = \"--\";\n                            key = item.substring(0, item.length() - 1).toLowerCase();\n                        } else {\n                            keyOperator = item.substring(item.length() - 2);\n                            key = item.substring(0, item.length() - 2).toLowerCase();\n                        }\n                        finalTargets.putIfAbsent(key, keyOperator);\n                    }\n                });\n                for (Map.Entry<String, String> entry : finalTargets.entrySet()) {\n                    response.append(processKarma(entry.getValue(), entry.getKey(), username, locale));\n                }\n            }\n        } catch (final Exception e) {\n            e.printStackTrace();\n            log.warning(e.getMessage());\n        }\n        return response.toString();\n    }", "signature": "String process(MessageUpdate update, String locale)", "full_signature": "@Override public String process(MessageUpdate update, String locale)", "class_method_signature": "KarmaPlugin.process(MessageUpdate update, String locale)", "testcase": false, "constructor": false, "invocations": ["canProcess", "getText", "getMessage", "isEdited", "asList", "split", "replaceAll", "getText", "getMessage", "getUsername", "getFrom", "getMessage", "getUsername", "getFrom", "getMessage", "toLowerCase", "getFirstName", "getFrom", "getMessage", "forEach", "distinct", "stream", "find", "matcher", "charAt", "length", "charAt", "length", "toLowerCase", "substring", "length", "substring", "length", "toLowerCase", "substring", "length", "putIfAbsent", "entrySet", "append", "processKarma", "getValue", "getKey", "printStackTrace", "warning", "getMessage", "toString"]}, "repository": {"repo_id": 115838569, "url": "https://github.com/rebase-it/rebot", "language": "Java", "is_fork": false, "fork_count": 3, "stargazer_count": 11, "size": 759, "license": "licensed"}}