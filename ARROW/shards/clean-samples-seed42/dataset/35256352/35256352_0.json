OnlyOnShard(\"Italian Player should have existed only on shard 2\", 2, italyPlayerId);    \n  }", "signature": "void testShardingPersistence()", "full_signature": "@Test public void testShardingPersistence()", "class_method_signature": "NationalPlayerTest.testShardingPersistence()", "testcase": true, "constructor": false, "invocations": ["savePlayer", "savePlayer", "savePlayer", "getId", "println", "getId", "println", "getId", "println", "assertNotNull", "getShardPlayer", "assertNotNull", "getShardPlayer", "assertNotNull", "getShardPlayer", "assertExistsOnlyOnShard", "assertExistsOnlyOnShard", "assertExistsOnlyOnShard"]}, "focal_class": {"identifier": "NationalPlayer", "superclass": "", "interfaces": "", "fields": [{"original_string": "@Id @GeneratedValue(generator=\"PlayerIdGenerator\")\n  @GenericGenerator(name=\"PlayerIdGenerator\", strategy=\"org.hibernate.shards.id.ShardedUUIDGenerator\")\n  @Column(name=\"PLAYER_ID\")\n  private BigInteger id;", "modifier": "@Id @GeneratedValue(generator=\"PlayerIdGenerator\")\n  @GenericGenerator(name=\"PlayerIdGenerator\", strategy=\"org.hibernate.shards.id.ShardedUUIDGenerator\")\n  @Column(name=\"PLAYER_ID\")\n  private", "type": "BigInteger", "declarator": "id", "var_name": "id"}, {"original_string": "@Column (name=\"FIRST_NAME\")\n  private String firstName;", "modifier": "@Column (name=\"FIRST_NAME\")\n  private", "type": "String", "declarator": "firstName", "var_name": "firstName"}, {"original_string": "@Column (name=\"LAST_NAME\")\n  private String lastName;", "modifier": "@Column (name=\"LAST_NAME\")\n  private", "type": "String", "declarator": "lastName", "var_name": "lastName"}, {"original_string": "@Column (name=\"CAREER_GOALS\")\n  private int careerGoals;", "modifier": "@Column (name=\"CAREER_GOALS\")\n  private", "type": "int", "declarator": "careerGoals", "var_name": "careerGoals"}, {"original_string": "@Column (name=\"WORLD_RANKING\")\n  private int worldRanking;", "modifier": "@Column (name=\"WORLD_RANKING\"