{"test_class": {"identifier": "HoldingsTest", "superclass": "", "interfaces": "", "fields": [], "file": "portfolio-impl/src/test/java/com/redelastic/stocktrader/portfolio/impl/HoldingsTest.java"}, "test_case": {"identifier": "remove", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void remove() {\n        Holdings holdings =\n                Holdings.EMPTY\n                        .add(\"ABC\", 10)\n                        .remove(\"ABC\", 8);\n\n        assertEquals(holdings.getShareCount(\"ABC\"), 2);\n\n    }", "signature": "void remove()", "full_signature": "@Test public void remove()", "class_method_signature": "HoldingsTest.remove()", "testcase": true, "constructor": false, "invocations": ["remove", "add", "assertEquals", "getShareCount"]}, "focal_class": {"identifier": "Holdings", "superclass": "", "interfaces": "", "fields": [{"original_string": "static Holdings EMPTY = new Holdings(HashTreePMap.empty());", "modifier": "static", "type": "Holdings", "declarator": "EMPTY = new Holdings(HashTreePMap.empty())", "var_name": "EMPTY"}, {"original_string": "@NonNull PMap<String, Integer> holdings;", "modifier": "@NonNull", "type": "PMap<String, Integer>", "declarator": "holdings", "var_name": "holdings"}], "methods": [{"identifier": "add", "parameters": "(String symbol, int newShares)", "modifiers": "", "return": "Holdings", "signature": "Holdings add(String symbol, int newShares)", "full_signature": " Holdings add(String symbol, int newShares)", "class_method_signature": "Holdings.add(String symbol, int newShares)", "testcase": false, "constructor": false}, {"identifier": "remove", "parameters": "(String symbol, int sharesToRemove)", "modifiers": "", "return": "Holdings", "signature": "Holdings remove(String symbol, int sharesToRemove)", "full_signature": " Holdings remove(String symbol, int sharesToRemove)", "class_method_signature": "Holdings.remove(String symbol, int sharesToRemove)", "testcase": false, "constructor": false}, {"identifier": "asSequence", "parameters": "()", "modifiers": "", "return": "PSequence<Holding>", "signature": "PSequence<Holding> asSequence()", "full_signature": " PSequence<Holding> asSequence()", "class_method_signature": "Holdings.asSequence()", "testcase": false, "constructor": false}, {"identifier": "getShareCount", "parameters": "(String symbol)", "modifiers": "", "return": "int", "signature": "int getShareCount(String symbol)", "full_signature": " int getShareCount(String symbol)", "class_method_signature": "Holdings.getShareCount(String symbol)", "testcase": false, "constructor": false}], "file": "portfolio-impl/src/main/java/com/redelastic/stocktrader/portfolio/impl/Holdings.java"}, "focal_method": {"identifier": "remove", "parameters": "(String symbol, int sharesToRemove)", "modifiers": "", "return": "Holdings", "body": "Holdings remove(String symbol, int sharesToRemove) {\n        if (sharesToRemove <= 0) {\n            throw new IllegalArgumentException(\"Number of shares to remove from Holdings must be positive.\");\n        }\n        if (holdings.containsKey(symbol)) {\n            int currentShares = holdings.get(symbol);\n            int remainingShares = currentShares - sharesToRemove;\n            if (remainingShares > 0) {\n                return new Holdings(holdings.plus(symbol, remainingShares));\n            } else if (remainingShares == 0) {\n                return new Holdings(holdings.minus(symbol));\n            } else {\n                throw new IllegalStateException(\"Attempt to remove more shares from Holdings than are currently available.\");\n            }\n        } else {\n            throw new IllegalStateException(\n                    String.format(\"Attempt to remove shares for symbol %s not contained in Holdings.\", symbol));\n        }\n    }", "signature": "Holdings remove(String symbol, int sharesToRemove)", "full_signature": " Holdings remove(String symbol, int sharesToRemove)", "class_method_signature": "Holdings.remove(String symbol, int sharesToRemove)", "testcase": false, "constructor": false, "invocations": ["containsKey", "get", "plus", "minus", "format"]}, "repository": {"repo_id": 160239455, "url": "https://github.com/RedElastic/reactive-stock-trader", "language": "Java", "is_fork": false, "fork_count": 30, "stargazer_count": 78, "size": 893, "license": "licensed"}}