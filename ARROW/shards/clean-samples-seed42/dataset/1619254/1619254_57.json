eElements()) {\n            String pair = tok.nextToken().trim();\n            StringTokenizer sub = new StringTokenizer(pair,\"/\");\n\n            try {\n                T value = (T) domainType.getConstructor( String.class ).newInstance( sub.nextToken().trim() );\n                Degree deg = (Degree) getDegreeStringConstructor().newInstance( sub.nextToken().trim() );\n\n                dist.put(value,deg);\n            } catch (NoSuchMethodException nsme) {\n                nsme.printStackTrace();\n            } catch (IllegalAccessException iae) {\n                iae.printStackTrace();\n            } catch (InstantiationException ie) {\n                ie.printStackTrace();\n            } catch (InvocationTargetException ite) {\n                ite.printStackTrace();\n            }\n\n        }\n        return dist;\n    }", "signature": "Distribution<T> parse(String distrAsString)", "full_signature": "public Distribution<T> parse(String distrAsString)", "class_method_signature": "DiscreteDistributionStrategy.parse(String distrAsString)", "testcase": false, "constructor": false, "invocations": ["hasMoreElements", "trim", "nextToken", "newInstance", "getConstructor", "trim", "nextToken", "newInstance", "getDegreeStringConstructor", "trim", "nextToken", "put", "printStackTrace", "printStackTrace", "printStackTrace", "printStackTrace"]}, "repository": {"repo_id": 1619254, "url": "https://github.com/kiegroup/drools-chance", "language": "Java", "is_fork": false, "fork_count": 35, "stargazer_count": 25, "size": 6611, "license": "licensed"}}