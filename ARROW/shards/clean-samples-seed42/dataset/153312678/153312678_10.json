lse}, {"identifier": "doSearch", "parameters": "(QueryContext qc)", "modifiers": "private", "return": "ArrayList<AbstractWitsmlObject>", "signature": "ArrayList<AbstractWitsmlObject> doSearch(QueryContext qc)", "full_signature": "private ArrayList<AbstractWitsmlObject> doSearch(QueryContext qc)", "class_method_signature": "DotValve.doSearch(QueryContext qc)", "testcase": false, "constructor": false}, {"identifier": "createObject", "parameters": "(QueryContext qc)", "modifiers": "@Override @Async(\"asyncCustomTaskExecutor\") public", "return": "CompletableFuture<String>", "signature": "CompletableFuture<String> createObject(QueryContext qc)", "full_signature": "@Override @Async(\"asyncCustomTaskExecutor\") public CompletableFuture<String> createObject(QueryContext qc)", "class_method_signature": "DotValve.createObject(QueryContext qc)", "testcase": false, "constructor": false}, {"identifier": "deleteObject", "parameters": "(QueryContext qc)", "modifiers": "@Override @Async(\"asyncCustomTaskExecutor\") public", "return": "CompletableFuture<Boolean>", "signature": "CompletableFuture<Boolean> deleteObject(QueryContext qc)", "full_signature": "@Override @Async(\"asyncCustomTaskExecutor\") public CompletableFuture<Boolean> deleteObject(QueryContext qc)", "class_method_signature": "DotValve.deleteObject(QueryContext qc)", "testcase": false, "constructor": false}, {"identifier": "isObjectDelete", "parameters": "(String dataObjectType, String data)", "modifiers": "private", "return": "boolean", "signature": "boolean isObjectDelete(String dataObjectType, String data)", "full_signature": "private boolean isObjectDelete(String dataObjectType, String data)", "class_method_signature": "DotValve.isObjectDelete(String dataObjectType, String data)", "testcase": false, "constructor": false}, {"identifier": "updateObject", "parameters": "(QueryContext qc)", "modifiers": "@Override @Async(\"asyncCustomTaskExecutor\") public", "return": "CompletableFuture<Boolean>", "signature": "CompletableFuture<Boolean> updateObject(QueryContext qc)", "full_signature": "@Override @Async(\"asyncCustomTaskExecutor\") public CompletableFuture<Boolean> updateObject(QueryContext qc)", "class_method_signature": "DotValve.updateObject(QueryContext qc)", "testcase": false, "constructor": false}, {"identifier": "authenticate", "parameters": "(String username, String password)", "modifiers": "@Override public", "return": "void", "signature": "void authenticate(String username, String password)", "full_signature": "@Override public void authenticate(String username, String password)", "class_method_signature": "DotValve.authenticate(String username, String password)", "testcase": false, "constructor": false}, {"identifier": "getCap", "parameters": "()", "modifiers": "public", "return": "Map<String, AbstractWitsmlObject[]>", "signature": "Map<String, AbstractWitsmlObject[]> getCap()", "full_signature": "public Map<String, AbstractWitsmlObject[]> getCap()", "class_method_signature": "DotValve.getCap()", "testcase": false, "constructor": false}], "file": "df-valve/src/main/java/com/hashmapinc/tempus/witsml/valve/dot/DotValve.java"}, "focal_method": {"identifier": "deleteObject", "parameters": "(QueryContext qc)", "modifiers": "@Override @Async(\"asyncCustomTaskExecutor\") public", "return": "CompletableFuture<Boolean>", "body": "@Override\n\t@Async(\"asyncCustomTaskExecutor\")\n\tpublic CompletableFuture<Boolean> deleteObject(QueryContext qc) throws ValveException {\n\t\t// delete each object with 1 retry for bad token errors\n\t\tboolean result = false;\n\t\t// According to the WITSML Spec you cannot delete more than one object (or sub elements of more than one object)\n\t\t// at a time, so we do this check\n\t\tif (qc.WITSML_OBJECTS.size() > 1)\n\t\t\tthrow new ValveException(\"Delete cannot have more than one singular object per query\", (short)-444);\n\t\t// This is rare but a check must be made\n\t\tif (qc.WITSML_OBJECTS.size() == 0)\n\t\t\tthrow new ValveException(\"Delete must have exactly one singluar object, but found 0 in the query\");\n\t\ttry {\n\t\t\t// Should be a safe assumption as we check above\n\t\t\tAbstractWitsmlObject wmlObject = qc.WITSML_OBJECTS.get(0);\n\n\t\t\tif (wmlObject.getUid() == null || \"\".equals(wmlObject.getUid())){\n\t\t\t\tthrow new ValveException(\"Delete cannot have more than one singular object per query\", (short)-415);\n\t\t\t}\n\n\t\t\tif (!isObjectDelete(wmlObject.getObjectType().toLowerCase(), qc.QUERY_XML.toLowerCase())){\n\t\t\t\t// This is an element delete so re-route to delegator update\n\t\t\t\tthis.DELEGATOR.performElementDelete(wmlObject, qc.USERNAME, qc.PASSWORD, qc.EXCHANGE_ID, this.CLIENT);\n\t\t\t\tresult = true;\n\t\t\t} else {\n\t\t\t\t// This is an object delete, so straight delete\n\t\t\t\tthis.DELEGATOR.deleteObject(wmlObject, qc.USERNAME, qc.PASSWORD, qc.EXCHANGE_ID, this.CLIENT);\n\t\t\t\tresult = true;\n\t\t\t}\n\t\t} catch (Exception e) {\n\t\t\tLOG.warning(ValveLogging.getLogMsg(qc.EXCHANGE_ID,\"Exception in DotValve deleteObject: \" + e.getMessage()));\n\t\t\tif (e.getClass() == ValveException.class)\n\t\t\t\tthrow ((ValveException)e);\n\t\t\tthrow new ValveException(e.getMessage());\n\t\t}\n\t\treturn CompletableFuture.completedFuture(result);\n\t}", "signature": "CompletableFuture<Boolean> deleteObject(QueryContext qc)", "full_signature": "@Override @Async(\"asyncCustomTaskExecutor\") public CompletableFuture<Boolean> deleteObject(QueryContext qc)", "class_method_signature": "DotValve.deleteObject(QueryContext qc)", "testcase": false, "constructor": false, "invocations": ["size", "size", "get", "getUid", "equals", "getUid", "isObjectDelete", "toLowerCase", "getObjectType", "toLowerCase", "performElementDelete", "deleteObject", "warning", "getLogMsg", "getMessage", "getClass", "getMessage", "completedFuture"]}, "repository": {"repo_id": 153312678, "url": "https://github.com/hashmapinc/Drillflow", "language": "Java", "is_fork": false, "fork_count": 11, "stargazer_count": 9, "size": 2708, "license": "licensed"}}