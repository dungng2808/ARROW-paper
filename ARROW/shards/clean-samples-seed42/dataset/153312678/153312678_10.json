eteSingleObject()", "class_method_signature": "DotValveTest.shouldDeleteSingleObject()", "testcase": true, "constructor": false, "invocations": ["setUid", "add", "addWellbore", "serialize", "deleteObject", "deleteObject", "verify", "verifyNoMoreInteractions"]}, "focal_class": {"identifier": "DotValve", "superclass": "", "interfaces": "implements IValve", "fields": [{"original_string": "private static final Logger LOG = Logger.getLogger(DotValve.class.getName());", "modifier": "private static final", "type": "Logger", "declarator": "LOG = Logger.getLogger(DotValve.class.getName())", "var_name": "LOG"}, {"original_string": "private final DotClient CLIENT;", "modifier": "private final", "type": "DotClient", "declarator": "CLIENT", "var_name": "CLIENT"}, {"original_string": "private final DotDelegator DELEGATOR;", "modifier": "private final", "type": "DotDelegator", "declarator": "DELEGATOR", "var_name": "DELEGATOR"}], "methods": [{"identifier": "DotValve", "parameters": "(Map<String, String> config)", "modifiers": "public", "return": "", "signature": " DotValve(Map<String, String> config)", "full_signature": "public  DotValve(Map<String, String> config)", "class_method_signature": "DotValve.DotValve(Map<String, String> config)", "testcase": false, "constructor": true}, {"identifier": "DotValve", "parameters": "(DotClient client, DotDelegator delegator)", "modifiers": "public", "return": "", "signature": " DotValve(DotClient client, DotDelegator delegator)", "full_signature": "public  DotValve(DotClient client, DotDelegator delegator)", "class_method_signature": "DotValve.DotValve(DotClient client, DotDelegator delegator)", "testcase": false, "constructor": true}, {"identifier": "getName", "parameters": "()", "modifiers": "@Override public", "return": "String", "signature": "String getName()", "full_signature": "@Override public String getName()", "class_method_signature": "DotValve.getName()", "testcase": false, "constructor": false}, {"identifier": "getDescription", "