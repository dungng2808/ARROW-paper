            } catch (IntentSender.SendIntentException e) {\n                Log.e(TAG, \"Failed to send intent for Smart Lock resolution\", e);\n                startLockFromActivity(activity);\n            }\n        } else {\n            Log.e(TAG, \"Couldn't read the credentials using Smart Lock. Showing Lock...\");\n            startLockFromActivity(activity);\n        }\n    }", "signature": "void onCredentialRetrievalError(Activity activity, Status status, int requestCode)", "full_signature": " void onCredentialRetrievalError(Activity activity, Status status, int requestCode)", "class_method_signature": "SmartLock.onCredentialRetrievalError(Activity activity, Status status, int requestCode)", "testcase": false, "constructor": false, "invocations": ["hasResolution", "getStatusCode", "startResolutionForResult", "e", "startLockFromActivity", "e", "startLockFromActivity"]}, "repository": {"repo_id": 36564453, "url": "https://github.com/auth0/Lock-SmartLock", "language": "Java", "is_fork": false, "fork_count": 6, "stargazer_count": 11, "size": 117, "license": "licensed"}}