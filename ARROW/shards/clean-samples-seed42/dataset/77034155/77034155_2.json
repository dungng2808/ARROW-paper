\t// Unit test for  LowFareSearch with array[references] parameter\n\t\tint lowFareSearchIndex = 3;\n\t\tint resultsModelParamIndex = 1;\n\t\tModelDetail modelDetailForLowFareSearch = modelList.get(lowFareSearchIndex);\n\t\t// Extracting element 'results'\n\t\tModelParameter modelParameterForResults = modelDetailForLowFareSearch.getModelParameterList().get(resultsModelParamIndex); \n\t\tassertEquals(\"results\", modelParameterForResults.getName());\n\t\tassertEquals(\"array\", modelParameterForResults.getType());\n\t\tassertEquals(\"LowFareSearchResult\", modelParameterForResults.getReferenceModel());\n\t}", "signature": "void testCreateModelList()", "full_signature": "@Test public void testCreateModelList()", "class_method_signature": "ResponseModelDataTest.testCreateModelList()", "testcase": true, "constructor": false, "invocations": ["createModelList", "keySet", "getDefinitions", "getModelTitle", "assertTrue", "contains", "get", "get", "getModelParameterList", "assertEquals", "getName", "assertThat", "getDescription", "containsString", "assertEquals", "getType", "get", "get", "getModelParameterList", "assertEquals", "getName", "assertEquals", "getType", "assertEquals", "getReferenceModel"]}, "focal_class": {"identifier": "ResponseModelData", "superclass": "", "interfaces": "", "fields": [], "methods": [{"identifier": "createResponseJsonSchema", "parameters": "(Swagger swagger)", "modifiers": "@SuppressWarnings(\"unchecked\") //Remove JSONObject untyped warnings public", "return": "Map<String, JSONObject>", "signature": "Map<String, JSONObject> createResponseJsonSchema(Swagger swagger)", "full_signature": "@SuppressWarnings(\"unchecked\") //Remove JSONObject untyped warnings public Map<String, JSONObject> createResponseJsonSchema(Swagger swagger)", "class_method_signature": "ResponseModelData.createResponseJsonSchema(Swagger swagger)", "testcase": false, "constructor": false}, {"identifier": "createModelList", "parameters": "(Swagger swagger)", "modifiers": "publi