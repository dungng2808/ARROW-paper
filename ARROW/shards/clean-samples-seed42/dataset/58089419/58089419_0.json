ion", "signature": "AdsOptimization adsPricingAndAllocation(Inventory inventory, float mainlineReservePrice)", "full_signature": "@Override public AdsOptimization adsPricingAndAllocation(Inventory inventory, float mainlineReservePrice)", "class_method_signature": "AdsOptimizationImpl.adsPricingAndAllocation(Inventory inventory, float mainlineReservePrice)", "testcase": false, "constructor": false}, {"identifier": "toString", "parameters": "()", "modifiers": "@Override public", "return": "String", "signature": "String toString()", "full_signature": "@Override public String toString()", "class_method_signature": "AdsOptimizationImpl.toString()", "testcase": false, "constructor": false}, {"identifier": "deDup", "parameters": "()", "modifiers": "@Override public", "return": "AdsOptimization", "signature": "AdsOptimization deDup()", "full_signature": "@Override public AdsOptimization deDup()", "class_method_signature": "AdsOptimizationImpl.deDup()", "testcase": false, "constructor": false}, {"identifier": "equals", "parameters": "(Object o)", "modifiers": "@Override public", "return": "boolean", "signature": "boolean equals(Object o)", "full_signature": "@Override public boolean equals(Object o)", "class_method_signature": "AdsOptimizationImpl.equals(Object o)", "testcase": false, "constructor": false}, {"identifier": "hashCode", "parameters": "()", "modifiers": "@Override public", "return": "int", "signature": "int hashCode()", "full_signature": "@Override public int hashCode()", "class_method_signature": "AdsOptimizationImpl.hashCode()", "testcase": false, "constructor": false}, {"identifier": "showResult", "parameters": "()", "modifiers": "@Override public", "return": "List<AdsStatsInfo>", "signature": "List<AdsStatsInfo> showResult()", "full_signature": "@Override public List<AdsStatsInfo> showResult()", "class_method_signature": "AdsOptimizationImpl.showResult()", "testcase": false, "constructor": false}], "file": "src/main/java/com/bitTiger/searchAds/adsOptimization/AdsOptimizationImpl.java"}, "focal_method": {"identifier": "filterAds", "parameters": "(Inventory inventory, float minRelevanceScore, float minReservePrice)", "modifiers": "@Override public", "return": "AdsOptimization", "body": "@Override\n    public AdsOptimization filterAds(Inventory inventory, float minRelevanceScore, float minReservePrice) {\n        if (minRelevanceScore < 0 || minRelevanceScore > 1) {\n            throw new IllegalArgumentException(\n                    \"Minimum Relevance Score should be a number between 0 and 1.\");\n        }\n        if (minReservePrice < 0) {\n            throw new IllegalArgumentException(\n                    \"Minimum Reserve Price should be a non-negtive number.\");\n        }\n        if (inventory.size() == 0) {\n            return this;\n        }\n        // filter ads whose relevance score < min relevance score;\n        for (Iterator<AdsStatsInfo> iterator = _candidateAds.iterator(); iterator.hasNext();) {\n            if (iterator.next().getRelevanceScore() < minRelevanceScore) {\n                iterator.remove();\n            }\n        }\n        // filter ads whose bid < min reserve price\n        for (Iterator<AdsStatsInfo> iterator = _candidateAds.iterator(); iterator.hasNext();) {\n            if (inventory.findAds(iterator.next().getAdsId()).getBid() < minReservePrice) {\n                iterator.remove();\n            }\n        }\n        return this;\n    }", "signature": "AdsOptimization filterAds(Inventory inventory, float minRelevanceScore, float minReservePrice)", "full_signature": "@Override public AdsOptimization filterAds(Inventory inventory, float minRelevanceScore, float minReservePrice)", "class_method_signature": "AdsOptimizationImpl.filterAds(Inventory inventory, float minRelevanceScore, float minReservePrice)", "testcase": false, "constructor": false, "invocations": ["size", "iterator", "hasNext", "getRelevanceScore", "next", "remove", "iterator", "hasNext", "getBid", "findAds", "getAdsId", "next", "remove"]}, "repository": {"repo_id": 58089419, "url": "https://github.com/mzdu/AdSearch_Endpoints", "language": "Java", "is_fork": false, "fork_count": 17, "stargazer_count": 15, "size": 408, "license": "licensed"}}