{\n\n\t\tif (value== null) {// if the hardcoded value is in the constructor , use it.\n\t\t\tvalue = fields.get(getName());\n\t\t\t\n\t\t}\n\t\telse {\n\t\t\tfields.put(getName(), value);\n\t\t}\n\t\tif (value==null){\n\t\t\tthrow new ISOException(String.format(\"Field [%s]: Unable to pack as field is not set\",getName()));\n\t\t}\n\t\tif (value.length() <= size) {\n\t\t\tif (padLeft){\n\t\t\t\tISOUtil.padleft(getValue(), size,(char) padCharacter.byteValue() );\n\t\t\t}\n\t\t\telse {\n\t\t\t\tISOUtil.padright(getValue(), size,(char) padCharacter.byteValue() );\n\t\t\t}\n\t\t}\n\t\telse {\n\t\t\tthrow new ISOException(String.format(\"Field [%s]:Cannot pack as data has size %d and size needs to be %d\",getName(), value.length(),size));\n\t\t}\n\t\t\n\t\tbyte[] packedbyte = new byte[interpretter.getPackedLength(size)];\n\t\tinterpretter.interpret(getValue(), packedbyte, 0);\n\t\treturn packedbyte;\n\n\t}", "signature": "byte[] pack(Map<String, String> fields)", "full_signature": "@Override public byte[] pack(Map<String, String> fields)", "class_method_signature": "FixedFieldPackager.pack(Map<String, String> fields)", "testcase": false, "constructor": false, "invocations": ["get", "getName", "put", "getName", "format", "getName", "length", "padleft", "getValue", "byteValue", "padright", "getValue", "byteValue", "format", "getName", "length", "getPackedLength", "interpret", "getValue"]}, "repository": {"repo_id": 1628050, "url": "https://github.com/jpos/jPOS-EE", "stars": 69, "created": "4/17/2011 10:44:05 PM +00:00", "updates": "2020-01-27T16:59:44+00:00", "fork": "False", "license": "licensed"}}