public void testExhibitDescriptorFrame() {\n    // Apply same tests to both schemas\n    // null-able inner types should not alter inference\n    List<ExhibitDescriptor> descriptors = ImmutableList.of(\n        AvroExhibit.createDescriptor(outer1)\n        , AvroExhibit.createDescriptor(outer2));\n    for(ExhibitDescriptor desc: descriptors){\n      ObsDescriptor attributes = desc.attributes();\n      assertEquals(\"Infer number of attributes\", 2, attributes.size());\n      assertEquals(new Field(\"id\", FieldType.INTEGER), attributes.get(0));\n      assertEquals(new Field(\"short\", FieldType.STRING), attributes.get(1));\n      Map<String, ObsDescriptor> frames = desc.frames();\n      assertEquals(\"Infer number of frames\", 1, frames.size());\n      ObsDescriptor frameDesc = frames.get(\"ifoo\");\n      assertNotNull(\"Retrieve `ifoo` Frame\", frameDesc);\n      assertEquals(\"Infer Frame Structure\", 3, frameDesc.size());\n      assertEquals(new Field(\"f1\", FieldType.STRING), frameDesc.get(frameDesc.indexOf(\"f1\")));\n      assertEquals(new Field(\"f2\", FieldType.BOOLEAN), frameDesc.get(frameDesc.indexOf(\"f2\")));\n      assertEquals(new Field(\"f3\", FieldType.INTEGER), frameDesc.get(frameDesc.indexOf(\"f3\")));\n      Map<String, FieldType> vectors = desc.vectors();\n      assertEquals(\"Infer number of vectors\", 0, vectors.size());\n    }\n  }", "signature": "void testExhibitDescriptorFrame()", "full_signature": "@Test public void testExhibitDescriptorFrame()", "class_method_signature": "AvroExhibitTest.testExhibitDescriptorFrame()", "testcase": true, "constructor": false, "invocations": ["of", "createDescriptor", "createDescriptor", "attributes", "assertEquals", "size", "assertEquals", "get", "assertEquals", "get", "frames", "assertEquals", "size", "get", "assertNotNull", "assertEquals", "size", "assertEquals", "get", "indexOf", "assertEquals", "get", "indexOf", "assertEquals", "get", "indexOf", "vectors", "assertEquals", "size"]}, "focal_class": {"identifier": "AvroExhibit", "superclass": "", "interfaces": "", "fields": [], "methods": [{"identifier": "createDescriptor", "parameters": "(Schema schema)", "modifiers": "public static", "return": "ExhibitDescriptor", "signature": "ExhibitDescriptor createDescriptor(Schema schema)", "full_signature": "public static ExhibitDescriptor createDescriptor(Schema schema)", "class_method_signature": "AvroExhibit.createDescriptor(Schema schema)", "testcase": false, "constructor": false}, {"identifier": "isRecordElement", "parameters": "(Schema schema)", "modifiers": "static", "return": "boolean", "signature": "boolean isRecordElement(Schema schema)", "full_signature": "static boolean isRecordElement(Schema schema)", "class_method_signature": "AvroExhibit.isRecordElement(Schema schema)", "testcase": false, "constructor": false}, {"identifier": "getRecordElement", "parameters": "(Schema schema)", "modifiers": "static", "return": "Schema", "signature": "Schema getRecordElement(Schema schema)", "full_signature": "static Schema getRecordElement(Schema schema)", "class_method_signature": "AvroExhibit.getRecordElement(Schema schema)", "testcase": false, "constructor": false}, {"identifier": "getInnerRecord", "parameters": "(GenericRecord record)", "modifiers": "static", "return": "GenericRecord", "signature": "GenericRecord getInnerRecord(GenericRecord record)", "full_signature": "static GenericRecord getInnerRecord(GenericRecord record)", "class_method_signature": "AvroExhibit.getInnerRecord(GenericRecord record)", "testcase": false, "constructor": false}, {"identifier": "create", "parameters": "(GenericRecord record)", "modifiers": "public static", "return": "Exhibit", "signature": "Exhibit create(GenericRecord record)", "full_signature": "public static Exhibit create(GenericRecord record)", "class_method_signature": "AvroExhibit.create(GenericRecord record)", "testcase": false, "constructor": false}, {"identifier": "AvroExhibit", "parameters": "()", "modifiers": "private", "return": "", "signature": " AvroExhibit()", "full_signature": "private  AvroExhibit()", "class_method_signature": "AvroExhibit.AvroExhibit()", "testcase": false, "constructor": true}, {"identifier": "getSchemaField", "parameters": "(ObsDescriptor.Field f)", "modifiers": "public static", "return": "Schema.Field", "signature": "Schema.Field getSchemaField(ObsDescriptor.Field f)", "full_signature": "public static Schema.Field getSchemaField(ObsDescriptor.Field f)", "class_method_signature": "AvroExhibit.getSchemaField(ObsDescriptor.Field f)", "testcase": false, "constructor": false}, {"identifier": "getSchema", "parameters": "(FieldType type)", "modifiers": "public static", "return": "Schema", "signature": "Schema getSchema(FieldType type)", "full_signature": "public static Schema getSchema(FieldType type)", "class_method_signature": "AvroExhibit.getSchema(FieldType type)", "testcase": false, "constructor": false}], "file": "avro/src/main/java/com/cloudera/exhibit/avro/AvroExhibit.java"}, "focal_method": {"identifier": "createDescriptor", "parameters": "(Schema schema)", "modifiers": "public static", "return": "ExhibitDescriptor", "body": "public static ExhibitDescriptor createDescriptor(Schema schema) {\n    List<ObsDescriptor.Field> fields = Lists.newArrayList();\n    Map<String, ObsDescriptor> frames = Maps.newHashMap();\n    Map<String, FieldType> vectors = Maps.newHashMap();\n    for (int i = 0; i < schema.getFields().size(); i++) {\n      Schema.Field f = schema.getFields().get(i);\n      Schema unwrapped = AvroObsDescriptor.unwrap(f.schema());\n      if (unwrapped.getType() == Schema.Type.ARRAY) {\n        Schema elementType = unwrapped.getElementType();\n        if(isRecordElement(elementType)) {\n          frames.put(f.name(), new AvroObsDescriptor(getRecordElement(elementType)));\n        } else {\n          vectors.put(f.name(), AvroObsDescriptor.getFieldType(elementType));\n        }\n      } else {\n        FieldType ft = AvroObsDescriptor.getFieldType(unwrapped);\n        if (ft != null) {\n          fields.add(new ObsDescriptor.Field(f.name(), ft));\n        }\n      }\n    }\n    return new ExhibitDescriptor(new SimpleObsDescriptor(fields), frames, vectors);\n  }", "signature": "ExhibitDescriptor createDescriptor(Schema schema)", "full_signature": "public static ExhibitDescriptor createDescriptor(Schema schema)", "class_method_signature": "AvroExhibit.createDescriptor(Schema schema)", "testcase": false, "constructor": false, "invocations": ["newArrayList", "newHashMap", "newHashMap", "size", "getFields", "get", "getFields", "unwrap", "schema", "getType", "getElementType", "isRecordElement", "put", "name", "getRecordElement", "put", "name", "getFieldType", "getFieldType", "add", "name"]}, "repository": {"repo_id": 22080403, "url": "https://github.com/jwills/exhibit", "language": "Java", "is_fork": false, "fork_count": 12, "stargazer_count": 53, "size": 956, "license": "licensed"}}