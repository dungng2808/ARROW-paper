String s)", "testcase": false, "constructor": false}], "file": "library/src/main/java/com/github/jberkel/whassup/model/WhatsAppMessage.java"}, "focal_method": {"identifier": "filterPrivateBlock", "parameters": "(String s)", "modifiers": "static", "return": "String", "body": "static String filterPrivateBlock(String s) {\n        if (s == null) return null;\n\n        final StringBuilder sb = new StringBuilder();\n        for (int i=0; i<s.length(); ) {\n            int codepoint = s.codePointAt(i);\n            Character.UnicodeBlock block = Character.UnicodeBlock.of(codepoint);\n            if (block != Character.UnicodeBlock.PRIVATE_USE_AREA) {\n                sb.append(Character.toChars(codepoint));\n            }\n            i += Character.charCount(codepoint);\n        }\n        return sb.toString();\n    }", "signature": "String filterPrivateBlock(String s)", "full_signature": "static String filterPrivateBlock(String s)", "class_method_signature": "WhatsAppMessage.filterPrivateBlock(String s)", "testcase": false, "constructor": false, "invocations": ["length", "codePointAt", "of", "append", "toChars", "charCount", "toString"]}, "repository": {"repo_id": 10288113, "url": "https://github.com/jberkel/whassup", "language": "Java", "is_fork": false, "fork_count": 10, "stargazer_count": 15, "size": 739, "license": "licensed"}}