"modifiers": "protected", "return": "void", "body": "protected void addCrawleableUri(CrawleableUri uri) {\n        try {\n            Document uriDoc = getUriDocument(uri);\n            // If the document does not already exist, add it\n            if (mongoDB.getCollection(COLLECTION_URIS).find(uriDoc).first() == null) {\n                mongoDB.getCollection(COLLECTION_URIS).insertOne(uriDoc);\n            }\n        } catch (Exception e) {\n            LOGGER.error(\"Error while adding uri to MongoDBQueue\", e);\n        }\n    }", "signature": "void addCrawleableUri(CrawleableUri uri)", "full_signature": "protected void addCrawleableUri(CrawleableUri uri)", "class_method_signature": "MongoDBIpBasedQueue.addCrawleableUri(CrawleableUri uri)", "testcase": false, "constructor": false, "invocations": ["getUriDocument", "first", "find", "getCollection", "insertOne", "getCollection", "error"]}, "repository": {"repo_id": 51512653, "url": "https://github.com/dice-group/Squirrel", "language": "Java", "is_fork": false, "fork_count": 19, "stargazer_count": 10, "size": 41156, "license": "licensed"}}