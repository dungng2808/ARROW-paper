  )", "modifiers": "@Nonnull @SuppressWarnings(\"unchecked\") public static", "return": "WireSafeEnum<T>", "body": "@Nonnull\n  @SuppressWarnings(\"unchecked\")\n  public static <T extends Enum<T>> WireSafeEnum<T> fromJson(\n      @Nonnull Class<T> enumType,\n      @Nonnull String jsonValue\n  ) {\n    checkNotNull(enumType, \"enumType\");\n    checkNotNull(jsonValue, \"jsonValue\");\n\n    ensureJsonCacheInitialized(enumType);\n    WireSafeEnum<?> cached = JSON_LOOKUP_CACHE.get(enumType).get(jsonValue);\n    if (cached == null) {\n      return new WireSafeEnum<>(enumType, jsonValue);\n    } else {\n      return (WireSafeEnum<T>) cached;\n    }\n  }", "signature": "WireSafeEnum<T> fromJson(\n      @Nonnull Class<T> enumType,\n      @Nonnull String jsonValue\n  )", "full_signature": "@Nonnull @SuppressWarnings(\"unchecked\") public static WireSafeEnum<T> fromJson(\n      @Nonnull Class<T> enumType,\n      @Nonnull String jsonValue\n  )", "class_method_signature": "WireSafeEnum.fromJson(\n      @Nonnull Class<T> enumType,\n      @Nonnull String jsonValue\n  )", "testcase": false, "constructor": false, "invocations": ["checkNotNull", "checkNotNull", "ensureJsonCacheInitialized", "get", "get"]}, "repository": {"repo_id": 125110164, "url": "https://github.com/HubSpot/hubspot-immutables", "language": "Java", "is_fork": false, "fork_count": 2, "stargazer_count": 7, "size": 103, "license": "licensed"}}