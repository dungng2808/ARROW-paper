t(\"{\");\n        String comma = \"\";\n        for (Map.Entry<Object, Object> value : map.entrySet()) {\n            writer.println(comma);\n            indent(indentation + 1);\n            writer.print(\"\\\"\");\n            writer.print(value.getKey().toString());\n            writer.print(\"\\\": \");\n            serialize(value.getValue(), indentation + 1);\n            comma = \",\";\n        }\n        writer.println();\n        indent(indentation);\n        writer.print(\"}\");\n    }", "signature": "void serializeMap(Map<Object, Object> map, int indentation)", "full_signature": "private void serializeMap(Map<Object, Object> map, int indentation)", "class_method_signature": "JsonWriter.serializeMap(Map<Object, Object> map, int indentation)", "testcase": false, "constructor": false, "invocations": ["print", "entrySet", "println", "indent", "print", "print", "toString", "getKey", "print", "serialize", "getValue", "println", "indent", "print"]}, "repository": {"repo_id": 18463354, "url": "https://github.com/manuel-woelker/jimix", "language": "Java", "is_fork": false, "fork_count": 3, "stargazer_count": 17, "size": 735, "license": "licensed"}}