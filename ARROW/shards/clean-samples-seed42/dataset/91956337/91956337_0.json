pted);\n\n\t\t\t// \u4f7f\u7528BASE64\u5bf9\u52a0\u5bc6\u540e\u7684\u5b57\u7b26\u4e32\u8fdb\u884c\u7f16\u7801\n\t\t\tSystem.out.println(Base64.class.getProtectionDomain().getCodeSource().getLocation());\n\n\t\t\tString base64Encrypted = base64.encodeToString(encrypted);\n\n\t\t\t//String base64Encrypted = Base64.encodeBase64String(encrypted);\n\n\t\t\treturn base64Encrypted;\n\t\t} catch (Exception e) {\n\t\t\te.printStackTrace();\n\t\t\tthrow new AesException(AesException.EncryptAESError);\n\t\t}\n\t}", "signature": "String encrypt(String randomStr, String text)", "full_signature": " String encrypt(String randomStr, String text)", "class_method_signature": "WXBizMsgCrypt.encrypt(String randomStr, String text)", "testcase": false, "constructor": false, "invocations": ["getBytes", "getBytes", "getNetworkBytesOrder", "getBytes", "addBytes", "addBytes", "addBytes", "addBytes", "encode", "size", "addBytes", "toBytes", "getInstance", "init", "doFinal", "println", "getLocation", "getCodeSource", "getProtectionDomain", "encodeToString", "printStackTrace"]}, "repository": {"repo_id": 91956337, "url": "https://github.com/worgent/weixin-membercard", "language": "Java", "is_fork": false, "fork_count": 12, "stargazer_count": 29, "size": 1608, "license": "licensed"}}