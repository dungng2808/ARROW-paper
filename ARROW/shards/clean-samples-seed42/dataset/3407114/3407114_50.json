 "public static String formatError(int errorCode)", "class_method_signature": "FormatUtil.formatError(int errorCode)", "testcase": false, "constructor": false}], "file": "oshi-core/src/main/java/oshi/util/FormatUtil.java"}, "focal_method": {"identifier": "formatBytes", "parameters": "(long bytes)", "modifiers": "public static", "return": "String", "body": "public static String formatBytes(long bytes) {\n        if (bytes == 1L) { // bytes\n            return String.format(\"%d byte\", bytes);\n        } else if (bytes < KIBI) { // bytes\n            return String.format(\"%d bytes\", bytes);\n        } else if (bytes < MEBI) { // KiB\n            return formatUnits(bytes, KIBI, \"KiB\");\n        } else if (bytes < GIBI) { // MiB\n            return formatUnits(bytes, MEBI, \"MiB\");\n        } else if (bytes < TEBI) { // GiB\n            return formatUnits(bytes, GIBI, \"GiB\");\n        } else if (bytes < PEBI) { // TiB\n            return formatUnits(bytes, TEBI, \"TiB\");\n        } else if (bytes < EXBI) { // PiB\n            return formatUnits(bytes, PEBI, \"PiB\");\n        } else { // EiB\n            return formatUnits(bytes, EXBI, \"EiB\");\n        }\n    }", "signature": "String formatBytes(long bytes)", "full_signature": "public static String formatBytes(long bytes)", "class_method_signature": "FormatUtil.formatBytes(long bytes)", "testcase": false, "constructor": false, "invocations": ["format", "format", "formatUnits", "formatUnits", "formatUnits", "formatUnits", "formatUnits", "formatUnits"]}, "repository": {"repo_id": 3407114, "url": "https://github.com/oshi/oshi", "stars": 1381, "created": "2/10/2012 12:46:48 PM +00:00", "updates": "2020-01-27T17:17:27+00:00", "fork": "False", "license": "licensed"}}