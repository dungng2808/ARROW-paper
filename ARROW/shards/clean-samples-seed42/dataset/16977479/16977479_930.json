ocated", "parameters": "(List<Server> servers, Endpoint endpoint, BindingOperationInfo boi)", "modifiers": "protected", "return": "Server", "signature": "Server isColocated(List<Server> servers, Endpoint endpoint, BindingOperationInfo boi)", "full_signature": "protected Server isColocated(List<Server> servers, Endpoint endpoint, BindingOperationInfo boi)", "class_method_signature": "ColocOutInterceptor.isColocated(List<Server> servers, Endpoint endpoint, BindingOperationInfo boi)", "testcase": false, "constructor": false}, {"identifier": "isSameOperationInfo", "parameters": "(BindingOperationInfo sender,\n                                          BindingOperationInfo receiver)", "modifiers": "protected", "return": "boolean", "signature": "boolean isSameOperationInfo(BindingOperationInfo sender,\n                                          BindingOperationInfo receiver)", "full_signature": "protected boolean isSameOperationInfo(BindingOperationInfo sender,\n                                          BindingOperationInfo receiver)", "class_method_signature": "ColocOutInterceptor.isSameOperationInfo(BindingOperationInfo sender,\n                                          BindingOperationInfo receiver)", "testcase": false, "constructor": false}, {"identifier": "isCompatibleOperationInfo", "parameters": "(BindingOperationInfo sender,\n                                                BindingOperationInfo receiver)", "modifiers": "protected", "return": "boolean", "signature": "boolean isCompatibleOperationInfo(BindingOperationInfo sender,\n                                                BindingOperationInfo receiver)", "full_signature": "protected boolean isCompatibleOperationInfo(BindingOperationInfo sender,\n                                                BindingOperationInfo receiver)", "class_method_signature": "ColocOutInterceptor.isCompatibleOperationInfo(BindingOperationInfo sender,\n                                                BindingOperationInfo receiver)", "testcase": false, "constructor": false}, {"identifier": "setExchangeProperties", "parameters": "(Exchange exchange, Endpoint ep)", "modifiers": "public", "return": "void", "signature": "void setExchangeProperties(Exchange exchange, Endpoint ep)", "full_signature": "public void setExchangeProperties(Exchange exchange, Endpoint ep)", "class_method_signature": "ColocOutInterceptor.setExchangeProperties(Exchange exchange, Endpoint ep)", "testcase": false, "constructor": false}], "file": "rt/bindings/coloc/src/main/java/org/apache/cxf/binding/coloc/ColocOutInterceptor.java"}, "focal_method": {"identifier": "handleMessage", "parameters": "(Message message)", "modifiers": "public", "return": "void", "body": "public void handleMessage(Message message) throws Fault {\n        if (bus == null) {\n            bus = message.getExchange().getBus();\n            if (bus == null) {\n                bus = BusFactory.getDefaultBus(false);\n            }\n            if (bus == null) {\n                throw new Fault(new org.apache.cxf.common.i18n.Message(\"BUS_NOT_FOUND\", BUNDLE));\n            }\n        }\n\n        ServerRegistry registry = bus.getExtension(ServerRegistry.class);\n\n        if (registry == null) {\n            throw new Fault(new org.apache.cxf.common.i18n.Message(\"SERVER_REGISTRY_NOT_FOUND\", BUNDLE));\n        }\n\n        Exchange exchange = message.getExchange();\n        Endpoint senderEndpoint = exchange.getEndpoint();\n\n        if (senderEndpoint == null) {\n            throw new Fault(new org.apache.cxf.common.i18n.Message(\"ENDPOINT_NOT_FOUND\",\n                                                                   BUNDLE));\n        }\n\n        BindingOperationInfo boi = exchange.getBindingOperationInfo();\n\n        if (boi == null) {\n            throw new Fault(new org.apache.cxf.common.i18n.Message(\"OPERATIONINFO_NOT_FOUND\",\n                                                                   BUNDLE));\n        }\n\n        Server srv = isColocated(registry.getServers(), senderEndpoint, boi);\n\n        if (srv != null) {\n            if (LOG.isLoggable(Level.FINE)) {\n                LOG.fine(\"Operation:\" + boi.getName() + \" dispatched as colocated call.\");\n            }\n\n            InterceptorChain outChain = message.getInterceptorChain();\n            outChain.abort();\n            exchange.put(Bus.class, bus);\n            message.put(COLOCATED, Boolean.TRUE);\n            message.put(Message.WSDL_OPERATION, boi.getName());\n            message.put(Message.WSDL_INTERFACE, boi.getBinding().getInterface().getName());\n            invokeColocObserver(message, srv.getEndpoint());\n            if (!exchange.isOneWay()) {\n                invokeInboundChain(exchange, senderEndpoint);\n            }\n        } else {\n            if (LOG.isLoggable(Level.FINE)) {\n                LOG.fine(\"Operation:\" + boi.getName() + \" dispatched as remote call.\");\n            }\n\n            message.put(COLOCATED, Boolean.FALSE);\n        }\n    }", "signature": "void handleMessage(Message message)", "full_signature": "public void handleMessage(Message message)", "class_method_signature": "ColocOutInterceptor.handleMessage(Message message)", "testcase": false, "constructor": false, "invocations": ["getBus", "getExchange", "getDefaultBus", "getExtension", "getExchange", "getEndpoint", "getBindingOperationInfo", "isColocated", "getServers", "isLoggable", "fine", "getName", "getInterceptorChain", "abort", "put", "put", "put", "getName", "put", "getName", "getInterface", "getBinding", "invokeColocObserver", "getEndpoint", "isOneWay", "invokeInboundChain", "isLoggable", "fine", "getName", "put"]}, "repository": {"repo_id": 16977479, "url": "https://github.com/apache/cxf", "stars": 621, "created": "2/19/2014 8:00:08 AM +00:00", "updates": "2020-01-27T11:54:41+00:00", "fork": "False", "license": "licensed"}}