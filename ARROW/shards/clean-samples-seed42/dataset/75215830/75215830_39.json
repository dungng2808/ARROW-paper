{"test_class": {"identifier": "TestPropertiesUtil", "superclass": "", "interfaces": "", "fields": [{"original_string": "private static final String FRAME_INTERVAL_KEY = \"detection.sampling.interval\";", "modifier": "private static final", "type": "String", "declarator": "FRAME_INTERVAL_KEY = \"detection.sampling.interval\"", "var_name": "FRAME_INTERVAL_KEY"}, {"original_string": "private static final String MODELS_DIR_KEY = \"detection.models.dir.path\";", "modifier": "private static final", "type": "String", "declarator": "MODELS_DIR_KEY = \"detection.models.dir.path\"", "var_name": "MODELS_DIR_KEY"}, {"original_string": "private static final String SHARE_PATH_KEY = \"mpf.share.path\";", "modifier": "private static final", "type": "String", "declarator": "SHARE_PATH_KEY = \"mpf.share.path\"", "var_name": "SHARE_PATH_KEY"}, {"original_string": "private static final String TIMEOUT_KEY = \"web.session.timeout\";", "modifier": "private static final", "type": "String", "declarator": "TIMEOUT_KEY = \"web.session.timeout\"", "var_name": "TIMEOUT_KEY"}, {"original_string": "private static final String MPF_HOME_ENV_VAR = \"MPF_HOME\";", "modifier": "private static final", "type": "String", "declarator": "MPF_HOME_ENV_VAR = \"MPF_HOME\"", "var_name": "MPF_HOME_ENV_VAR"}, {"original_string": "@Autowired\n    MpfPropertiesConfigurationBuilder mpfPropertiesConfigurationBuilder;", "modifier": "@Autowired", "type": "MpfPropertiesConfigurationBuilder", "declarator": "mpfPropertiesConfigurationBuilder", "var_name": "mpfPropertiesConfigurationBuilder"}, {"original_string": "@javax.annotation.Resource(name=\"customPropFile\")\n    private FileSystemResource customPropFile;", "modifier": "@javax.annotation.Resource(name=\"customPropFile\")\n    private", "type": "FileSystemResource", "declarator": "customPropFile", "var_name": "customPropFile"}, {"original_string": "@Autowired\n    private PropertiesUtil propertiesUtil;", "modifier": "@Autowired\n    private", "type": "PropertiesUtil", "declarator": "propertiesUtil", "var_name": "propertiesUtil"}], "file": "trunk/workflow-manager/src/test/java/org/mitre/mpf/wfm/util/TestPropertiesUtil.java"}, "test_case": {"identifier": "testBuilderSave", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void testBuilderSave() throws ConfigurationException, IOException {\n        ImmutableConfiguration mpfPropertiesconfig = mpfPropertiesConfigurationBuilder.getCompleteConfiguration();\n\n        List<PropertyModel> newCustomPropertyModels = new ArrayList<>();\n        newCustomPropertyModels.add(new PropertyModel(FRAME_INTERVAL_KEY, \"4\", false));\n        newCustomPropertyModels.add(new PropertyModel(MODELS_DIR_KEY, \"${\" + SHARE_PATH_KEY +\"}/new/dir/\", false));\n        newCustomPropertyModels.add(new PropertyModel(TIMEOUT_KEY, \"60\", false));\n\n        ImmutableConfiguration newMpfPropertiesConfig =\n                mpfPropertiesConfigurationBuilder.setAndSaveCustomProperties(newCustomPropertyModels);\n\n        String mpfHome = System.getenv(MPF_HOME_ENV_VAR);\n        Assert.assertNotNull(mpfHome);\n\n        // ensure that current config isn't modified\n        Assert.assertEquals(1, mpfPropertiesconfig.getInt(FRAME_INTERVAL_KEY));\n        Assert.assertEquals(mpfHome + \"/share/models/\", mpfPropertiesconfig.getString(MODELS_DIR_KEY));\n        Assert.assertEquals(30, mpfPropertiesconfig.getInt(TIMEOUT_KEY));\n\n        // get updated config\n        mpfPropertiesconfig = newMpfPropertiesConfig; // mpfPropertiesConfigurationBuilder.getConfiguration();\n\n        // ensure detection value sticks\n        Assert.assertEquals(4, mpfPropertiesconfig.getInt(FRAME_INTERVAL_KEY));\n\n        // ensure that interpolation is performed on recently-set values\n        Assert.assertEquals(mpfHome + \"/share/new/dir/\", mpfPropertiesconfig.getString(MODELS_DIR_KEY));\n\n        // ensure non-detection value doesn't stick\n        Assert.assertEquals(30, mpfPropertiesconfig.getInt(TIMEOUT_KEY));\n\n        // ensure all values written to disk\n        Configurations configs = new Configurations();\n\n        FileBasedConfigurationBuilder<PropertiesConfiguration> mpfCustomPropertiesConfigBuilder =\n                configs.propertiesBuilder(customPropFile.getURL());\n        Configuration mpfCustomPropertiesConfig = mpfCustomPropertiesConfigBuilder.getConfiguration();\n\n        Assert.assertEquals(4, mpfCustomPropertiesConfig.getInt(FRAME_INTERVAL_KEY));\n        Assert.assertEquals(\"${\" + SHARE_PATH_KEY +\"}/new/dir/\", mpfCustomPropertiesConfig.getString(MODELS_DIR_KEY));\n        Assert.assertEquals(60, mpfCustomPropertiesConfig.getInt(TIMEOUT_KEY));\n\n        // reset\n        mpfCustomPropertiesConfig.clear();\n        mpfCustomPropertiesConfigBuilder.save();\n    }", "signature": "void testBuilderSave()", "full_signature": "@Test public void testBuilderSave()", "class_method_signature": "TestPropertiesUtil.testBuilderSave()", "testcase": true, "constructor": false, "invocations": ["getCompleteConfiguration", "add", "add", "add", "setAndSaveCustomProperties", "getenv", "assertNotNull", "assertEquals", "getInt", "assertEquals", "getString", "assertEquals", "getInt", "assertEquals", "getInt", "assertEquals", "getString", "assertEquals", "getInt", "propertiesBuilder", "getURL", "getConfiguration", "assertEquals", "getInt", "assertEquals", "getString", "assertEquals", "getInt", "clear", "save"]}, "focal_class": {"identifier": "PropertiesUtil", "superclass": "", "interfaces": "", "fields": [{"original_string": "private static final Logger log = LoggerFactory.getLogger(PropertiesUtil.class);", "modifier": "private static final", "type": "Logger", "declarator": "log = LoggerFactory.getLogger(PropertiesUtil.class)", "var_name": "log"}, {"original_string": "@Autowired\n    private ApplicationContext appContext;", "modifier": "@Autowired\n    private", "type": "ApplicationContext", "declarator": "appContext", "var_name": "appContext