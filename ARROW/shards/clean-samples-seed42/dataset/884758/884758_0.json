CompletedTaskCount();\n        assertTrue(a+\"!=\"+tasks,a == tasks);*/\n    }", "signature": "void testCreateInstance()", "full_signature": "@Test public void testCreateInstance()", "class_method_signature": "GrizzlyExecutorServiceTest.testCreateInstance()", "testcase": true, "constructor": false, "invocations": ["createInstance", "doTest", "assertTrue", "getMaximumPoolSize", "assertTrue", "getActiveCount", "assertTrue", "getCompletedTaskCount", "assertTrue", "getMaxQueuedTasksCount", "getQueueLimit", "valueOf", "replace", "substring", "getProperty", "assertTrue", "contains", "getSimpleName", "getClass", "getQueue", "doTest", "reconfigure", "setQueueLimit", "getConfiguration", "assertTrue", "getMaxQueuedTasksCount", "getMaxPoolSize", "getConfiguration", "doTest", "reconfigure", "setMaxPoolSize", "setKeepAliveTime", "setCorePoolSize", "setQueue", "getConfiguration", "assertTrue", "contains", "getSimpleName", "getClass", "getQueue", "assertTrue", "getName", "getPoolName", "assertTrue", "getMaxQueuedTasksCount", "assertTrue", "getCorePoolSize", "assertTrue", "getMaximumPoolSize", "shutdownNow"]}, "focal_class": {"identifier": "GrizzlyExecutorService", "superclass": "extends AbstractExecutorService", "interfaces": "implements ExtendedThreadPool", "fields": [{"original_string": "private final Object statelock = new Object();", "modifier": "private final", "type": "Object", "declarator": "statelock = new Object()", "var_name": "statelock"}, {"original_string": "private volatile ExtendedThreadPool pool;", "modifier": "private volatile", "type": "ExtendedThreadPool", "declarator": "pool", "var_name": "pool"}, {"original_string": "protected volatile ThreadPoolConfig config;", "modifier": "protected volatile", "type": "ThreadPoolConfig", "declarator": "config", "var_name": "config"}], "methods": [{"identifier": "createInstance", "parameters": "()", "modifiers": "public static", "return": "GrizzlyExecutorService", "signature": "GrizzlyExecutorService createInstance()", "full_