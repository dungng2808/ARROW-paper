, "file": "lab15/creatures/Plip.java"}, "focal_method": {"identifier": "chooseAction", "parameters": "(Map<Direction, Occupant> neighbors)", "modifiers": "public", "return": "Action", "body": "public Action chooseAction(Map<Direction, Occupant> neighbors) {\n        List<Direction> emptySpaces = getNeighborsOfType(neighbors, \"empty\");\n        List<Direction> cloruses = getNeighborsOfType(neighbors, \"clorus\");\n\n        if (emptySpaces.isEmpty()) {\n            return new Action(Action.ActionType.STAY);\n        }\n\n        if (energy > 1) {\n            Direction moveDir = HugLifeUtils.randomEntry(emptySpaces);\n            return new Action(Action.ActionType.REPLICATE, moveDir);\n        }\n\n        if (!cloruses.isEmpty()) {\n            if (HugLifeUtils.random() < 0.5) {\n                Direction moveDir = HugLifeUtils.randomEntry(emptySpaces);\n                return new Action(Action.ActionType.MOVE, moveDir);\n            }\n        }\n\n        return new Action(Action.ActionType.STAY);\n    }", "signature": "Action chooseAction(Map<Direction, Occupant> neighbors)", "full_signature": "public Action chooseAction(Map<Direction, Occupant> neighbors)", "class_method_signature": "Plip.chooseAction(Map<Direction, Occupant> neighbors)", "testcase": false, "constructor": false, "invocations": ["getNeighborsOfType", "getNeighborsOfType", "isEmpty", "randomEntry", "isEmpty", "random", "randomEntry"]}, "repository": {"repo_id": 89094025, "url": "https://github.com/moboa/berkeley-CS61B", "language": "Java", "is_fork": false, "fork_count": 4, "stargazer_count": 6, "size": 5938, "license": "licensed"}}