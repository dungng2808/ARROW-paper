{"test_class": {"identifier": "ScannerTest", "superclass": "", "interfaces": "", "fields": [{"original_string": "public static final ImmutableSortedSet<Tree<FilesystemSummary>> EMPTY = ImmutableSortedSet.of();", "modifier": "public static final", "type": "ImmutableSortedSet<Tree<FilesystemSummary>>", "declarator": "EMPTY = ImmutableSortedSet.of()", "var_name": "EMPTY"}, {"original_string": "@Rule public TemporaryFolder testFolder = new TemporaryFolder();", "modifier": "@Rule public", "type": "TemporaryFolder", "declarator": "testFolder = new TemporaryFolder()", "var_name": "testFolder"}], "file": "adirstat/src/test/java/org/flightofstairs/adirstat/model/ScannerTest.java"}, "test_case": {"identifier": "testSingle", "parameters": "()", "modifiers": "@SneakyThrows @Test public", "return": "void", "body": "@SneakyThrows\n    @Test\n    public void testSingle() {\n        File root = testFolder.getRoot();\n        Files.write(\"hello\", new File(root, \"hello.txt\"), UTF_8);\n\n        Optional<Tree<FilesystemSummary>> possibleNode = Scanner.recursiveList(root);\n        assertTrue(possibleNode.isPresent());\n\n        Tree<FilesystemSummary> file = new Tree<>(new FilesystemSummary(new File(root, \"hello.txt\"), 5, 1), EMPTY);\n        Tree<FilesystemSummary> dir = new Tree<>(new FilesystemSummary(root, 5, 1), ImmutableSortedSet.of(file));\n\n        assertEquals(dir, possibleNode.get());\n    }", "signature": "void testSingle()", "full_signature": "@SneakyThrows @Test public void testSingle()", "class_method_signature": "ScannerTest.testSingle()", "testcase": true, "constructor": false, "invocations": ["getRoot", "write", "recursiveList", "assertTrue", "isPresent", "of", "assertEquals", "get"]}, "focal_class": {"identifier": "Scanner", "superclass": "extends AsyncTask<File, Void, Optional<Tree<FilesystemSummary>>>", "interfaces": "", "fields": [{"original_string": "private static final boolean SMART_LENGTH_COMPATIBLE = Build.VERSION.SDK_INT >= LOLLIPOP;", "modifier": "p