(File file)", "class_method_signature": "Scanner.smartLength(File file)", "testcase": false, "constructor": false}], "file": "adirstat/src/main/java/org/flightofstairs/adirstat/model/Scanner.java"}, "focal_method": {"identifier": "recursiveList", "parameters": "(File path)", "modifiers": "@VisibleForTesting @SneakyThrows static", "return": "Optional<Tree<FilesystemSummary>>", "body": "@VisibleForTesting\n    @SneakyThrows\n    static Optional<Tree<FilesystemSummary>> recursiveList(File path) {\n        if (path.isDirectory()) {\n            long subTreeBytes = 0;\n            long subTreeCount = 0;\n\n            Iterable<Optional<Tree<FilesystemSummary>>> possibleChildren = listChildrenThreaded(path);\n\n            SortedSet<Tree<FilesystemSummary>> children = ImmutableSortedSet.copyOf(Optional.presentInstances(possibleChildren));\n            for (Tree<FilesystemSummary> child : children) {\n                subTreeBytes += child.getValue().getSubTreeBytes();\n                subTreeCount += child.getValue().getSubTreeCount();\n            }\n\n            return Optional.of(new Tree<>(new FilesystemSummary(path, subTreeBytes, subTreeCount), children));\n        } else if (path.isFile()) {\n            long length = SMART_LENGTH_COMPATIBLE ? smartLength(path) : path.length();\n            return Optional.of(new Tree<>(new FilesystemSummary(path, max(length, MIN_FILE_BYTES), 1), ImmutableSortedSet.<Tree<FilesystemSummary>>of()));\n        }\n        return Optional.absent();\n    }", "signature": "Optional<Tree<FilesystemSummary>> recursiveList(File path)", "full_signature": "@VisibleForTesting @SneakyThrows static Optional<Tree<FilesystemSummary>> recursiveList(File path)", "class_method_signature": "Scanner.recursiveList(File path)", "testcase": false, "constructor": false, "invocations": ["isDirectory", "listChildrenThreaded", "copyOf", "presentInstances", "getSubTreeBytes", "getValue", "getSubTreeCount", "getValue", "of", "isFile", "smartLength", "length", "of"