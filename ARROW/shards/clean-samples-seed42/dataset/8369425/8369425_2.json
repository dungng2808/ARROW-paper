divider >= dividers.length ) {\n\t\t\t\t\t++factor;\n\t\t\t\t\tdivider = 0;\n\t\t\t\t}\n\t\t\t}\n\t\t} else {\n\t\t\t//We have too many ticks or exactly max, so decrease until we're just under (or at) the limit.\n\t\t\twhile ( numTicks > maxTicks ) {\n\t\t\t\t++divider;\n\t\t\t\tif ( divider >= dividers.length ) {\n\t\t\t\t\t++factor;\n\t\t\t\t\tdivider = 0;\n\t\t\t\t}\n\n\t\t\t\tnumTicks = delta / ( dividers[divider] * Math.pow( 10, factor ) );\n\t\t\t}\n\t\t}\n\n//\t\tSystem.out.printf( \"calculateTickSpacing( %f, %d ) = %f%n\",\n//\t\t                   delta, maxTicks, dividers[divider] * Math.pow( 10, factor ) );\n\n\t\treturn dividers[divider] * Math.pow( 10, factor );\n\t}", "signature": "double calculateTickSpacing( double delta, int maxTicks )", "full_signature": "public static double calculateTickSpacing( double delta, int maxTicks )", "class_method_signature": "StableTicksAxis.calculateTickSpacing( double delta, int maxTicks )", "testcase": false, "constructor": false, "invocations": ["log10", "pow", "pow", "pow", "pow"]}, "repository": {"repo_id": 8369425, "url": "https://github.com/gillius/jfxutils", "language": "Java", "is_fork": false, "fork_count": 23, "stargazer_count": 59, "size": 184, "license": "licensed"}}