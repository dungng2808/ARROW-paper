methods": [{"identifier": "createWeights", "parameters": "(SubsetProbabilities probabilities)", "modifiers": "@Override public", "return": "double[]", "signature": "double[] createWeights(SubsetProbabilities probabilities)", "full_signature": "@Override public double[] createWeights(SubsetProbabilities probabilities)", "class_method_signature": "WordSetSizeBasedWeighter.createWeights(SubsetProbabilities probabilities)", "testcase": false, "constructor": false}, {"identifier": "getName", "parameters": "()", "modifiers": "@Override public", "return": "String", "signature": "String getName()", "full_signature": "@Override public String getName()", "class_method_signature": "WordSetSizeBasedWeighter.getName()", "testcase": false, "constructor": false}], "file": "palmetto/src/main/java/org/aksw/palmetto/weight/WordSetSizeBasedWeighter.java"}, "focal_method": {"identifier": "createWeights", "parameters": "(SubsetProbabilities probabilities)", "modifiers": "@Override public", "return": "double[]", "body": "@Override\n    public double[] createWeights(SubsetProbabilities probabilities) {\n        // get the number of words the complete word set comprises of\n        int numberOfWords = Integer.numberOfTrailingZeros(probabilities.probabilities.length);\n        int pos = 0;\n        for (int i = 0; i < probabilities.segments.length; ++i) {\n            pos += probabilities.conditions[i].length;\n        }\n        double weights[] = new double[pos];\n\n        pos = 0;\n        for (int i = 0; i < probabilities.segments.length; ++i) {\n            for (int j = 0; j < probabilities.conditions[i].length; ++j) {\n                weights[pos] = ((numberOfWords - Integer.bitCount(probabilities.segments[i]\n                        | probabilities.conditions[i][j]))  + 2.0)\n                        / numberOfWords;\n                ++pos;\n            }\n        }\n\n        return weights;\n    }", "signature": "double[] createWeights(SubsetProbabilities probabilities)", "full_signature": "@Override public double[] createWeights(SubsetProbabilities probabilities)", "class_method_signature": "WordSetSizeBasedWeighter.createWeights(SubsetProbabilities probabilities)", "testcase": false, "constructor": false, "invocations": ["numberOfTrailingZeros", "bitCount"]}, "repository": {"repo_id": 16404471, "url": "https://github.com/dice-group/Palmetto", "language": "Java", "is_fork": false, "fork_count": 32, "stargazer_count": 132, "size": 5384, "license": "licensed"}}