{"test_class": {"identifier": "SyncDBTest", "superclass": "", "interfaces": "", "fields": [], "file": "core/src/test/java/tripleplay/syncdb/SyncDBTest.java"}, "test_case": {"identifier": "testSets", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test public void testSets () {\n        Protocol.Session session = testSession();\n        TestDB one = new TestDB(), two = new TestDB();\n\n        // start with some synced changes\n        one.unionSet.add(\"one\");\n        one.unionSet.add(\"two\");\n        one.interSet.add(\"1\");\n        one.interSet.add(\"2\");\n        one.serverSet.add(\"a\");\n        one.serverSet.add(\"b\");\n        session.sync(one);\n        session.sync(two);\n\n        // now make conflicting changes to both client one and two and resync\n        one.unionSet.add(\"three\");\n        two.unionSet.add(\"four\");\n        one.interSet.remove(\"1\");\n        two.interSet.add(\"3\");\n        one.serverSet.add(\"c\");\n        two.serverSet.remove(\"b\");\n        session.sync(one); // this will go through no questions asked\n        session.sync(two); // this will sync one's changes into two and overwrite some of one's\n                           // changes with the merged data from two\n        session.sync(one); // this will sync two's merged data back to one\n\n        one.assertEquals(two);\n        assertEquals(Sets.newHashSet(\"one\", \"two\", \"three\", \"four\"), two.unionSet);\n        assertEquals(Sets.newHashSet(\"2\"), two.interSet);\n        assertEquals(Sets.newHashSet(\"a\", \"b\", \"c\"), two.serverSet);\n\n        // make sure we reread our data from storage properly\n        one.assertEquals(one.clone());\n\n        // make sure we have no lingering modifications\n        assertEquals(0, one.getMods().size());\n        assertEquals(0, two.getMods().size());\n    }", "signature": "void testSets()", "full_signature": "@Test public void testSets()", "class_method_signature": "SyncDBTest.testSets()", "testcase": true, "constructor": false, "invocations": ["testSession", "add", "add", "add", "add", "add", "add", "sync", "sync", "add", "add", "remove", "add", "add", "remove", "sync", "sync", "sync", "assertEquals", "assertEquals", "newHashSet", "assertEquals", "newHashSet", "assertEquals", "newHashSet", "assertEquals", "clone", "assertEquals", "size", "getMods", "assertEquals", "size", "getMods"]}, "focal_class": {"identifier": "SyncDB", "superclass": "", "interfaces": "", "fields": [{"original_string": "protected final Platform _platform;", "modifier": "protected final", "type": "Platform", "declarator": "_platform", "var_name": "_platform"}, {"original_string": "protected final Storage _storage;", "modifier": "protected final", "type": "Storage", "declarator": "_storage", "var_name": "_storage"}, {"original_string": "protected Storage.Batch _batch;", "modifier": "protected", "type": "Storage.Batch", "declarator": "_batch", "var_name": "_batch"}, {"original_string": "protected final Map<String,Property> _props = new HashMap<String,Property>();", "modifier": "protected final", "type": "Map<String,Property>", "declarator": "_props = new HashMap<String,Property>()", "var_name": "_props"}, {"original_string": "protected final Map<String,SubDB> _subdbs = new HashMap<String,SubDB>();", "modifier": "protected final", "type": "Map<String,SubDB>", "declarator": "_subdbs = new HashMap<String,SubDB>()", "var_name": "_subdbs"}, {"original_string": "protected final Map<String,Integer> _mods = new HashMap<String,Integer>();", "modifier": "protected final", "type": "Map<String,Integer>", "declarator": "_mods = new HashMap<String,Integer>()", "var_name": "_mods"}, {"original_string": "protected int _version;", "modifier": "protected", "type": "int", "declarator": "_version", "var_name": "_version"}, {"original_string": "protected boolean _flushQueued;", "modifier": "protected", "type": "boolean", "declarator": "_flushQueued", "var_name": "_flushQueued"}, {"original_string": 