ier": "private static final", "type": "String", "declarator": "ALIGN_TOP_RIGHT = \"{\\\\an9}\"", "var_name": "ALIGN_TOP_RIGHT"}, {"original_string": "private final StringBuilder textBuilder;", "modifier": "private final", "type": "StringBuilder", "declarator": "textBuilder", "var_name": "textBuilder"}, {"original_string": "private final ArrayList<String> tags;", "modifier": "private final", "type": "ArrayList<String>", "declarator": "tags", "var_name": "tags"}], "methods": [{"identifier": "SubripDecoder", "parameters": "()", "modifiers": "public", "return": "", "signature": " SubripDecoder()", "full_signature": "public  SubripDecoder()", "class_method_signature": "SubripDecoder.SubripDecoder()", "testcase": false, "constructor": true}, {"identifier": "decode", "parameters": "(byte[] bytes, int length, boolean reset)", "modifiers": "@Override protected", "return": "SubripSubtitle", "signature": "SubripSubtitle decode(byte[] bytes, int length, boolean reset)", "full_signature": "@Override protected SubripSubtitle decode(byte[] bytes, int length, boolean reset)", "class_method_signature": "SubripDecoder.decode(byte[] bytes, int length, boolean reset)", "testcase": false, "constructor": false}, {"identifier": "processLine", "parameters": "(String line, ArrayList<String> tags)", "modifiers": "private", "return": "String", "signature": "String processLine(String line, ArrayList<String> tags)", "full_signature": "private String processLine(String line, ArrayList<String> tags)", "class_method_signature": "SubripDecoder.processLine(String line, ArrayList<String> tags)", "testcase": false, "constructor": false}, {"identifier": "buildCue", "parameters": "(Spanned text, @Nullable String alignmentTag)", "modifiers": "private", "return": "Cue", "signature": "Cue buildCue(Spanned text, @Nullable String alignmentTag)", "full_signature": "private Cue buildCue(Spanned text, @Nullable String alignmentTag)", "class_method_signature": "SubripDecoder.buildCue(Spanned text, @Nullable String alignmentTag)", "testcase": false, "constructor": false}, {"identifier": "parseTimecode", "parameters": "(Matcher matcher, int groupOffset)", "modifiers": "private static", "return": "long", "signature": "long parseTimecode(Matcher matcher, int groupOffset)", "full_signature": "private static long parseTimecode(Matcher matcher, int groupOffset)", "class_method_signature": "SubripDecoder.parseTimecode(Matcher matcher, int groupOffset)", "testcase": false, "constructor": false}, {"identifier": "getFractionalPositionForAnchorType", "parameters": "(@Cue.AnchorType int anchorType)", "modifiers": "static", "return": "float", "signature": "float getFractionalPositionForAnchorType(@Cue.AnchorType int anchorType)", "full_signature": "static float getFractionalPositionForAnchorType(@Cue.AnchorType int anchorType)", "class_method_signature": "SubripDecoder.getFractionalPositionForAnchorType(@Cue.AnchorType int anchorType)", "testcase": false, "constructor": false}], "file": "videoplayer-core/src/main/java/com/google/android/exoplayer2/text/subrip/SubripDecoder.java"}, "focal_method": {"identifier": "decode", "parameters": "(byte[] bytes, int length, boolean reset)", "modifiers": "@Override protected", "return": "SubripSubtitle", "body": "@Override\n  protected SubripSubtitle decode(byte[] bytes, int length, boolean reset) {\n    ArrayList<Cue> cues = new ArrayList<>();\n    LongArray cueTimesUs = new LongArray();\n    ParsableByteArray subripData = new ParsableByteArray(bytes, length);\n    String currentLine;\n\n    while ((currentLine = subripData.readLine()) != null) {\n      if (currentLine.length() == 0) {\n        // Skip blank lines.\n        continue;\n      }\n\n      // Parse the index line as a sanity check.\n      try {\n        Integer.parseInt(currentLine);\n      } catch (NumberFormatException e) {\n        Log.w(TAG, \"Skipping invalid index: \" + currentLine);\n        continue;\n      }\n\n      // Read and parse the timing line.\n      boolean haveEndTimecode = false;\n      currentLine = subripData.readLine();\n      if (currentLine == null) {\n        Log.w(TAG, \"Unexpected end\");\n        break;\n      }\n\n      Matcher matcher = SUBRIP_TIMING_LINE.matcher(currentLine);\n      if (matcher.matches()) {\n        cueTimesUs.add(parseTimecode(matcher, 1));\n        if (!TextUtils.isEmpty(matcher.group(6))) {\n          haveEndTimecode = true;\n          cueTimesUs.add(parseTimecode(matcher, 6));\n        }\n      } else {\n        Log.w(TAG, \"Skipping invalid timing: \" + currentLine);\n        continue;\n      }\n\n      // Read and parse the text and tags.\n      textBuilder.setLength(0);\n      tags.clear();\n      while (!TextUtils.isEmpty(currentLine = subripData.readLine())) {\n        if (textBuilder.length() > 0) {\n          textBuilder.append(\"<br>\");\n        }\n        textBuilder.append(processLine(currentLine, tags));\n      }\n\n      Spanned text = Html.fromHtml(textBuilder.toString());\n\n      String alignmentTag = null;\n      for (int i = 0; i < tags.size(); i++) {\n        String tag = tags.get(i);\n        if (tag.matches(SUBRIP_ALIGNMENT_TAG)) {\n          alignmentTag = tag;\n          // Subsequent alignment tags should be ignored.\n          break;\n        }\n      }\n      cues.add(buildCue(text, alignmentTag));\n\n      if (haveEndTimecode) {\n        cues.add(null);\n      }\n    }\n\n    Cue[] cuesArray = new Cue[cues.size()];\n    cues.toArray(cuesArray);\n    long[] cueTimesUsArray = cueTimesUs.toArray();\n    return new SubripSubtitle(cuesArray, cueTimesUsArray);\n  }", "signature": "SubripSubtitle decode(byte[] bytes, int length, boolean reset)", "full_signature": "@Override protected SubripSubtitle decode(byte[] bytes, int length, boolean reset)", "class_method_signature": "SubripDecoder.decode(byte[] bytes, int length, boolean reset)", "testcase": false, "constructor": false, "invocations": ["readLine", "length", "parseInt", "w", "readLine", "w", "matcher", "matches", "add", "parseTimecode", "isEmpty", "group", "add", "parseTimecode", "w", "setLength", "clear", "isEmpty", "readLine", "length", "append", "append", "processLine", "fromHtml", "toString", "size", "get", "matches", "add", "buildCue", "add", "size", "toArray", "toArray"]}, "repository": {"repo_id": 133447770, "url": "https://github.com/ybj366533/YY-VideoPlayer", "language": "Java", "is_fork": false, "fork_count": 4, "stargazer_count": 20, "size": 39077, "license": "licensed"}}