ject service)", "full_signature": "private static boolean isExternalService(JsonObject service)", "class_method_signature": "KubernetesServiceImporter.isExternalService(JsonObject service)", "testcase": false, "constructor": false}, {"identifier": "isTrue", "parameters": "(String ssl)", "modifiers": "private static", "return": "boolean", "signature": "boolean isTrue(String ssl)", "full_signature": "private static boolean isTrue(String ssl)", "class_method_signature": "KubernetesServiceImporter.isTrue(String ssl)", "testcase": false, "constructor": false}, {"identifier": "close", "parameters": "(Handler<Void> completionHandler)", "modifiers": "@Override public", "return": "void", "signature": "void close(Handler<Void> completionHandler)", "full_signature": "@Override public void close(Handler<Void> completionHandler)", "class_method_signature": "KubernetesServiceImporter.close(Handler<Void> completionHandler)", "testcase": false, "constructor": false}, {"identifier": "unpublishRecord", "parameters": "(Record record, Handler<Void> completionHandler)", "modifiers": "private", "return": "void", "signature": "void unpublishRecord(Record record, Handler<Void> completionHandler)", "full_signature": "private void unpublishRecord(Record record, Handler<Void> completionHandler)", "class_method_signature": "KubernetesServiceImporter.unpublishRecord(Record record, Handler<Void> completionHandler)", "testcase": false, "constructor": false}, {"identifier": "removeRecordIfContained", "parameters": "(Record record)", "modifiers": "private", "return": "Record", "signature": "Record removeRecordIfContained(Record record)", "full_signature": "private Record removeRecordIfContained(Record record)", "class_method_signature": "KubernetesServiceImporter.removeRecordIfContained(Record record)", "testcase": false, "constructor": false}, {"identifier": "replaceRecordIfContained", "parameters": "(Record record)", "modifiers": "private", "return": "Record", "signature": "Record replaceRecordIfContained(Record record)", "full_signature": "private Record replaceRecordIfContained(Record record)", "class_method_signature": "KubernetesServiceImporter.replaceRecordIfContained(Record record)", "testcase": false, "constructor": false}], "file": "vertx-service-discovery-bridge-kubernetes/src/main/java/io/vertx/servicediscovery/kubernetes/KubernetesServiceImporter.java"}, "focal_method": {"identifier": "createRecord", "parameters": "(JsonObject service)", "modifiers": "static", "return": "Record", "body": "static Record createRecord(JsonObject service) {\n    JsonObject metadata = service.getJsonObject(\"metadata\");\n    Record record = new Record()\n      .setName(metadata.getString(\"name\"));\n\n    JsonObject labels = metadata.getJsonObject(\"labels\");\n\n    if (labels != null) {\n      labels.forEach(entry -> record.getMetadata().put(entry.getKey(), entry.getValue().toString()));\n    }\n\n    record.getMetadata().put(\"kubernetes.namespace\", metadata.getString(\"namespace\"));\n    record.getMetadata().put(\"kubernetes.name\", metadata.getString(\"name\"));\n    record.getMetadata().put(KUBERNETES_UUID, metadata.getString(\"uid\"));\n\n    String type = record.getMetadata().getString(\"service-type\");\n\n    // If not set, try to discovery it\n    if (type == null) {\n      type = discoveryType(service, record);\n    }\n\n    switch (type) {\n      case HttpEndpoint.TYPE:\n        manageHttpService(record, service);\n        break;\n      // TODO Add JDBC client, redis and mongo\n      default:\n        manageUnknownService(record, service, type);\n        break;\n    }\n\n    return record;\n  }", "signature": "Record createRecord(JsonObject service)", "full_signature": "static Record createRecord(JsonObject service)", "class_method_signature": "KubernetesServiceImporter.createRecord(JsonObject service)", "testcase": false, "constructor": false, "invocations": ["getJsonObject", "setName", "getString", "getJsonObject", "forEach", "put", "getMetadata", "