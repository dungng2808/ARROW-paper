g pkg = iface.getPackage().getName();\n            props.put(RemoteConstants.ENDPOINT_PACKAGE_VERSION_ + pkg, packageUtil.getVersion(iface));\n        }\n        return props;\n    }", "signature": "Map<String, Object> createEndpointProps(Map<String, Object> effectiveProps,\n                                                      Class<?>[] ifaces)", "full_signature": "protected Map<String, Object> createEndpointProps(Map<String, Object> effectiveProps,\n                                                      Class<?>[] ifaces)", "class_method_signature": "RemoteServiceAdminCore.createEndpointProps(Map<String, Object> effectiveProps,\n                                                      Class<?>[] ifaces)", "testcase": false, "constructor": false, "invocations": ["copyEndpointProperties", "remove", "addObjectClass", "put", "get", "getProperty", "put", "getName", "getPackage", "put", "getVersion"]}, "repository": {"repo_id": 53649949, "url": "https://github.com/apache/aries-rsa", "language": "Java", "is_fork": false, "fork_count": 20, "stargazer_count": 9, "size": 3822, "license": "licensed"}}