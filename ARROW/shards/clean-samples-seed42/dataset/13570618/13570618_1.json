{"test_class": {"identifier": "TaskQueueImplTest", "superclass": "", "interfaces": "", "fields": [{"original_string": "private static final Logger log =\n         LoggerFactory.getLogger(TaskQueueImplTest.class);", "modifier": "private static final", "type": "Logger", "declarator": "log =\n         LoggerFactory.getLogger(TaskQueueImplTest.class)", "var_name": "log"}, {"original_string": "TaskQueue queue;", "modifier": "", "type": "TaskQueue", "declarator": "queue", "var_name": "queue"}, {"original_string": "TestTaskHelperFactory factory;", "modifier": "", "type": "TestTaskHelperFactory", "declarator": "factory", "var_name": "factory"}], "file": "webui/src/test/java/com/vmware/appfactory/taskqueue/tasks/TaskQueueImplTest.java"}, "test_case": {"identifier": "testAbortTask", "parameters": "()", "modifiers": "@SuppressWarnings(\"ConstantConditions\") @Test(timeout = 500) // only give 500ms to run public", "return": "void", "body": "@SuppressWarnings(\"ConstantConditions\")\n   @Test(timeout = 500)    // only give 500ms to run\n   public void testAbortTask() throws Exception {\n      SleepyTask sleepyTask = newSleepyTask(60);  // sleep for one minute.  It won't take this long,\n                  // since we'll be interrupted.  But this guarantees\n                  // that we won't finish the task normally\n\n      long id = sleepyTask.getCurrentTaskState().getId();\n\n      queue.addTask(sleepyTask);\n\n      // wait for the task to start running\n      while (!TaskQueue.MetaStatus.RUNNING.equals(queue.findTaskById(id).getQueueStatus())) {\n         Thread.sleep(20);\n      }\n      assertTrue(TaskQueue.MetaStatus.RUNNING.equals(queue.findTaskById(id).getQueueStatus()));\n\n      queue.abortTask(id);\n      // now wait for it to be finished\n      while (TaskQueue.MetaStatus.RUNNING.equals(queue.findTaskById(id).getQueueStatus())) {\n         Thread.sleep(20);\n      }\n\n      TaskState taskState = queue.findTaskById(id);\n      assertNotNull(taskState);\n      assertEquals(TaskQueue.MetaStatus.FINISHED, taskState.getQueueStatus());\n      assertTrue(taskState.isAborted());\n      assertTrue(sleepyTask.isInterrupted());\n      if (-1 == taskState.getStarted()) {\n         // task went straight from waiting to finished\n         assertFalse(sleepyTask.isRun());\n         assertEquals(TestState.TestStatus.testing, taskState.getStatus());\n      } else {\n         // task started, but then aborted\n         assertTrue(sleepyTask.isRun());\n         assertEquals(TestState.TestStatus.swearing, taskState.getStatus());\n      }\n      assertEquals(-1, taskState.getProgress());\n\n      // also, try aborting a non-existent task to make\n      // sure we don't crash\n      queue.abortTask(-123L);\n\n      assertTrue(factory.resetNumEventsFired() > 0);\n   }", "signature": "void testAbortTask()", "full_signature": "@SuppressWarnings(\"ConstantConditions\") @Test(timeout = 500) // only give 500ms to run public void testAbortTask()", "class_method_signature": "TaskQueueImplTest.testAbortTask()", "testcase": true, "constructor": false, "invocations": ["newSleepyTask", "getId", "getCurrentTaskState", "addTask", "equals", "getQueueStatus", "findTaskById", "sleep", "assertTrue", "equals", "getQueueStatus", "findTaskById", "abortTask", "equals", "getQueueStatus", "findTaskById", "sleep", "findTaskById", "assertNotNull", "assertEquals", "getQueueStatus", "assertTrue", "isAborted", "assertTrue", "isInterrupted", "getStarted", "assertFalse", "isRun", "assertEquals", "getStatus", "assertTrue", "isRun", "assertEquals", "getStatus", "assertEquals", "getProgress", "abortTask", "assertTrue", "resetNumEventsFired"]}, "focal_class": {"identifier": "TaskQueueImpl", "superclass": "", "interfaces": "implements\n      TaskQueue,\n      ApplicationListener,\n      ApplicationEventPublisherAware,\n      DisposableBean", "fields": [{"original_string": "private final Logger log = LoggerFactory.getLogger(TaskQueueImpl.class);", "modifier": "private final", "type":