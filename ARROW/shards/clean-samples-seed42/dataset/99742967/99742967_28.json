thod_signature": "ImmutableTypedMap.containsValue(final Object value)", "testcase": false, "constructor": false}], "file": "type-safe/src/main/java/software/amazon/swage/collection/ImmutableTypedMap.java"}, "focal_method": {"identifier": "typedIterator", "parameters": "(Class<T> clazz)", "modifiers": "@Override public", "return": "Iterator<Entry<T>>", "body": "@Override\n    public <T> Iterator<Entry<T>> typedIterator(Class<T> clazz) {\n        //TODO: something less brain-dead\n        List<Entry<T>> entries = new ArrayList();\n        for (Iterator<Entry> it = this.iterator(); it.hasNext(); ) {\n            final Entry e = it.next();\n            if (e.getKey().valueType.equals(clazz)) {\n                entries.add(e);\n            }\n        }\n        return Collections.unmodifiableCollection(entries).iterator();\n    }", "signature": "Iterator<Entry<T>> typedIterator(Class<T> clazz)", "full_signature": "@Override public Iterator<Entry<T>> typedIterator(Class<T> clazz)", "class_method_signature": "ImmutableTypedMap.typedIterator(Class<T> clazz)", "testcase": false, "constructor": false, "invocations": ["iterator", "hasNext", "next", "equals", "getKey", "add", "iterator", "unmodifiableCollection"]}, "repository": {"repo_id": 99742967, "url": "https://github.com/awslabs/swage", "language": "Java", "is_fork": false, "fork_count": 16, "stargazer_count": 14, "size": 168, "license": "licensed"}}