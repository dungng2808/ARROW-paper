{"test_class": {"identifier": "ImmutableTypedMapTest", "superclass": "", "interfaces": "", "fields": [], "file": "type-safe/src/test/java/software/amazon/swage/collection/ImmutableTypedMapTest.java"}, "test_case": {"identifier": "typedIterator", "parameters": "()", "modifiers": "@Test public", "return": "void", "body": "@Test\n    public void typedIterator() throws Exception {\n        final TypedMap.Key<String> ka = TypedMap.key(\"y\", String.class);\n        final TypedMap.Key<Object> kb = TypedMap.key(\"n\", Object.class);\n        final TypedMap.Key<String> kc = TypedMap.key(\"m\", String.class);\n\n        final String va = \"yes\";\n        final String vb = \"no\";\n        final String vc = \"maybe\";\n\n        TypedMap data = ImmutableTypedMap.Builder\n                .with(ka, va)\n                .add(kb, vb)\n                .add(kc, vc)\n                .build();\n\n        assertEquals(3, data.size());\n\n        int i = 0;\n        boolean seen_a = false;\n        boolean seen_b = false;\n        boolean seen_c = false;\n\n        Iterator<TypedMap.Entry<String>> it = data.typedIterator(String.class);\n        while (it.hasNext()) {\n            i++;\n            final TypedMap.Entry<String> e = it.next();\n            TypedMap.Key<String> k = e.getKey();\n            String v = e.getValue();\n            if (k.equals(ka) && v.equals(va)) {\n                seen_a = true;\n            }\n            if (k.equals(kb) && v.equals(vb)) {\n                seen_b = true;\n            }\n            if (k.equals(kc) && v.equals(vc)) {\n                seen_c = true;\n            }\n        }\n        assertEquals(\"Iterator iterated incorrect increments\", 2, i);\n        assertTrue(\"Typed iterator missed an entry\", seen_a);\n        assertFalse(\"Typed iterator returned an entry of wrong type\", seen_b);\n        assertTrue(\"Typed iterator missed an entry\", seen_c);\n    }", "signature": "void typedIterator()", "full_signature": "@Test public void typedIterator()", "class_method_signature": "ImmutableTypedMapTest.typedIterator()", "testcase": true, "constructor": false, "invocations": ["key", "key", "key", "build", "add", "add", "with", "assertEquals", "size", "typedIterator", "hasNext", "next", "getKey", "getValue", "equals", "equals", "equals", "equals", "equals", "equals", "assertEquals", "assertTrue", "assertFalse", "assertTrue"]}, "focal_class": {"identifier": "ImmutableTypedMap", "superclass": "", "interfaces": "implements TypedMap", "fields": [{"original_string": "private final Map<Key, Entry> dataMap;", "modifier": "private final", "type": "Map<Key, Entry>", "declarator": "dataMap", "var_name": "dataMap"}], "methods": [{"identifier": "ImmutableTypedMap", "parameters": "(Map<Key<?>, Entry<?>> dataMap)", "modifiers": "private", "return": "", "signature": " ImmutableTypedMap(Map<Key<?>, Entry<?>> dataMap)", "full_signature": "private  ImmutableTypedMap(Map<Key<?>, Entry<?>> dataMap)", "class_method_signature": "ImmutableTypedMap.ImmutableTypedMap(Map<Key<?>, Entry<?>> dataMap)", "testcase": false, "constructor": true}, {"identifier": "get", "parameters": "(Key<T> key)", "modifiers": "@Override public final", "return": "T", "signature": "T get(Key<T> key)", "full_signature": "@Override public final T get(Key<T> key)", "class_method_signature": "ImmutableTypedMap.get(Key<T> key)", "testcase": false, "constructor": false}, {"identifier": "size", "parameters": "()", "modifiers": "@Override public", "return": "int", "signature": "int size()", "full_signature": "@Override public int size()", "class_method_signature": "ImmutableTypedMap.size()", "testcase": false, "constructor": false}, {"identifier": "isEmpty", "parameters": "()", "modifiers": "@Override public", "return": "boolean", "signature": "boolean isEmpty()", "full_signature": "@Override public boolean isEmpty()", "class_method_signature": "ImmutableTypedMap.isEmpty()", "testcase": false, "constructor": false}, {"identifier": "iterator", "parameters": "()