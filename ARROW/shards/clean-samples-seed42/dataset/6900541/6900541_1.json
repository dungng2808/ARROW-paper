l/Utils.java"}, "focal_method": {"identifier": "readableFileSize", "parameters": "(long size)", "modifiers": "public static", "return": "String", "body": "public static String readableFileSize(long size) {\n        if(size <= 0) return \"0 KB\";\n        final String[] units = new String[] { \"B\", \"KB\", \"MB\", \"GB\", \"TB\" };\n        int digitGroups = (int) (Math.log10(size)/Math.log10(1000));\n        return new DecimalFormat(\"#,##0.#\").format(size/Math.pow(1000, digitGroups)) + \" \" + units[digitGroups];\n    }", "signature": "String readableFileSize(long size)", "full_signature": "public static String readableFileSize(long size)", "class_method_signature": "Utils.readableFileSize(long size)", "testcase": false, "constructor": false, "invocations": ["log10", "log10", "format", "pow"]}, "repository": {"repo_id": 6900541, "url": "https://github.com/haiwen/seadroid", "stars": 366, "created": "11/28/2012 10:54:37 AM +00:00", "updates": "2020-01-23T21:28:08+00:00", "fork": "False", "license": "licensed"}}