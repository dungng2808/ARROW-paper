rl1, final @NonNull String url2)", "testcase": false, "constructor": false}, {"identifier": "stripCommonSubdomains", "parameters": "(@Nullable String host)", "modifiers": "public static", "return": "String", "signature": "String stripCommonSubdomains(@Nullable String host)", "full_signature": "public static String stripCommonSubdomains(@Nullable String host)", "class_method_signature": "UrlUtils.stripCommonSubdomains(@Nullable String host)", "testcase": false, "constructor": false}, {"identifier": "isLocalizedContent", "parameters": "(@Nullable String url)", "modifiers": "public static", "return": "boolean", "signature": "boolean isLocalizedContent(@Nullable String url)", "full_signature": "public static boolean isLocalizedContent(@Nullable String url)", "class_method_signature": "UrlUtils.isLocalizedContent(@Nullable String url)", "testcase": false, "constructor": false}], "file": "app/src/main/java/org/mozilla/focus/utils/UrlUtils.java"}, "focal_method": {"identifier": "stripUserInfo", "parameters": "(@Nullable String url)", "modifiers": "public static", "return": "String", "body": "public static String stripUserInfo(@Nullable String url) {\n        if (TextUtils.isEmpty(url)) {\n            return \"\";\n        }\n\n        try {\n            URI uri = new URI(url);\n\n            final String userInfo = uri.getUserInfo();\n            if (userInfo == null) {\n                return url;\n            }\n\n            // Strip the userInfo to minimise spoofing ability. This only affects what's shown\n            // during browsing, this information isn't used when we start editing the URL:\n            uri = new URI(uri.getScheme(), null, uri.getHost(), uri.getPort(), uri.getPath(), uri.getQuery(), uri.getFragment());\n\n            return uri.toString();\n        } catch (URISyntaxException e) {\n            // We might be trying to display a user-entered URL (which could plausibly contain errors),\n            // in this case its safe to just return the raw input.\n            // There are also some special cases that URI can't handle, such as \"http:\" by itself.\n            return url;\n        }\n    }", "signature": "String stripUserInfo(@Nullable String url)", "full_signature": "public static String stripUserInfo(@Nullable String url)", "class_method_signature": "UrlUtils.stripUserInfo(@Nullable String url)", "testcase": false, "constructor": false, "invocations": ["isEmpty", "getUserInfo", "getScheme", "getHost", "getPort", "getPath", "getQuery", "getFragment", "toString"]}, "repository": {"repo_id": 152655369, "url": "https://github.com/mozilla-mobile/firefox-echo-show", "stars": 11, "created": "10/11/2018 9:01:33 PM +00:00", "updates": "2019-11-07T17:54:44+00:00", "fork": "False", "license": "licensed"}}