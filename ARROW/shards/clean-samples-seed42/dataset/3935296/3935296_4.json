parameters": "(KSDataLocation dataLocator)", "modifiers": "public", "return": "void", "signature": "void setDataLocator(KSDataLocation dataLocator)", "full_signature": "public void setDataLocator(KSDataLocation dataLocator)", "class_method_signature": "BBCodeServiceImpl.setDataLocator(KSDataLocation dataLocator)", "testcase": false, "constructor": false}, {"identifier": "getPlugins", "parameters": "()", "modifiers": "public", "return": "List<BBCodePlugin>", "signature": "List<BBCodePlugin> getPlugins()", "full_signature": "public List<BBCodePlugin> getPlugins()", "class_method_signature": "BBCodeServiceImpl.getPlugins()", "testcase": false, "constructor": false}, {"identifier": "setPlugins", "parameters": "(List<BBCodePlugin> plugins)", "modifiers": "public", "return": "void", "signature": "void setPlugins(List<BBCodePlugin> plugins)", "full_signature": "public void setPlugins(List<BBCodePlugin> plugins)", "class_method_signature": "BBCodeServiceImpl.setPlugins(List<BBCodePlugin> plugins)", "testcase": false, "constructor": false}], "file": "component/bbcode/src/main/java/org/exoplatform/ks/bbcode/core/BBCodeServiceImpl.java"}, "focal_method": {"identifier": "getActive", "parameters": "()", "modifiers": "public", "return": "List<String>", "body": "public List<String> getActive() throws Exception {\n    SessionProvider sProvider = SessionProvider.createSystemProvider();\n    if (activeBBCodesCache.isEmpty()) {\n      try {\n        Node bbCodeHome = getBBcodeHome(sProvider);\n        if (bbCodeHome == null) {\n          return activeBBCodesCache;\n        }\n        QueryManager qm = bbCodeHome.getSession().getWorkspace().getQueryManager();\n        StringBuilder pathQuery = new StringBuilder();\n        // new Query().path(bbCodeHome.getPath()).type(BBCODE_NODE_TYPE).predicate(\"@exo:isActive='true'\").toString();\n        pathQuery.append(\"/jcr:root\").append(bbCodeHome.getPath()).append(\"/element(*,\").append(BBCODE_NODE_TYPE).append(\")[@exo:isActive='true']\");\n        Query query = qm.createQuery(pathQuery.toString(), Query.XPATH);\n        QueryResult result = query.execute();\n        NodeIterator iter = result.getNodes();\n        String tagName = \"\";\n\n        synchronized (activeBBCodesCache) {\n          while (iter.hasNext()) {\n            Node bbcNode = iter.nextNode();\n            tagName = bbcNode.getName();\n            activeBBCodesCache.add(tagName);\n          }\n        }\n\n      } finally {\n        sProvider.close();\n      }\n    }\n    return activeBBCodesCache;\n  }", "signature": "List<String> getActive()", "full_signature": "public List<String> getActive()", "class_method_signature": "BBCodeServiceImpl.getActive()", "testcase": false, "constructor": false, "invocations": ["createSystemProvider", "isEmpty", "getBBcodeHome", "getQueryManager", "getWorkspace", "getSession", "append", "append", "append", "append", "append", "getPath", "createQuery", "toString", "execute", "getNodes", "hasNext", "nextNode", "getName", "add", "close"]}, "repository": {"repo_id": 3935296, "url": "https://github.com/exo-archives/ks", "language": "Java", "is_fork": false, "fork_count": 7, "stargazer_count": 7, "size": 51128, "license": "licensed"}}