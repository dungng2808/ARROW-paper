ss_method_signature": "UpdateSiteGenerator.getDigestFile(String target, String algorithm)", "testcase": false, "constructor": false}, {"identifier": "createDigest", "parameters": "(File file, String algorithm)", "modifiers": "private static", "return": "File", "signature": "File createDigest(File file, String algorithm)", "full_signature": "private static File createDigest(File file, String algorithm)", "class_method_signature": "UpdateSiteGenerator.createDigest(File file, String algorithm)", "testcase": false, "constructor": false}], "file": "releng/org.eclipse.emf.releng/src/org/eclipse/emf/releng/UpdateSiteGenerator.java"}, "focal_method": {"identifier": "generateDownloads", "parameters": "(String target)", "modifiers": "public", "return": "void", "body": "public void generateDownloads(String target) throws Exception\n  {\n    File targetFile = new File(target);\n    if (targetFile.isDirectory())\n    {\n      if (new File(targetFile, \"content.jar\").isFile())\n      {\n        File archiveFile = getArchiveFile(target);\n        if (!archiveFile.exists())\n        {\n          createArchive(target);\n        }\n\n        if (!getDigestFile(archiveFile.getPath(), \"SHA-256\").isFile())\n        {\n          createDigest(archiveFile, \"SHA-256\");\n        }\n\n        if (!getDigestFile(archiveFile.getPath(), \"SHA-512\").isFile())\n        {\n          createDigest(archiveFile, \"SHA-512\");\n        }\n      }\n      else\n      {\n        for (File child : targetFile.listFiles())\n        {\n          if (child.isDirectory())\n          {\n            generateDownloads(child.getPath());\n          }\n        }\n      }\n    }\n  }", "signature": "void generateDownloads(String target)", "full_signature": "public void generateDownloads(String target)", "class_method_signature": "UpdateSiteGenerator.generateDownloads(String target)", "testcase": false, "constructor": false, "invocations": ["isDirectory", "isFile", "getArchiveFile", "exists", "createArchive", "isF