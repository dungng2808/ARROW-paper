main = \"\";\n      } else {\n        pos = pos + 1; //try to parse at next position\n      }\n    }\n    if (exception != null) {\n      throw exception;\n    } else {\n      return types;\n    }\n  }", "signature": "List<TypeInfo> parseResolveTypeInfo(String str)", "full_signature": "public static List<TypeInfo> parseResolveTypeInfo(String str)", "class_method_signature": "SchemaUtils.parseResolveTypeInfo(String str)", "testcase": false, "constructor": false, "invocations": ["length", "indexOf", "length", "trim", "substring", "equals", "equalsIgnoreCase", "getTypeInfoFromTypeString", "add", "length", "substring", "length"]}, "repository": {"repo_id": 38743792, "url": "https://github.com/aliyun/aliyun-odps-java-sdk", "language": "Java", "is_fork": false, "fork_count": 35, "stargazer_count": 59, "size": 19053, "license": "licensed"}}