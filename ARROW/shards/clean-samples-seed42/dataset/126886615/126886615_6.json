ava/com/groupon/featureadapter/FeaturesAdapter.java"}, "focal_method": {"identifier": "validateNewViewItems", "parameters": "(FeatureController<MODEL> controller, List<ViewItem> viewItems)", "modifiers": "@VisibleForTesting", "return": "void", "body": "@VisibleForTesting void validateNewViewItems(FeatureController<MODEL> controller, List<ViewItem> viewItems) {\n    if (viewItems == null || viewItems.isEmpty()) {\n      // null - there is no change in the controller to update\n      // empty - this controller has no views\n      return;\n    }\n    for (ViewItem viewItem : viewItems) {\n      if(viewItem.viewType == RecyclerView.INVALID_TYPE) {\n        String template = \"The Model %s of a ViewItem is associated to a \"\n            + \"ViewTypeDelegate that has not been \"\n            + \"registered in the controller %s\";\n        throw new RuntimeException(String.format(template, viewItem.model, controller));\n      }\n    }\n  }", "signature": "void validateNewViewItems(FeatureController<MODEL> controller, List<ViewItem> viewItems)", "full_signature": "@VisibleForTesting void validateNewViewItems(FeatureController<MODEL> controller, List<ViewItem> viewItems)", "class_method_signature": "FeaturesAdapter.validateNewViewItems(FeatureController<MODEL> controller, List<ViewItem> viewItems)", "testcase": false, "constructor": false, "invocations": ["isEmpty", "format"]}, "repository": {"repo_id": 126886615, "url": "https://github.com/groupon/FeatureAdapter", "language": "Java", "is_fork": false, "fork_count": 13, "stargazer_count": 112, "size": 3083, "license": "licensed"}}