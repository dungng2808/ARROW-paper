mment,\n            ResourceContent content)", "testcase": false, "constructor": false}, {"identifier": "addCommitComment", "parameters": "(String repositoryUrl, String commitSha, String commitComment)", "modifiers": "private", "return": "void", "signature": "void addCommitComment(String repositoryUrl, String commitSha, String commitComment)", "full_signature": "private void addCommitComment(String repositoryUrl, String commitSha, String commitComment)", "class_method_signature": "GitHubSourceConnector.addCommitComment(String repositoryUrl, String commitSha, String commitComment)", "testcase": false, "constructor": false}, {"identifier": "createResourceContent", "parameters": "(String repositoryUrl, String commitMessage, String content)", "modifiers": "@Override public", "return": "void", "signature": "void createResourceContent(String repositoryUrl, String commitMessage, String content)", "full_signature": "@Override public void createResourceContent(String repositoryUrl, String commitMessage, String content)", "class_method_signature": "GitHubSourceConnector.createResourceContent(String repositoryUrl, String commitMessage, String content)", "testcase": false, "constructor": false}, {"identifier": "getOrganizations", "parameters": "()", "modifiers": "@Override public", "return": "Collection<GitHubOrganization>", "signature": "Collection<GitHubOrganization> getOrganizations()", "full_signature": "@Override public Collection<GitHubOrganization> getOrganizations()", "class_method_signature": "GitHubSourceConnector.getOrganizations()", "testcase": false, "constructor": false}, {"identifier": "getRepositories", "parameters": "(String org)", "modifiers": "@Override public", "return": "Collection<GitHubRepository>", "signature": "Collection<GitHubRepository> getRepositories(String org)", "full_signature": "@Override public Collection<GitHubRepository> getRepositories(String org)", "class_method_signature": "GitHubSourceConnector.getRepositories(String org)", "testcase": false, "constructor": false}, {"identifier": "getBranches", "parameters": "(String org, String repo)", "modifiers": "@Override public", "return": "Collection<SourceCodeBranch>", "signature": "Collection<SourceCodeBranch> getBranches(String org, String repo)", "full_signature": "@Override public Collection<SourceCodeBranch> getBranches(String org, String repo)", "class_method_signature": "GitHubSourceConnector.getBranches(String org, String repo)", "testcase": false, "constructor": false}, {"identifier": "createPullRequestFromZipContent", "parameters": "(String repositoryUrl, String commitMessage, ZipInputStream generatedContent)", "modifiers": "@Override public", "return": "String", "signature": "String createPullRequestFromZipContent(String repositoryUrl, String commitMessage, ZipInputStream generatedContent)", "full_signature": "@Override public String createPullRequestFromZipContent(String repositoryUrl, String commitMessage, ZipInputStream generatedContent)", "class_method_signature": "GitHubSourceConnector.createPullRequestFromZipContent(String repositoryUrl, String commitMessage, ZipInputStream generatedContent)", "testcase": false, "constructor": false}, {"identifier": "addSecurityTo", "parameters": "(HttpRequest request)", "modifiers": "@Override protected", "return": "void", "signature": "void addSecurityTo(HttpRequest request)", "full_signature": "@Override protected void addSecurityTo(HttpRequest request)", "class_method_signature": "GitHubSourceConnector.addSecurityTo(HttpRequest request)", "testcase": false, "constructor": false}], "file": "back-end/hub-api/src/main/java/io/apicurio/hub/api/github/GitHubSourceConnector.java"}, "focal_method": {"identifier": "getOrganizations", "parameters": "()", "modifiers": "@Override public", "return": "Collection<GitHubOrganization>", "body": "@Override\n    public Collection<GitHubOrganization> getOrganizations() throws GitHubException, SourceConnectorException {\n        logger.debug(\"Getting organizations for current user.\");\n        Collection<GitHubOrganization> rval = new HashSet<>();\n        try {\n            GitHubClient client = githubClient();\n            \n            // Add the user's personal org\n            UserService userService = new UserService(client);\n            User user = userService.getUser();\n            GitHubOrganization gho = new GitHubOrganization();\n            gho.setUserOrg(true);\n            gho.setId(user.getLogin());\n            rval.add(gho);\n            \n            // Now all the user's orgs\n            OrganizationService orgService = new OrganizationService(client);\n            List<User> organizations = orgService.getOrganizations();\n            for (User org : organizations) {\n                gho = new GitHubOrganization();\n                gho.setUserOrg(false);\n                gho.setId(org.getLogin());\n                rval.add(gho);\n            }\n        } catch (IOException e) {\n            logger.error(\"Error getting GitHub organizations.\", e);\n            throw new GitHubException(\"Error getting GitHub organizations.\", e);\n        }\n        return rval;\n    }", "signature": "Collection<GitHubOrganization> getOrganizations()", "full_signature": "@Override public Collection<GitHubOrganization> getOrganizations()", "class_method_signature": "GitHubSourceConnector.getOrganizations()", "testcase": false, "constructor": false, "invocations": ["debug", "githubClient", "getUser", "setUserOrg", "setId", "getLogin", "add", "getOrganizations", "setUserOrg", "setId", "getLogin", "add", "error"]}, "repository": {"repo_id": 69595482, "url": "https://github.com/Apicurio/apicurio-studio", "stars": 468, "created": "9/29/2016 6:22:33 PM +00:00", "updates": "2020-01-26T23:20:08+00:00", "fork": "False", "license": "licensed"}}