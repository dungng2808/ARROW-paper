st<Talk> retrieveAllTalks(boolean fromCache) throws IOException {\n\n        final List<Talk> response = new ArrayList<>();\n\n        if (fromCache) {\n            List<Talk> cachedResponses = localRepository.getTalkList();\n\n            // cache miss\n            if (cachedResponses == null) {\n\n                return response; // empty list\n            } else {\n\n                response.addAll(cachedResponses);\n            }\n\n        } else {\n            Call<List<Session>> talkListCall = remoteRepository.getAllTalks();\n\n            Response<List<Session>> talkListResponse = talkListCall.execute();\n\n            if (!talkListResponse.isSuccessful()) {\n                throw new IOException(\"error while loading session list\");\n            }\n\n            List<Session> talkList = talkListResponse.body();\n\n            if (talkList == null) {\n                return response; // empty list\n            }\n\n            for (Session session : talkList) {\n\n                response.add(Mapper.mapSessionToTalk(session));\n            }\n\n            localRepository.setTalkList(response);\n        }\n\n        return response;\n    }", "signature": "List<Talk> retrieveAllTalks(boolean fromCache)", "full_signature": "@NonNull @Override public List<Talk> retrieveAllTalks(boolean fromCache)", "class_method_signature": "TechForumApiImpl.retrieveAllTalks(boolean fromCache)", "testcase": false, "constructor": false, "invocations": ["getTalkList", "addAll", "getAllTalks", "execute", "isSuccessful", "body", "add", "mapSessionToTalk", "setTalkList"]}, "repository": {"repo_id": 58413602, "url": "https://github.com/flolom/obfuscation-tutorial", "language": "Java", "is_fork": false, "fork_count": 3, "stargazer_count": 7, "size": 177, "license": "licensed"}}