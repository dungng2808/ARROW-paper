(value));\n\t\t\tcase TIME_SECONDS:\n\t\t\t\treturn new SecondsSinceMidnight(parseSeconds(value));\n\t\t\tcase DATE_TIME_SECONDS_SINCE_1960:\n\t\t\t\treturn new SecondsSinceDate(YEAR_1960, parseDateTime(value));\n\t\t\tcase DATE_TIME_SECONDS_SINCE_1970:\n\t\t\t\treturn new SecondsSinceDate(YEAR_1970, parseDateTime(value));\n\t\t\tcase DATE_TIME_SECONDS_SINCE_1980:\n\t\t\t\treturn new SecondsSinceDate(YEAR_1980, parseDateTime(value));\n\t\t\tdefault:\n\t\t\t\tbreak;\n\t\t}\n\n\t\tthrow new EvaluationException();\n\t}", "signature": "Object parse(DataType dataType, String value)", "full_signature": "static public Object parse(DataType dataType, String value)", "class_method_signature": "TypeUtil.parse(DataType dataType, String value)", "testcase": false, "constructor": false, "invocations": ["parseInteger", "parseFloat", "parseDouble", "parseBoolean", "parseDate", "parseTime", "parseDateTime", "parseDate", "parseDate", "parseDate", "parseSeconds", "parseDateTime", "parseDateTime", "parseDateTime"]}, "repository": {"repo_id": 8455875, "url": "https://github.com/jpmml/jpmml", "language": "Java", "is_fork": false, "fork_count": 44, "stargazer_count": 71, "size": 3174, "license": "licensed"}}